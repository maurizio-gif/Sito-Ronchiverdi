---
import { url } from "../lib/paths";

interface Props {
	image: string;
	imageAlt: string;
	eyebrow: string;
}

const { image, imageAlt, eyebrow } = Astro.props;
---

<header class="page-hero-full">
	<img class="page-hero-full__bg" src={url(image)} alt={imageAlt} />
	<div class="page-hero-full__scrim"></div>
	<div class="page-hero-full__spot"></div>
	<div class="page-hero-full__content">
		<p class="eyebrow eyebrow-dark">{eyebrow}</p>
		<h1 class="page-hero-full__title"><slot name="title" /></h1>
		<p class="lede lede-dark"><slot name="lede" /></p>
		<slot />
	</div>
</header>

<style>
	.page-hero-full {
		position: relative;
		/* Hero a tutto schermo: svh evita il taglio causato dalle barre del
		   browser su mobile, vh resta come fallback. */
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		overflow: hidden;
		background: var(--bg-dark);
	}
	.page-hero-full__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.page-hero-full__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(28, 28, 24, 0.55) 0%,
			rgba(28, 28, 24, 0.42) 45%,
			rgba(28, 28, 24, 0.78) 100%
		);
	}
	/* Alone dietro al testo: scurisce e sfoca solo il centro dell'immagine,
	   così il titolo resta leggibile su qualsiasi foto senza appiattire
	   tutto lo scatto con un velo uniforme. La maschera fa sparire il
	   bordo dell'alone, che non si percepisce come un riquadro. */
	.page-hero-full__spot {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			ellipse 62% 42% at 50% 50%,
			rgba(28, 28, 24, 0.62) 0%,
			rgba(28, 28, 24, 0.42) 45%,
			rgba(28, 28, 24, 0) 100%
		);
		-webkit-backdrop-filter: blur(7px);
		backdrop-filter: blur(7px);
		-webkit-mask-image: radial-gradient(ellipse 62% 42% at 50% 50%, #000 35%, rgba(0, 0, 0, 0.35) 70%, transparent 100%);
		mask-image: radial-gradient(ellipse 62% 42% at 50% 50%, #000 35%, rgba(0, 0, 0, 0.35) 70%, transparent 100%);
	}
	.page-hero-full__content {
		position: relative;
		z-index: 1;
		max-width: 62rem;
		padding: 4rem 1.5rem;
	}
	.page-hero-full__content .eyebrow {
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
	}
	.page-hero-full__content .lede {
		max-width: 46rem;
		margin-inline: auto;
		color: rgba(246, 239, 222, 0.92);
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65), 0 1px 3px rgba(0, 0, 0, 0.5);
	}
	.page-hero-full__title {
		font-family: var(--font-serif);
		color: var(--text-on-dark);
		margin: 0 0 1rem;
		text-shadow: 0 10px 34px rgba(0, 0, 0, 0.6), 0 3px 10px rgba(0, 0, 0, 0.55),
			0 1px 2px rgba(0, 0, 0, 0.45);
	}
	@media (max-width: 640px) {
		.page-hero-full__content {
			padding: 3rem 1.5rem;
		}
		/* Su schermo stretto il testo occupa quasi tutta la larghezza:
		   l'alone si allarga per non lasciarne fuori i bordi. */
		.page-hero-full__spot {
			background: radial-gradient(
				ellipse 95% 32% at 50% 50%,
				rgba(28, 28, 24, 0.62) 0%,
				rgba(28, 28, 24, 0.42) 45%,
				rgba(28, 28, 24, 0) 100%
			);
			-webkit-mask-image: radial-gradient(ellipse 95% 32% at 50% 50%, #000 35%, rgba(0, 0, 0, 0.35) 70%, transparent 100%);
			mask-image: radial-gradient(ellipse 95% 32% at 50% 50%, #000 35%, rgba(0, 0, 0, 0.35) 70%, transparent 100%);
		}
	}
</style>
