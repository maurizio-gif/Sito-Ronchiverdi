---
import { getCollection } from "astro:content";
import { url } from "../lib/paths";
import { getHours } from "../lib/schedules";

const gymFloorHours = await getHours("gym-floor");

const address = "Corso Moncalieri 466, Torino";
const mapsEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const mapsSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const mapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;

// Attività e servizi arrivano dalle content collection, come nel menu:
// aggiungere una scheda aggiorna automaticamente anche il footer.
const byOrder = (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0);
const allActivities = (await getCollection("activities")).filter((a) => a.data.visible !== false);
const attivitaAdulti = allActivities.filter((a) => a.data.audience === "adulti").sort(byOrder);
const attivitaJunior = allActivities.filter((a) => a.data.audience === "junior").sort(byOrder);
const activityHref = (a) => (a.data.href ? url(a.data.href) : url("/#attivita"));

const services = (await getCollection("services")).sort(byOrder);
const serviceHref = (s) => (s.data.external ? s.data.href : url(s.data.href));

const clubLinks = [
	{ href: url("/"), label: "Home" },
	{ href: url("/planning"), label: "Planning" },
	{ href: url("/abbonamenti"), label: "Abbonamenti" },
	{ href: url("/eventi"), label: "Eventi" },
	{ href: url("/blog"), label: "Blog" },
	{ href: url("/faq"), label: "Domande frequenti" },
	{ href: url("/lavora-con-noi"), label: "Lavora con noi" },
	{ openContact: true, label: "Prenota un tour" },
];

const iscrizioniLinks = [
	{ href: url("/attivita/tennis/iscrizione"), label: "Iscrizione Tennis" },
	{ href: url("/attivita/scuola-nuoto/iscrizione"), label: "Iscrizione Scuola Nuoto" },
	{ href: url("/attivita/triathlon/iscrizione"), label: "Iscrizione Triathlon" },
];

const legalLinks = [
	// Il vecchio link "Regolamento" puntava a una pagina mai esistita: le regole
	// del club vivono ora nel documento unico /termini-e-condizioni, e
	// /regolamento ci reindirizza (vedi astro.config.mjs).
	{ href: url("/termini-e-condizioni"), label: "Termini e Condizioni" },
	{ href: url("/privacy"), label: "Privacy" },
	{ href: url("/nomina-safeguarding"), label: "Nomina Safeguarding" },
	{ href: url("/codice-di-condotta"), label: "Codice di Condotta" },
];

const social = [
	{
		href: "https://www.facebook.com/ronchiverdi",
		label: "Facebook",
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.9c0-.7.2-1.1 1.2-1.1H16.5V3.1A16 16 0 0 0 14.6 3c-2 0-3.4 1.2-3.4 3.5v2H9v3h2.2V21h3v-9.5h2.3l.4-3H14Z"/></svg>`,
	},
	{
		href: "https://www.instagram.com/ronchiverdi",
		label: "Instagram",
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.1" cy="6.9" r="1.2" fill="currentColor"/></svg>`,
	},
];

// `negativo` marca i loghi forniti in versione per fondo chiaro: la loro parte
// scura (il testo del FIDAL su tutti) sul footer sparirebbe, quindi vengono
// resi bianchi pieni. Da togliere se in futuro arrivano i file in negativo,
// che manterrebbero i colori di marca.
const enti = [
	{ src: "images/federazioni/coni.png", alt: "CONI — Comitato Olimpico Nazionale Italiano" },
	{ src: "images/federazioni/csi.png", alt: "CSI — Centro Sportivo Italiano", negativo: true },
	{ src: "images/federazioni/fitp.png", alt: "FITP — Federazione Italiana Tennis e Padel" },
	{ src: "images/federazioni/fin.png", alt: "FIN — Federazione Italiana Nuoto" },
	{ src: "images/federazioni/fitri.png", alt: "FITRI — Federazione Italiana Triathlon" },
	{ src: "images/federazioni/fidal.png", alt: "FIDAL — Federazione Italiana di Atletica Leggera", negativo: true },
];
---

<footer class="footer">
	<section class="find-us" aria-label="Come trovarci">
		<div class="find-us__head">
			<span class="eyebrow eyebrow-dark">Dove siamo</span>
			<h2 class="find-us__title">Vieni a <em class="accent accent-dark">trovarci</em></h2>
		</div>

		<div class="find-us__map">
			<iframe
				src={mapsEmbedSrc}
				title={`Mappa: Ronchiverdi Sport Club, ${address}`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
			<a class="find-us__maps-link" href={mapsSearchUrl} target="_blank" rel="noopener">
				Apri in Maps
				<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6.5 3H3.8A1.8 1.8 0 0 0 2 4.8v7.4A1.8 1.8 0 0 0 3.8 14h7.4A1.8 1.8 0 0 0 13 12.2V9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 2H14v4.5M13.6 2.4 7.8 8.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</a>
		</div>

		<div class="find-us__info">
			<div class="find-us__item">
				<p class="find-us__label">Indirizzo</p>
				<p>Corso Moncalieri 466, Torino</p>
			</div>
			<div class="find-us__item">
				<p class="find-us__label">Come arrivare</p>
				<p>Parcheggio gratuito, direttamente all'interno del club.</p>
			</div>
			<div class="find-us__item">
				<p class="find-us__label">Orari club</p>
				<p>{gymFloorHours.rows.map((r) => r.label + " " + r.hours).join(" · ")}</p>
			</div>
			<div class="find-us__item">
				<p class="find-us__label">Contatti</p>
				<p><a href="tel:+390116612146">011 6612146</a></p>
			</div>
		</div>

		<div class="find-us__cta">
			<a class="btn btn-outline btn-outline-dark" href={mapsDirectionsUrl} target="_blank" rel="noopener">Indicazioni</a>
			<button type="button" class="btn" data-open-contact>Contattaci</button>
		</div>
	</section>

	<div class="footer-grid">
		<div class="footer-brand">
			<img src={url("logo-ronchiverdi-sport.png")} alt="Ronchiverdi Sport Club" height="40" />
			<p class="muted footer-blurb">
				Club sportivo a Torino: tennis, padel, nuoto, fitness e young
				school, in <strong>35.000 mq</strong> tra indoor e outdoor.
			</p>
			<ul class="footer-contacts">
				<li><a href="tel:+390116612146">011 6612146</a></li>
				<li class="muted">Corso Moncalieri 466, Torino</li>
			</ul>
			<div class="footer-social">
				{social.map((s) => (
					<a class="social-btn" href={s.href} target="_blank" rel="noopener" aria-label={`Ronchiverdi su ${s.label}`}>
						<span class="social-btn__icon" set:html={s.icon} />
						<span>{s.label}</span>
					</a>
				))}
			</div>
		</div>

		<div class="footer-col">
			<p class="footer-heading">Attività sportive</p>
			<ul>
				{attivitaAdulti.map((a) => <li><a href={activityHref(a)}>{a.data.title}</a></li>)}
			</ul>
		</div>

		<div class="footer-col">
			<p class="footer-heading">Young School</p>
			<ul>
				{attivitaJunior.map((a) => <li><a href={activityHref(a)}>{a.data.title}</a></li>)}
			</ul>
			<p class="footer-heading footer-heading--spaced">Iscrizioni</p>
			<ul>
				{iscrizioniLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
			</ul>
		</div>

		<div class="footer-col">
			<p class="footer-heading">Servizi</p>
			<ul>
				{services.map((s) => (
					<li>
						<a href={serviceHref(s)} target={s.data.external ? "_blank" : undefined} rel={s.data.external ? "noopener" : undefined}>
							{s.data.title}
						</a>
					</li>
				))}
			</ul>
		</div>

		<div class="footer-col">
			<p class="footer-heading">Il club</p>
			<ul>
				{clubLinks.map((l) => (
					<li>
						{l.openContact ? (
							<button type="button" data-open-contact>{l.label}</button>
						) : (
							<a href={l.href}>{l.label}</a>
						)}
					</li>
				))}
			</ul>
			<p class="footer-heading footer-heading--spaced">Ronchiverdi</p>
			<ul>
				<li><a href="https://www.business.ronchiverdi.it" target="_blank" rel="noopener">Ronchiverdi Business</a></li>
				<li><a href="https://www.business.ronchiverdi.it/elements" target="_blank" rel="noopener">Ristorante Elements</a></li>
			</ul>
		</div>
	</div>

	<section class="federazioni" aria-label="Federazioni ed enti sportivi">
		<p class="federazioni__claim">Sito web per la propaganda dell'attività sportiva dilettantistica</p>
		<div class="marquee">
			<div class="marquee__track">
				{[0, 1].map((copy) => (
					<ul class="marquee__group" aria-hidden={copy === 1 ? "true" : undefined}>
						{enti.map((e) => (
							<li><img class:list={{ "is-negativo": e.negativo }} src={url(e.src)} alt={copy === 1 ? "" : e.alt} loading="lazy" /></li>
						))}
					</ul>
				))}
			</div>
		</div>
	</section>

	<section class="footer-lavora" aria-label="Lavora con noi">
		<div>
			<p class="footer-heading">Lavora con noi</p>
			<h2 class="footer-lavora__titolo">
				Il club cerca persone <em class="accent accent-dark">tutto l'anno</em>
			</h2>
			<p class="footer-lavora__testo">
				Tecnici sportivi e istruttori, reception, commerciale, Spa, Club House,
				manutenzione: non pubblichiamo posizioni aperte, ma leggiamo tutte le
				candidature che arrivano e le teniamo per quando si apre qualcosa.
			</p>
		</div>
		<a class="btn btn-outline btn-outline-dark" href={url("/lavora-con-noi")}>
			Invia la candidatura
		</a>
	</section>

	<section class="legal" aria-label="Documenti e informative">
		<p class="footer-heading">Legal</p>
		<ul class="legal-list">
			{legalLinks.map((l) => (
				<li>
					<a href={l.href}>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9.2 1.8H4.5a1 1 0 0 0-1 1v10.4a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V5.1L9.2 1.8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /><path d="M9 2v3.2h3.3" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
						<span>{l.label}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<div class="footer-bottom">
		<p class="muted">© {new Date().getFullYear()} Ronchiverdi Sport Club</p>
		<address class="footer-societa">
			<strong>Ronchiverdi Sport Club SSD a RL</strong>
			<span>Sede legale: Piazza Vetra 17, 20123 Milano</span>
			<span>Sede operativa: Corso Moncalieri 466/16, 10133 Torino</span>
			<span>P. IVA 11173030013 · La società applica il MOG</span>
			<span>Safeguarding: <a href="mailto:safeguarding@ronchiverdi.it">safeguarding@ronchiverdi.it</a></span>
		</address>
	</div>
</footer>

<style>
	.footer {
		background: var(--bg-dark);
		color: var(--text-on-dark);
		padding: 4rem 1.5rem 1.5rem;
	}
	.find-us {
		max-width: 82rem;
		margin: 0 auto;
		padding-bottom: 3.5rem;
		border-bottom: 1px solid rgba(246, 239, 222, 0.14);
	}
	.find-us__head {
		margin: 0 0 2rem;
	}
	.find-us__title {
		color: var(--text-on-dark);
		margin: 0.35rem 0 0;
	}
	.find-us__map {
		position: relative;
		aspect-ratio: 16 / 7;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.5);
	}
	.find-us__map iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.find-us__maps-link {
		position: absolute;
		top: 1rem;
		left: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: rgba(248, 242, 229, 0.92);
		backdrop-filter: blur(12px) saturate(160%);
		color: var(--text);
		text-decoration: none;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		transition: transform 0.1s ease-out;
	}
	.find-us__maps-link:hover {
		color: var(--accent);
	}
	.find-us__maps-link:active {
		transform: scale(0.96);
		transition-duration: 0.05s;
	}
	@media (prefers-reduced-transparency: reduce) {
		.find-us__maps-link {
			background: var(--bg);
			backdrop-filter: none;
		}
	}

	.find-us__info {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin-top: 2rem;
		border-top: 1px solid rgba(246, 239, 222, 0.14);
		border-left: 1px solid rgba(246, 239, 222, 0.14);
	}
	.find-us__item {
		padding: 1.5rem 1.75rem;
		border-right: 1px solid rgba(246, 239, 222, 0.14);
		border-bottom: 1px solid rgba(246, 239, 222, 0.14);
	}
	.find-us__label {
		margin: 0 0 0.5rem;
		font-family: var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: var(--text-2xs);
		font-weight: 600;
		color: var(--accent-on-dark);
	}
	.find-us__item p:not(.find-us__label) {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: rgba(246, 239, 222, 0.8);
		line-height: 1.5;
	}
	.find-us__item a {
		color: rgba(246, 239, 222, 0.8);
		text-decoration: none;
	}
	.find-us__item a:hover {
		color: var(--text-on-dark);
	}

	.find-us__cta {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	@media (max-width: 760px), (orientation: portrait) {
		.find-us__info {
			grid-template-columns: repeat(2, 1fr);
		}
		.find-us__map {
			aspect-ratio: 4 / 3.4;
		}
	}

	.footer-grid {
		max-width: 82rem;
		margin: 0 auto;
		padding-top: 3.5rem;
		display: grid;
		grid-template-columns: 1.5fr repeat(4, 1fr);
		gap: 2.5rem;
	}
	.footer-brand img {
		filter: brightness(0) invert(1);
		opacity: 0.92;
		margin-bottom: 1rem;
	}
	.footer-blurb {
		max-width: 20rem;
		font-size: var(--text-sm);
		color: rgba(246, 239, 222, 0.6);
	}
	.footer-contacts {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: var(--text-sm);
	}
	.footer-contacts a {
		text-decoration: none;
		color: rgba(246, 239, 222, 0.8);
	}
	.footer-contacts a:hover {
		color: var(--text-on-dark);
	}
	.footer-contacts .muted {
		color: rgba(246, 239, 222, 0.5);
	}
	.footer-social {
		display: flex;
		gap: 0.75rem;
		margin-top: 1.75rem;
		flex-wrap: wrap;
	}
	.social-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.65rem 1.15rem;
		border: 1px solid var(--accent-on-dark);
		border-radius: 999px;
		text-decoration: none;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-on-dark);
		transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
	}
	.social-btn:hover {
		background: var(--accent-on-dark);
		color: var(--bg-dark);
		transform: translateY(-2px);
	}
	.social-btn:active {
		transform: scale(0.96);
		transition-duration: 0.05s;
	}
	.social-btn__icon {
		display: inline-flex;
	}

	.footer-heading {
		font-family: var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--accent-on-dark);
		margin: 0 0 1rem;
	}
	.footer-heading--spaced {
		margin-top: 1.75rem;
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-size: var(--text-sm);
	}
	.footer-col a,
	.footer-col button {
		text-decoration: none;
		color: rgba(246, 239, 222, 0.8);
	}
	.footer-col button {
		font: inherit;
		text-align: left;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}
	.footer-col a:hover,
	.footer-col button:hover {
		color: var(--text-on-dark);
	}

	.federazioni {
		max-width: 82rem;
		margin: 3.5rem auto 0;
		padding-top: 2.5rem;
		border-top: 1px solid rgba(246, 239, 222, 0.14);
	}
	.federazioni__claim {
		margin: 0 0 1.75rem;
		text-align: center;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(246, 239, 222, 0.55);
	}
	.marquee {
		overflow: hidden;
		/* Sfuma i loghi ai bordi, così entrano ed escono senza stacco. */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}
	.marquee__track {
		display: flex;
		width: max-content;
		animation: marquee-scroll 32s linear infinite;
	}
	.marquee:hover .marquee__track {
		animation-play-state: paused;
	}
	.marquee__group {
		list-style: none;
		margin: 0;
		/* Il padding finale eguaglia il gap interno: la giunzione tra le due
		   copie resta invisibile durante lo scorrimento. */
		padding: 0 3.5rem 0 0;
		display: flex;
		align-items: center;
		gap: 3.5rem;
	}
	.marquee__group li {
		flex-shrink: 0;
	}
	.marquee__group img {
		display: block;
		height: 3.25rem;
		width: auto;
		opacity: 0.75;
		transition: opacity 0.25s ease;
	}
	.marquee__group img:hover {
		opacity: 1;
	}
	/* Loghi forniti per fondo chiaro: senza correzione, sul footer scuro le
	   parti nere spariscono (il testo del FIDAL su tutti). L'inversione ribalta
	   solo la luminosità — scuro e chiaro si scambiano — e la rotazione di
	   tinta rimette i colori originali: così restano il blu e il tricolore
	   invece di ridursi a una sagoma bianca. Serve anche a preservare il
	   dettaglio del CSI, le cui fessure sono bianco pieno e non trasparenza:
	   schiarirlo e basta lo appiattirebbe in una macchia. */
	.marquee__group img.is-negativo {
		filter: invert(1) hue-rotate(180deg);
	}
	@keyframes marquee-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee__track {
			animation: none;
		}
		.marquee {
			overflow-x: auto;
		}
	}

	/* Lavora con noi: sta fra le federazioni e i documenti legali perché è
	   l'ultima cosa che si legge scendendo, e chi scende fino in fondo al
	   footer o cerca l'indirizzo o cerca proprio noi. */
	.footer-lavora {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		max-width: 82rem;
		margin: 3rem auto 0;
		padding-top: 2.5rem;
		border-top: 1px solid rgba(246, 239, 222, 0.14);
	}
	.footer-lavora__titolo {
		margin: 0.6rem 0 0.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-xl);
		font-weight: 400;
		letter-spacing: var(--tracking-lg);
		line-height: var(--leading-lg);
		color: var(--text-on-dark);
	}
	.footer-lavora__testo {
		max-width: 44rem;
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.65;
		color: rgba(246, 239, 222, 0.62);
	}
	.footer-lavora .btn {
		flex: none;
	}

	.legal {
