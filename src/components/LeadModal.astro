<script>
	// @ts-nocheck — script vanilla per il browser (accesso al DOM, niente tipi)
	import { initLeadForm } from "../lib/leadForm.client.js";

	const modal = document.getElementById("lead-modal");
	const form = initLeadForm(modal, {
		prefix: "lm",
		onClose: function () {
			chiudiEPulisci();
		},
	});

	// X, backdrop e Esc devono lasciare il form ripulito alla riapertura. Solo
	// Esc passa esclusivamente dalla chiusura nativa del <dialog>: per gli
	// altri due la puliamo subito, senza aspettare l'evento "close" — in alcuni
	// browser/contesti automatizzati può non scattare in modo affidabile dopo
	// una close() invocata da script, e aspettarlo soltanto lascerebbe il form
	// sporco alla riapertura. Richiamare clear() due volte (qui e nel listener
	// sotto, se poi l'evento arriva comunque) non ha controindicazioni.
	function chiudiEPulisci() {
		modal.close();
		document.body.classList.remove("lf-locked");
		form.clear();
	}

	modal.addEventListener("close", function () {
		document.body.classList.remove("lf-locked");
		form.clear();
	});

	document.addEventListener("click", function (e) {
		const trigger = e.target.closest("[data-open-contact]");
		if (!trigger) return;
		modal.showModal();
		document.body.classList.add("lf-locked");
		form.open(location.pathname, (trigger.textContent || "").trim(), trigger.dataset.interest);
	});

	// Chiusura dal backdrop: il click cade sul <dialog> stesso, non sul pannello.
	modal.addEventListener("click", function (e) {
		if (e.target === modal) chiudiEPulisci();
	});
</script>
