---
// Modal "Contattaci" — contenitore del form lead.
//
// Si aggancia a qualunque pulsante con [data-open-contact] presente in pagina;
// un eventuale [data-interest="<id attività>"] preseleziona l'attività nello
// step 1 (gli id sono quelli di src/data/leadActivities.ts).
import LeadFormBody from "./LeadFormBody.astro";
import { leadActivityMap } from "../data/leadActivities";
---

<dialog id="lead-modal" class="lf" aria-labelledby="lf-title" data-activities={JSON.stringify(leadActivityMap)}>
	<div class="lf__panel">
		<div class="lf__head">
			<div>
				<p class="eyebrow lf__eyebrow">Contattaci</p>
				<h2 class="lf__title" id="lf-title">Da dove <em class="accent">iniziamo?</em></h2>
			</div>
			<button class="lf__close" type="button" aria-label="Chiudi" data-lf-close>
				<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
					<path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
				</svg>
			</button>
		</div>

		<LeadFormBody prefix="lm" />
	</div>
</dialog>

<style is:global>
	:root {
		/* Superficie "carta" usata solo dentro il form: le card devono staccarsi
		   dal crema del pannello, e fra i token di sito non c'è un bianco. */
		--lf-card: #fffdf6;
		--lf-card-hover: #fffefb;
	}

	/* ── Dialog ──────────────────────────────────────────────────────── */
	.lf {
		border: none;
		padding: 0;
		background: transparent;
		max-width: min(96vw, 40rem);
		width: 100%;
		margin: auto;
	}
	.lf::backdrop {
		background: rgba(28, 28, 24, 0.6);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.lf__panel {
		background: var(--bg);
		color: var(--text);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
		max-height: 92vh;
		overflow-y: auto;
		box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.4);
	}

	/* ── Header ──────────────────────────────────────────────────────── */
	.lf__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 2rem 2rem 1.5rem;
		border-bottom: 1px solid var(--border-strong);
		background: var(--bg-alt);
		position: sticky;
		top: 0;
		z-index: 2;
	}
	.lf__eyebrow {
		margin: 0;
	}
	.lf__title {
		font-size: var(--text-xl);
		line-height: var(--leading-lg);
		letter-spacing: var(--tracking-lg);
		margin: 0.4rem 0 0;
	}
	.lf__title em {
		font-family: var(--font-serif);
		font-size: 1.15em;
	}
	.lf__close {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		background: none;
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		color: var(--text-muted);
		cursor: pointer;
		transition: border-color 0.18s ease, color 0.18s ease, transform 0.1s ease-out;
	}
	.lf__close:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.lf__close:active {
		transform: scale(0.9);
		transition-duration: 0.05s;
	}

	/* ── Indicatore di step ──────────────────────────────────────────── */
	.lf__steps {
		display: flex;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border);
		background: var(--bg-alt);
	}
	.lf__step {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		border: 1.5px solid var(--border-strong);
		color: var(--text-muted);
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
	}
	.lf__step.is-active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--text-on-dark);
	}
	.lf__step.is-done {
		background: var(--accent-tint);
		border-color: var(--accent-tint);
		color: var(--accent);
	}
	.lf__step-line {
		flex: 1;
		height: 1px;
		background: var(--border-strong);
		margin: 0 6px;
	}

	/* ── Corpo dello step ────────────────────────────────────────────── */
	.lf__body {
		padding: 1.6rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.lf__sub {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.6;
		color: var(--text-muted);
	}

	.lf__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ── Elenco attività (single select) ─────────────────────────────── */
	.lf__opts {
		border: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.lf__opt-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.lf__opt-group-label {
		margin: 0 0 0.15rem;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.lf__opt-wrap {
		display: flex;
		flex-direction: column;
	}

	.lf__opt {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		padding: 0.9rem 1rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		cursor: pointer;
		position: relative;
		transition: border-color 0.16s ease, background 0.16s ease, transform 0.1s ease-out;
	}
	.lf__opt:hover {
		border-color: var(--accent);
		background: var(--lf-card-hover);
	}
	.lf__opt:active {
		transform: scale(0.995);
		transition-duration: 0.05s;
	}
	/* Il radio resta nel DOM (single select nativo, tastiera e form gratis) ma
	   invisibile: lo stato selezionato è comunicato dalla card. */
	.lf__opt-input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
	}
	.lf__opt:has(.lf__opt-input:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.lf__opt:has(.lf__opt-input:checked) {
		border-color: var(--accent);
		background: var(--accent-tint);
	}

	.lf__opt-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
		margin-top: 0.1rem;
	}
	.lf__opt-texts {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}
	.lf__opt-title {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.25;
		color: var(--text);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.lf__opt-badge {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 500;
		font-style: normal;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--accent-tint);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}
	.lf__opt-sub {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-muted);
	}

	/* Attività comprese, visibili sulla card: un macro-gruppo deve dire subito
	   cosa contiene. Quando l'opzione viene scelta lasciano il posto agli
	   stessi elementi in versione selezionabile (.lf__opt-extra), che
	   altrimenti ripeterebbero la stessa lista due volte. */
	.lf__opt-includes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin-top: 0.45rem;
	}
	.lf__opt:has(.lf__opt-input:checked) .lf__opt-includes {
		display: none;
	}
	.lf__opt-tag {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 500;
		line-height: 1.3;
		color: var(--accent);
		background: var(--accent-tint);
		border-radius: 999px;
		padding: 0.2rem 0.55rem;
	}

	.lf__opt-mark {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
		display: flex;
		align-items: center;
		justify-content: center;
		color: transparent;
		background: transparent;
		margin-top: 0.15rem;
		transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
	}
	.lf__opt:has(.lf__opt-input:checked) .lf__opt-mark {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--text-on-dark);
	}

	/* ── Dettagli facoltativi (chip), visibili solo se l'opzione è scelta ── */
	.lf__opt-extra {
		margin: 0.4rem 0 0.2rem;
		padding: 0.85rem 1rem 1rem;
		background: var(--bg-alt);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.lf__opt-extra[hidden] {
		display: none !important;
	}
	.lf__opt-extra-label {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.lf__opt-extra-label span {
		font-weight: 400;
		letter-spacing: 0.06em;
		opacity: 0.7;
	}
	.lf__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.lf__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.7rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 400;
		color: var(--text-muted);
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
	}
	.lf__chip:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.lf__chip input {
		accent-color: var(--accent);
		flex-shrink: 0;
		margin: 0;
	}
	.lf__chip:has(input:checked) {
		border-color: var(--accent);
		background: var(--accent-tint);
		color: var(--accent);
	}

	/* ── Riga azioni ─────────────────────────────────────────────────── */
	.lf__actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.4rem;
		border-top: 1px solid var(--border);
	}
	.lf__actions > .lf__next:only-child {
		margin-left: auto;
	}
	.lf__next {
		border: none;
		cursor: pointer;
	}
	.lf__next:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	.lf__next:disabled:hover {
		background: var(--accent);
	}
	.lf__next:disabled:active {
		transform: none;
	}
	.lf__arrow {
		display: inline-block;
		transition: transform 0.18s ease;
	}
	.lf__next:not(:disabled):hover .lf__arrow {
		transform: translateX(4px);
	}
	.lf__back {
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		transition: color 0.18s ease;
	}
	.lf__back:hover {
		color: var(--text);
	}

	.lf__error {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		color: #a33327;
	}

	/* ── Scelta del contatto (step 2-scelta) ──────────────────────────── */
	.lf__choices {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.lf__choice {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.1rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		cursor: pointer;
		text-align: left;
		width: 100%;
		transition: border-color 0.16s ease, background 0.16s ease, transform 0.1s ease-out;
	}
	.lf__choice:hover {
		border-color: var(--accent);
		background: var(--lf-card-hover);
	}
	.lf__choice:active {
		transform: scale(0.995);
		transition-duration: 0.05s;
	}
	.lf__choice-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
	}
	.lf__choice-texts {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}
	.lf__choice-label {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--text);
	}
	.lf__choice-sub {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		color: var(--text-muted);
	}
	.lf__choice-arr {
		flex-shrink: 0;
		color: var(--accent);
		font-weight: 600;
		opacity: 0;
		transform: translateX(-3px);
		transition: opacity 0.18s ease, transform 0.18s ease;
	}
	.lf__choice:hover .lf__choice-arr {
		opacity: 1;
		transform: translateX(0);
	}

	/* ── Contatto diretto col referente (step 3-referente-*) ──────────── */
	.lf__referente {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.lf__referente-btn {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 1rem 1.1rem;
		background: var(--accent);
		color: var(--text-on-dark);
		border: 1px solid var(--accent);
		border-radius: var(--radius);
		text-decoration: none;
		cursor: pointer;
		transition: background 0.15s ease, transform 0.1s ease-out;
	}
	.lf__referente-btn:hover {
		background: var(--accent-hover);
	}
	.lf__referente-btn:active {
		transform: scale(0.995);
		transition-duration: 0.05s;
	}
	.lf__referente-btn--outline {
		background: transparent;
		color: var(--text);
		border-color: var(--border-strong);
	}
	.lf__referente-btn--outline:hover {
		border-color: var(--accent);
		background: var(--lf-card-hover);
	}
	/* "Salva contatto": un'azione minore, non un secondo modo di raggiungere il
	   referente — bordo tratteggiato e colori attenuati la tengono in fondo
	   all'elenco senza competere con chiamata/email/WhatsApp. */
	.lf__referente-btn--ghost {
		background: transparent;
		color: var(--text-muted);
		border-style: dashed;
		border-color: var(--border-strong);
	}
	.lf__referente-btn--ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.lf__referente-btn[hidden] {
		display: none !important;
	}
	/* Orari della segreteria telefonica: un vincolo da leggere prima di premere
	   "Chiama", non una nota a piè di pagina. */
	.lf__orari {
		margin: 0;
		padding: 0.7rem 0.9rem;
		background: var(--accent-tint);
		border-radius: var(--radius);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--accent);
	}
	.lf__orari[hidden] {
		display: none !important;
	}
	.lf__referente-btn-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.lf__referente-btn-texts {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.lf__referente-btn-label {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.2;
	}
	.lf__referente-btn-value {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		opacity: 0.85;
	}

	/* ── Calendario: fascia di giorni scorrevole + orari a chip ───────── */
	.lf__picker {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.lf__daystrip {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		padding: 0.15rem 0.15rem 0.6rem;
		margin: -0.15rem -0.15rem -0.6rem;
	}
	.lf__day {
		flex: 0 0 auto;
		scroll-snap-align: start;
		width: 4rem;
		padding: 0.65rem 0.4rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		cursor: pointer;
		transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
	}
	.lf__day:hover:not(:disabled) {
		border-color: var(--accent);
	}
	.lf__day:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}
	.lf__day.is-selected {
		background: var(--accent);
		border-color: var(--accent);
	}
	.lf__day-dow {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.lf__day.is-selected .lf__day-dow {
		color: rgba(255, 255, 255, 0.75);
	}
	.lf__day-num {
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--text);
	}
	.lf__day.is-selected .lf__day-num {
		color: var(--text-on-dark);
	}

	.lf__slots {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.lf__slots[hidden] {
		display: none !important;
	}
	.lf__slots-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.lf__slots-group-label {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.lf__slots-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.lf__slot {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		padding: 0.5rem 0.9rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		color: var(--text);
		cursor: pointer;
		transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease;
	}
	.lf__slot:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.lf__slot.is-selected {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--text-on-dark);
	}
	.lf__picker-empty {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	/* ── Campi di testo (messaggio, dati di contatto) ─────────────────── */
	.lf__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.lf__field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.lf__field--full {
		grid-column: 1 / -1;
	}
	.lf__field label {
		font-family: var(--font-sans);
