---
// Modal "Contattaci" — contenitore del form lead.
//
// Si aggancia a qualunque pulsante con [data-open-contact] presente in pagina;
// un eventuale [data-interest="<id attività>"] preseleziona l'attività nello
// step 1 (gli id sono quelli di src/data/leadActivities.ts).
import LeadFormBody from "./LeadFormBody.astro";
import { leadActivityMap } from "../data/leadActivities";
---

<dialog id="lead-modal" class="lf" aria-labelledby="lf-title" data-activities={JSON.stringify(leadActivityMap)}>
	<div class="lf__panel">
		<div class="lf__head">
			<div>
				<p class="eyebrow lf__eyebrow">Contattaci</p>
				<h2 class="lf__title" id="lf-title">Da dove <em class="accent">iniziamo?</em></h2>
			</div>
			<button class="lf__close" type="button" aria-label="Chiudi" data-lf-close>
				<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
					<path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
				</svg>
			</button>
		</div>

		<LeadFormBody prefix="lm" />
	</div>
</dialog>

<style is:global>
	:root {
		/* Superficie "carta" usata solo dentro il form: le card devono staccarsi
		   dal crema del pannello, e fra i token di sito non c'è un bianco. */
		--lf-card: #fffdf6;
		--lf-card-hover: #fffefb;
	}

	/* ── Dialog ──────────────────────────────────────────────────────── */
	.lf {
		border: none;
		padding: 0;
		background: transparent;
		max-width: min(96vw, 40rem);
		width: 100%;
		margin: auto;
	}
	.lf::backdrop {
		background: rgba(28, 28, 24, 0.6);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.lf__panel {
		background: var(--bg);
		color: var(--text);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
		max-height: 92vh;
		overflow-y: auto;
		box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.4);
	}

	/* ── Header ──────────────────────────────────────────────────────── */
	.lf__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 2rem 2rem 1.5rem;
		border-bottom: 1px solid var(--border-strong);
		background: var(--bg-alt);
		position: sticky;
		top: 0;
		z-index: 2;
	}
	.lf__eyebrow {
		margin: 0;
	}
	.lf__title {
		font-size: var(--text-xl);
		line-height: var(--leading-lg);
		letter-spacing: var(--tracking-lg);
		margin: 0.4rem 0 0;
	}
	.lf__title em {
		font-family: var(--font-serif);
		font-size: 1.15em;
	}
	.lf__close {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		background: none;
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		color: var(--text-muted);
		cursor: pointer;
		transition: border-color 0.18s ease, color 0.18s ease, transform 0.1s ease-out;
	}
	.lf__close:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.lf__close:active {
		transform: scale(0.9);
		transition-duration: 0.05s;
	}

	/* ── Indicatore di step ──────────────────────────────────────────── */
	.lf__steps {
		display: flex;
		align-items: center;
		padding: 0.85rem 2rem;
		border-bottom: 1px solid var(--border);
		background: var(--bg-alt);
	}
	.lf__step {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		border: 1.5px solid var(--border-strong);
		color: var(--text-muted);
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
	}
	.lf__step.is-active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--text-on-dark);
	}
	.lf__step.is-done {
		background: var(--accent-tint);
		border-color: var(--accent-tint);
		color: var(--accent);
	}
	.lf__step-line {
		flex: 1;
		height: 1px;
		background: var(--border-strong);
		margin: 0 6px;
	}

	/* ── Corpo dello step ────────────────────────────────────────────── */
	.lf__body {
		padding: 1.6rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.lf__sub {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.6;
		color: var(--text-muted);
	}

	.lf__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* ── Elenco attività (single select) ─────────────────────────────── */
	.lf__opts {
		border: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}
	.lf__opt-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.lf__opt-group-label {
		margin: 0 0 0.15rem;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.lf__opt-wrap {
		display: flex;
		flex-direction: column;
	}

	.lf__opt {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		padding: 0.9rem 1rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		cursor: pointer;
		position: relative;
		transition: border-color 0.16s ease, background 0.16s ease, transform 0.1s ease-out;
	}
	.lf__opt:hover {
		border-color: var(--accent);
		background: var(--lf-card-hover);
	}
	.lf__opt:active {
		transform: scale(0.995);
		transition-duration: 0.05s;
	}
	/* Il radio resta nel DOM (single select nativo, tastiera e form gratis) ma
	   invisibile: lo stato selezionato è comunicato dalla card. */
	.lf__opt-input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
	}
	.lf__opt:has(.lf__opt-input:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.lf__opt:has(.lf__opt-input:checked) {
		border-color: var(--accent);
		background: var(--accent-tint);
	}

	.lf__opt-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
		margin-top: 0.1rem;
	}
	.lf__opt-texts {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}
	.lf__opt-title {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 600;
		line-height: 1.25;
		color: var(--text);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.lf__opt-badge {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 500;
		font-style: normal;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--accent-tint);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}
	.lf__opt-sub {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.5;
		color: var(--text-muted);
	}

	/* Attività comprese, visibili sulla card: un macro-gruppo deve dire subito
	   cosa contiene. Quando l'opzione viene scelta lasciano il posto agli
	   stessi elementi in versione selezionabile (.lf__opt-extra), che
	   altrimenti ripeterebbero la stessa lista due volte. */
	.lf__opt-includes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin-top: 0.45rem;
	}
	.lf__opt:has(.lf__opt-input:checked) .lf__opt-includes {
		display: none;
	}
	.lf__opt-tag {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 500;
		line-height: 1.3;
		color: var(--accent);
		background: var(--accent-tint);
		border-radius: 999px;
		padding: 0.2rem 0.55rem;
	}

	.lf__opt-mark {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
		display: flex;
		align-items: center;
		justify-content: center;
		color: transparent;
		background: transparent;
		margin-top: 0.15rem;
		transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
	}
	.lf__opt:has(.lf__opt-input:checked) .lf__opt-mark {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--text-on-dark);
	}

	/* ── Dettagli facoltativi (chip), visibili solo se l'opzione è scelta ── */
	.lf__opt-extra {
		margin: 0.4rem 0 0.2rem;
		padding: 0.85rem 1rem 1rem;
		background: var(--bg-alt);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.lf__opt-extra[hidden] {
		display: none !important;
	}
	.lf__opt-extra-label {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.lf__opt-extra-label span {
		font-weight: 400;
		letter-spacing: 0.06em;
		opacity: 0.7;
	}
	.lf__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.lf__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.7rem;
		background: var(--lf-card);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 400;
		color: var(--text-muted);
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
	}
	.lf__chip:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.lf__chip input {
		accent-color: var(--accent);
		flex-shrink: 0;
		margin: 0;
	}
	.lf__chip:has(input:checked) {
		border-color: var(--accent);
		background: var(--accent-tint);
		color: var(--accent);
	}

	/* ── Riga azioni ─────────────────────────────────────────────────── */
	.lf__actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.4rem;
		border-top: 1px solid var(--border);
	}
	.lf__actions > .lf__next:only-child {
		margin-left: auto;
	}
	.lf__next {
		border: none;
		cursor: pointer;
	}
	.lf__next:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	.lf__next:disabled:hover {
		background: var(--accent);
	}
	.lf__next:disabled:active {
		transform: none;
	}
	.lf__arrow {
		display: inline-block;
		transition: transform 0.18s ease;
	}
	.lf__next:not(:disabled):hover .lf__arrow {
		transform: translateX(4px);
	}
	.lf__back {
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		transition: color 0.18s ease;
	}
	.lf__back:hover {
		color: var(--text);
	}

	.lf__error {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		color: #a33327;
	}

	/* ── Segnaposto step 2 (temporaneo) ──────────────────────────────── */
	.lf__recap {
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		background: var(--lf-card);
		overflow: hidden;
	}
	.lf__recap-row {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0.5rem;
		padding: 0.65rem 1rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
	}
	.lf__recap-row:last-child {
		border-bottom: none;
	}
	.lf__recap-row > span:first-child {
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		padding-top: 0.15rem;
	}
	.lf__placeholder {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--text-muted);
		border-left: 3px solid var(--accent);
		padding-left: 0.9rem;
	}

	/* ── Fix [hidden] ────────────────────────────────────────────────── */
	.lf__body[hidden],
	.lf__error[hidden],
	.lf__steps[hidden] {
		display: none !important;
	}

	body.lf-locked {
		overflow: hidden;
	}

	/* ── Mobile ──────────────────────────────────────────────────────── */
	@media (max-width: 560px) {
		.lf__head {
			padding: 1.4rem 1.2rem 1.2rem;
		}
		.lf__steps {
			padding: 0.75rem 1.2rem;
		}
		.lf__body {
			padding: 1.3rem 1.2rem 1.6rem;
		}
		.lf__opt {
			padding: 0.8rem 0.85rem;
			gap: 0.7rem;
		}
		.lf__recap-row {
			grid-template-columns: 5.5rem 1fr;
		}
	}
</style>

<script>
	// @ts-nocheck — script vanilla per il browser (accesso al DOM, niente tipi)
	import { initLeadForm } from "../lib/leadForm.client.js";

	const modal = document.getElementById("lead-modal");
	const form = initLeadForm(modal, {
		prefix: "lm",
		onClose: function () {
			modal.close();
		},
	});

	// Unico punto di pulizia: X, backdrop ed Esc passano tutti di qui, così il
	// form riparte sempre pulito alla riapertura.
	modal.addEventListener("close", function () {
		document.body.classList.remove("lf-locked");
		form.clear();
	});

	document.addEventListener("click", function (e) {
		const trigger = e.target.closest("[data-open-contact]");
		if (!trigger) return;
		modal.showModal();
		document.body.classList.add("lf-locked");
		form.open(location.pathname, (trigger.textContent || "").trim(), trigger.dataset.interest);
	});

	// Chiusura dal backdrop: il click cade sul <dialog> stesso, non sul pannello.
	modal.addEventListener("click", function (e) {
		if (e.target === modal) modal.close();
	});
</script>
