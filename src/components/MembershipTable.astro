---
import { getEntry } from "astro:content";
import PlanMark from "./PlanMark.astro";
import InfoTip from "./InfoTip.astro";
import { url } from "../lib/paths";

interface Props {
	eyebrow?: string;
	title?: string;
	lede?: string;
	/** Etichetta del pulsante sotto ogni piano. */
	planCtaLabel?: string;
	/** Destinazione del pulsante sotto ogni piano. */
	planCtaHref?: string;
}

const {
	eyebrow,
	title,
	lede,
	planCtaLabel = "Scopri di più",
	planCtaHref = url("/prenota-un-tour"),
} = Astro.props;

// Sorgente unica della tabella: src/content/memberships/tabella.json.
const tabella = await getEntry("memberships", "tabella");
if (!tabella) throw new Error("Manca src/content/memberships/tabella.json");
const { plans, features } = tabella.data;

const priceTooltip = "Prezzo relativo alla rata mensile di abbonamento annuale, per maggiori info clicca sul pulsante sotto al piano.";
---

<section class="compare">
	{(eyebrow || title || lede) && (
		<div class="compare__head">
			{eyebrow && <span class="eyebrow">{eyebrow}</span>}
			{title && <h2>{title}</h2>}
			{lede && <p class="lede" set:html={lede} />}
		</div>
	)}

	<div class="compare-scroll">
		<div class="compare-table" role="table" aria-label="Confronto abbonamenti Gold, Silver, Gym e Swim">
			<div class="compare-row compare-row--head" role="row">
				<div class="compare-cell compare-cell--label" role="columnheader"></div>
				{plans.map((p) => (
					<div class={`compare-cell compare-cell--plan compare-cell--plan-${p.key} ${p.featured ? "compare-cell--featured" : ""}`} role="columnheader">
						<strong class="plan-name">
							{p.name}
							{p.duration && <InfoTip text={p.duration} align="end" direction="down" />}
						</strong>
					</div>
				))}
			</div>

			{features.map((f) => (
				<div class="compare-row" role="row">
					<div class="compare-cell compare-cell--label" role="rowheader">
						<span class="feature-label">
							{f.label}
							{f.note && <InfoTip text={f.note} />}
						</span>
					</div>
					{plans.map((p) => (
						<div class={`compare-cell compare-cell--plan compare-cell--plan-${p.key} ${p.featured ? "compare-cell--featured" : ""}`} role="cell">
							<PlanMark status={f.access[p.key]} />
						</div>
					))}
				</div>
			))}

			<div class="compare-row compare-row--cta" role="row">
				<div class="compare-cell compare-cell--label" role="cell"></div>
				{plans.map((p, i) => (
					<div class={`compare-cell compare-cell--plan compare-cell--plan-${p.key} ${p.featured ? "compare-cell--featured" : ""}`} role="cell">
						<span class="plan-price">
							{p.price}<span class="plan-price-unit">/mese</span>
							<InfoTip text={priceTooltip} align={i === plans.length - 1 ? "end" : "start"} />
						</span>
						<a class="plan-cta" href={planCtaHref}>{planCtaLabel}</a>
					</div>
				))}
			</div>
		</div>
	</div>

	<p class="compare-legend">
		<span class="legend-item"><PlanMark status="full" /> incluso</span>
		<span class="legend-item"><PlanMark status="rate" /> tariffa agevolata</span>
		<span class="legend-item"><PlanMark status="none" /> non incluso</span>
	</p>

	<slot />
</section>

<style>
	.compare {
		max-width: 64rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
	}
	.compare__head {
		max-width: 42rem;
		margin: 0 auto 2.5rem;
		text-align: center;
	}
	.compare__head .lede {
		margin-inline: auto;
		margin-bottom: 0;
	}

	.compare-scroll {
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.compare-table {
		display: grid;
		grid-template-columns: minmax(160px, 1.3fr) repeat(4, minmax(130px, 1fr));
		min-width: 44rem;
		background: var(--bg-alt);
	}

	@media (max-width: 640px) {
		.compare-table {
			grid-template-columns: minmax(128px, 1fr) repeat(4, minmax(130px, 1fr));
			min-width: 40rem;
		}
	}

	.compare-row {
		display: grid;
		grid-template-columns: subgrid;
		grid-column: 1 / -1;
		border-top: 1px solid var(--border);
	}
	.compare-row:first-child {
		border-top: none;
	}

	.compare-cell {
		padding: 0.7rem 1.25rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.compare-cell--label {
		text-align: left;
		position: sticky;
		left: 0;
		z-index: 2;
		background: var(--bg-alt);
		box-shadow: 2px 0 6px rgba(28, 28, 24, 0.08);
	}
	.feature-label {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--text-base);
	}

	.compare-cell--plan {
		align-items: center;
		text-align: center;
	}

	.compare-row--head .compare-cell {
		padding-top: 0.75rem;
		padding-bottom: 0.7rem;
		background: var(--bg);
	}
	.compare-row--head .compare-cell--label {
		background: var(--bg);
	}
	.compare-row--head .compare-cell--featured {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.plan-name {
		font-family: var(--font-serif);
		font-size: var(--text-xl);
		font-weight: 500;
		display: inline-flex;
		align-items: center;
	}

	.compare-cell--featured {
		background: rgba(28, 28, 24, 0.03);
	}

	.compare-row--cta .compare-cell {
		padding-top: 1rem;
		padding-bottom: 1.75rem;
		gap: 0.75rem;
	}
	.plan-price {
		display: inline-flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.2rem;
		font-family: var(--font-serif);
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--text);
	}
	.plan-price-unit {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 500;
		color: var(--text-muted);
		margin-right: 0.1rem;
	}
	.plan-cta {
		display: inline-block;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: var(--text-xs);
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--text-on-dark);
		background: var(--accent);
		padding: 0.75rem 1.35rem;
		border-radius: var(--radius);
		box-shadow: 0 0 0 0 rgba(139, 108, 20, 0.4);
		animation: plan-cta-pulse 2.6s ease-in-out infinite;
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, background 0.2s ease;
	}
	.plan-cta:hover {
		background: var(--accent-hover);
		transform: translateY(-3px) scale(1.04);
		box-shadow: 0 12px 24px -8px rgba(28, 28, 24, 0.4);
		animation-play-state: paused;
	}
	@keyframes plan-cta-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(139, 108, 20, 0.4);
		}
		50% {
			box-shadow: 0 0 0 9px rgba(139, 108, 20, 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.plan-cta {
			animation: none;
		}
	}

	.compare-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: center;
		margin: 2rem 0 0;
		padding: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		color: var(--text-muted);
	}
	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
</style>
