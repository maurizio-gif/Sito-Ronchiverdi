---
import { getEntry } from "astro:content";
import PlanMark from "./PlanMark.astro";
import InfoTip from "./InfoTip.astro";

interface Props {
	eyebrow?: string;
	title?: string;
	lede?: string;
	/** Etichetta del pulsante sotto ogni piano. */
	planCtaLabel?: string;
	/** Se assente, il pulsante apre il modulo di contatto; passala solo per un link diretto. */
	planCtaHref?: string;
	/** Estratto: le chiavi dei piani da mostrare, nell'ordine dato. Assente = tutti. */
	piani?: string[];
	/** Estratto: le etichette delle voci da mostrare, nell'ordine dato. Assente = tutte. */
	voci?: string[];
	/**
	 * Chiude la tabella col blocco delle formule su misura: le tre variabili
	 * da cui dipende il prezzo, il riferimento d'ingresso e l'invito a
	 * contattare. Va sulla pagina abbonamenti, dove la tabella è il centro
	 * del discorso; sugli estratti dentro altre pagine sarebbe fuori tema.
	 */
	suMisura?: boolean;
}

const { eyebrow, title, lede, planCtaLabel = "Scopri di più", planCtaHref, piani, voci, suMisura } = Astro.props;

// Sorgente unica della tabella: src/content/memberships/tabella.json.
const tabella = await getEntry("memberships", "tabella");
if (!tabella) throw new Error("Manca src/content/memberships/tabella.json");

// L'estratto sceglie piani e voci per nome, non per posizione: se la tabella
// cambia ordine la pagina che lo chiede continua a mostrare le stesse righe.
const pick = <T,>(tutti: T[], chiavi: string[] | undefined, nome: (v: T) => string) => {
	if (!chiavi) return tutti;
	return chiavi.map((k) => {
		const trovato = tutti.find((v) => nome(v) === k);
		if (!trovato) throw new Error(`MembershipTable: "${k}" non è in src/content/memberships/tabella.json`);
		return trovato;
	});
};

const plans = pick(tabella.data.plans, piani, (p) => p.key);
const features = pick(tabella.data.features, voci, (f) => f.label);

// La legenda spiega solo i segni che finiscono davvero in tabella: in un
// estratto di due colonne le altre condizioni sarebbero rumore.
const segni = new Set(features.flatMap((f) => plans.map((p) => f.access[p.key])));

---

<section class="compare">
	{(eyebrow || title || lede) && (
		<div class="compare__head">
			{eyebrow && <span class="eyebrow">{eyebrow}</span>}
			{title && <h2>{title}</h2>}
			{lede && <p class="lede" set:html={lede} />}
		</div>
	)}

	<div class="compare-box">
	<div class="compare-scroll">
		<div
			class="compare-table"
			role="table"
			aria-label={`Confronto abbonamenti ${plans.map((p) => p.name).join(", ")}`}
			style={`--cols:${plans.length}`}
		>
			<div class="compare-row compare-row--head" role="row">
				<div class="compare-cell compare-cell--label" role="columnheader"></div>
				{plans.map((p) => (
					<div class={`compare-cell compare-cell--plan compare-cell--plan-${p.key} ${p.featured ? "compare-cell--featured" : ""}`} role="columnheader">
						<strong class="plan-name">
							{p.name}
							{p.duration && <InfoTip text={p.duration} align="end" direction="down" />}
						</strong>
					</div>
				))}
			</div>

			{features.map((f) => (
				<div class="compare-row" role="row">
					<div class="compare-cell compare-cell--label" role="rowheader">
						<span class="feature-label">
							{f.label}
							{f.note && <InfoTip text={f.note} />}
						</span>
					</div>
					{plans.map((p) => (
						<div class={`compare-cell compare-cell--plan compare-cell--plan-${p.key} ${p.featured ? "compare-cell--featured" : ""}`} role="cell">
							<PlanMark status={f.access[p.key]} />
						</div>
					))}
				</div>
			))}

			<div class="compare-row compare-row--cta" role="row">
				<div class="compare-cell compare-cell--label" role="cell"></div>
				{plans.map((p) => (
					<div class={`compare-cell compare-cell--plan compare-cell--plan-${p.key} ${p.featured ? "compare-cell--featured" : ""}`} role="cell">
						{planCtaHref ? (
							<a class="plan-cta" href={planCtaHref}>{planCtaLabel}</a>
						) : (
							<button type="button" class="plan-cta" data-open-contact data-interest="club-adulti">{planCtaLabel}</button>
						)}
					</div>
				))}
			</div>
		</div>
	</div>

	<p class="compare-legend">
		{segni.has("full") && <span class="legend-item"><PlanMark status="full" /> incluso</span>}
		{/* La condizione per intero sta nel tooltip della riga: qui basta che
		    l'asterisco rimandi a qualcosa, o resterebbe un simbolo muto. */}
		{segni.has("seasonal") && (
			<span class="legend-item">
				<PlanMark status="seasonal" /> incluso da aprile a settembre, poi a tariffa agevolata
			</span>
		)}
		{segni.has("rate") && <span class="legend-item"><PlanMark status="rate" /> tariffa agevolata</span>}
		{segni.has("none") && <span class="legend-item"><PlanMark status="none" /> non incluso</span>}
	</p>
	{suMisura && (
		<div class="su-misura">
			<span class="eyebrow">E il prezzo?</span>
			<h3>La quota si costruisce <em class="accent">su misura</em></h3>
			<p class="su-misura__testo">
				Le colonne qui sopra dicono <strong>quali attività</strong> comprende
				ogni abbonamento. La quota è un'altra cosa e si costruisce su tre
				variabili: per questo non può stare in una colonna.
			</p>
			<ul class="su-misura__assi">
				<li>
					<strong>Fascia d'età</strong>
					<span>Under, adulti, senior: la quota cambia con l'età di chi si iscrive.</span>
				</li>
				<li>
					<strong>Durata</strong>
					<span>Annuale, stagionale o mensile con la formula Flex.</span>
				</li>
				<li>
					<strong>Modalità di pagamento</strong>
					<span>Soluzione unica, rateizzazione o addebito ricorrente.</span>
				</li>
			</ul>
			<p class="su-misura__da">
				Si parte da <strong>{tabella.data.suMisura.daPrezzo}</strong> al mese, su base annuale.
			</p>
			<button type="button" class="btn" data-open-contact data-interest="club-adulti">
				Chiedi la tua formula
			</button>
			<p class="su-misura__nota">
				Ti richiamiamo per capire cosa ti serve e costruire la quota sulla tua
				situazione, senza impegno.
			</p>
		</div>
	)}
	</div>

	<slot />
</section>

<style>
	.compare {
		max-width: 64rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
	}
	.compare__head {
		max-width: 42rem;
		margin: 0 auto 2.5rem;
		text-align: center;
	}
	.compare__head .lede {
		margin-inline: auto;
		margin-bottom: 0;
	}

	/* Tabella, legenda e blocco della quota dentro un bordo solo: sono una
	   cosa sola, e chi legge le colonne cercando un prezzo deve trovare la
	   spiegazione lì, senza staccarsi dall'oggetto che sta guardando. */
	.compare-box {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-alt);
	}
	.compare-scroll {
		overflow-x: auto;
	}

	/* --cols arriva dal markup: la tabella piena ne ha quattro, un estratto
	   anche solo due, e in quel caso non deve scrollare per niente. */
	.compare-table {
		display: grid;
		grid-template-columns: minmax(160px, 1.3fr) repeat(var(--cols, 4), minmax(130px, 1fr));
		min-width: calc(10rem + var(--cols, 4) * 8.5rem);
		background: var(--bg-alt);
	}

	@media (max-width: 640px) {
		.compare-table {
			grid-template-columns: minmax(128px, 1fr) repeat(var(--cols, 4), minmax(130px, 1fr));
			min-width: calc(8rem + var(--cols, 4) * 8rem);
		}
	}

	.compare-row {
		display: grid;
		grid-template-columns: subgrid;
		grid-column: 1 / -1;
		border-top: 1px solid var(--border);
	}
	.compare-row:first-child {
		border-top: none;
	}

	.compare-cell {
		padding: 0.7rem 1.25rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.compare-cell--label {
		text-align: left;
		position: sticky;
		left: 0;
		z-index: 2;
		background: var(--bg-alt);
		box-shadow: 2px 0 6px rgba(28, 28, 24, 0.08);
	}
	.feature-label {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--text-base);
	}

	.compare-cell--plan {
		align-items: center;
		text-align: center;
	}

	.compare-row--head .compare-cell {
		padding-top: 0.75rem;
		padding-bottom: 0.7rem;
		background: var(--bg);
	}
	.compare-row--head .compare-cell--label {
		background: var(--bg);
	}
	.compare-row--head .compare-cell--featured {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.plan-name {
		font-family: var(--font-serif);
		font-size: var(--text-xl);
		font-weight: 500;
		display: inline-flex;
		align-items: center;
	}

	.compare-cell--featured {
		background: rgba(28, 28, 24, 0.03);
	}

	.compare-row--cta .compare-cell {
		padding-top: 1rem;
		padding-bottom: 1.75rem;
		gap: 0.75rem;
	}
	.plan-cta {
		display: inline-block;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: var(--text-xs);
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--text-on-dark);
		background: var(--accent);
		padding: 0.75rem 1.35rem;
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		box-shadow: 0 0 0 0 rgba(139, 108, 20, 0.4);
		animation: plan-cta-pulse 2.6s ease-in-out infinite;
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, background 0.2s ease;
	}
	.plan-cta:hover {
		background: var(--accent-hover);
		transform: translateY(-3px) scale(1.04);
		box-shadow: 0 12px 24px -8px rgba(28, 28, 24, 0.4);
		animation-play-state: paused;
	}
	.plan-cta:active {
		transform: scale(0.97);
		transition-duration: 0.05s;
	}
	@keyframes plan-cta-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(139, 108, 20, 0.4);
		}
		50% {
			box-shadow: 0 0 0 9px rgba(139, 108, 20, 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.plan-cta {
			animation: none;
		}
	}

	/* Attaccato al fondo della tabella, senza stacco: continua il bordo e
	   arrotonda solo sotto, così tabella e quota si leggono come un oggetto
	   unico. Prima era un riquadro staccato più in basso, e per scoprirlo
	   bisognava scorrere: chi guardava le colonne cercando un prezzo non
	   trovava né il prezzo né la spiegazione.
	   Sta fuori da .compare-scroll di proposito: dentro erediterebbe la
	   larghezza minima della griglia e su telefono si leggerebbe scorrendo
	   di lato. */
	.su-misura {
		margin: 0;
		padding: 2.25rem 2rem 2.5rem;
		text-align: center;
		background: var(--bg);
		border-top: 1px solid var(--border);
	}
	.su-misura h3 {
		margin: 0.4rem 0 0.9rem;
		font-size: var(--text-2xl);
		line-height: var(--leading-lg);
	}
	.su-misura__testo {
		max-width: 38rem;
		margin: 0 auto;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--text-muted);
	}
	.su-misura__assi {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin: 2rem 0;
		padding: 0;
		list-style: none;
		text-align: left;
	}
	.su-misura__assi li {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 1.1rem;
		background: var(--bg);
		border-radius: 10px;
	}
	.su-misura__assi strong {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.su-misura__assi span {
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		line-height: 1.6;
		color: var(--text-muted);
	}
	.su-misura__da {
		margin: 0 0 1.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		line-height: 1.4;
		color: var(--text);
	}
	.su-misura .btn {
		cursor: pointer;
		font-family: var(--font-sans);
		border: none;
	}
	.su-misura__nota {
		max-width: 32rem;
		margin: 1.1rem auto 0;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		line-height: 1.6;
		color: var(--text-muted);
	}
	@media (max-width: 720px) {
		.su-misura {
			padding: 2rem 1.25rem;
		}
		.su-misura__assi {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}
	}

	.compare-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: center;
		/* Dentro il contenitore: sotto le righe che spiega, col suo respiro,
		   senza staccarsi dalla tabella. */
		margin: 0;
		padding: 1.25rem 1.5rem;
		border-top: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		color: var(--text-muted);
	}
	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	/* Il segno stagionale porta l'asterisco fuori dal cerchio: senza questo
	   spazio finirebbe attaccato al testo della voce accanto. */
	.legend-item :global(.mark--seasonal) {
		margin-right: 0.2rem;
	}
</style>
