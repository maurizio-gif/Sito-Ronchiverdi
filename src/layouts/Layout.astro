---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/totem.css";
import "@fontsource/jost/300.css";
import "@fontsource/jost/400.css";
import "@fontsource/jost/400-italic.css";
import "@fontsource/jost/500.css";
import "@fontsource/jost/600.css";
import "@fontsource/jost/700.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/700.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import LeadModal from "../components/LeadModal.astro";
import { url } from "../lib/paths";

interface Props {
	title: string;
	description?: string;
	/** Immagine per l'anteprima social, relativa a public/ (es. "og/tennis.jpg").
	 *  Va usato un file 1200x630: è il formato che WhatsApp e Meta ritagliano
	 *  senza tagliare via mezza foto. In mancanza si usa quella del club. */
	image?: string;
	/** Pagine di lavoro non ancora pubbliche: fuori dagli indici dei motori. */
	noindex?: boolean;
	/** JSON-LD aggiuntivo della pagina (es. FAQPage, Event). */
	schema?: unknown;
}
const { title, description, image, noindex = false, schema } = Astro.props;

// Indirizzo canonico della pagina. Serve a dire a Google qual è l'unico
// indirizzo buono fra le copie che il sito ha oggi (GitHub Pages, preview
// Vercel, dominio definitivo domani): senza, sceglie lui.
const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: Astro.url.href;

const assoluto = (percorso: string) =>
	Astro.site ? new URL(url(percorso), Astro.site).href : url(percorso);

const ogImage = assoluto(image ?? "og/ronchiverdi.jpg");

const structuredData = {
	"@context": "https://schema.org",
	"@type": "SportsActivityLocation",
	name: "Ronchiverdi Sport Club",
	description:
		"Club sportivo a Torino: tennis, padel, nuoto, fitness, running e triathlon in 35.000 mq tra indoor e outdoor, con Young School per famiglie.",
	url: Astro.site ? new URL(url("/"), Astro.site).toString() : undefined,
	image: ogImage,
	telephone: "+39 011 6612146",
	sameAs: ["https://www.facebook.com/ronchiverdi", "https://www.instagram.com/ronchiverdi"],
	address: {
		"@type": "PostalAddress",
		streetAddress: "Corso Moncalieri 466",
		addressLocality: "Torino",
		postalCode: "10133",
		addressRegion: "TO",
		addressCountry: "IT",
	},
};
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<!-- CookieYes: primo script del <head>, così il blocco preventivo dei
		     cookie di terze parti avviene prima che qualunque tag parta. -->
		<script
			id="cookieyes"
			type="text/javascript"
			src="https://cdn-cookieyes.com/client_data/c6534d8ba21a289ba21b246fdea24820/script.js"
			is:inline></script>
		<link rel="icon" href={url("favicon.ico")} sizes="any" />
		<link rel="icon" type="image/png" href={url("favicon.png")} />
		<link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonical} />
		<title>{title}</title>

		<!-- Anteprima nei social e su WhatsApp: senza questi tag un link
		     condiviso appare come testo nudo, senza titolo né immagine. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ronchiverdi Sport Club" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
	</head>
	<body>
		<Nav />
		<slot />
		<Footer />
		<LeadModal />
		<script>
			// Apre la sessione e fissa le UTM di ingresso su ogni pagina, prima
			// che l'utente navighi via e l'URL con i parametri sia perso.
			import { initTracking } from "../lib/tracking.client.js";
			initTracking();
		</script>
		<script>
			const obs = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const el = entry.target;
						const delay = el.dataset.animDelay ? parseInt(el.dataset.animDelay, 10) : 0;
						setTimeout(() => el.classList.add("is-visible"), delay);
						obs.unobserve(el);
					});
				},
				{ threshold: 0.05, rootMargin: "0px" }
			);

			function register(selector, type, baseDelay = 0, stagger = 0) {
				document.querySelectorAll(selector).forEach((el, i) => {
					if (el.closest(".hero")) return;
					// Il contenuto di un <dialog> chiuso non interseca mai il viewport:
					// registrarlo lo lascerebbe a opacity 0 anche dopo l'apertura.
					if (el.closest("dialog")) return;
					if (!el.hasAttribute("data-anim")) el.setAttribute("data-anim", type);
					if (!el.dataset.animDelay && baseDelay + stagger * i > 0) {
						el.dataset.animDelay = String(baseDelay + stagger * i);
					}
					obs.observe(el);
				});
			}

			// Etichette e titoli
			register(".panel__head .eyebrow", "fade", 0, 0);
			register(".eyebrow", "from-left", 0, 0);
			register(".panel__title", "from-left", 60, 0);
			register(".page-header h1", "reveal", 0, 0);
			register("h2", "reveal", 0, 0);
			register(".lede", "from-left", 80, 80);

			// Immagini
			register(".chi-siamo-img--main", "scale", 0, 0);
			register(".chi-siamo-img--accent", "scale", 150, 0);
			register(".young-school-photo", "scale", 0, 0);

			// Numeri e card
			register(".stat", "scale", 100, 80);
			register(".club-gallery__item", "true", 0, 70);
			register(".compare-scroll", "scale", 0, 0);

			// Bottoni fuori dall'hero
			register(".final-cta .btn", "pop", 140, 0);
			register(".section-dark .btn", "pop", 140, 0);
			register(".young-school-content .btn", "pop", 140, 0);
		</script>
	</body>
</html>
