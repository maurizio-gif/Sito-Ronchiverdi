---
// Guest register: la pagina di chi si presenta in sede senza aver scritto
// prima. La apre la persona stessa, col proprio telefono, da un QR code in
// reception — per questo la conferma finisce sulla home del sito e non su una
// nuova registrazione. Due strade, entrambe con lo stesso esito nel CRM — una
// richiesta marcata `origine: "walk-in"` e un'opportunità da assegnare:
//
//   1. Registrati — dati e attività di interesse, e basta: qualcuno del
//      commerciale la prenderà in carico.
//   2. Prenota un tour — quando in quel momento non c'è un commerciale
//      disponibile, la persona si fissa la visita da sola, sugli stessi
//      orari liberi che vede il form del sito.
//
// La differenza col form del sito è tutta nella provenienza: `origine` dice
// "walk-in" invece di "lead-modal", e il campo `operatore` porta chi era al
// banco. Su quella base il trigger del database apre sempre l'opportunità
// (dal sito lo fa solo per gli abbonamenti) e la lascia da assegnare.
//
// La pagina gira solo dove c'è un runtime: legge gli operatori dal database
// con la service_role key, quindi su Vercel. Sulla copia di prova su GitHub
// Pages, che è statica, non funziona — come /api/lead.
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import prefissi from "../data/prefissi-telefonici";
import { leadActivityGroups, leadActivities } from "../data/leadActivities";
import { getOperatoriSegreteria } from "../lib/operatori";
import { url } from "../lib/paths";

const operatori = await getOperatoriSegreteria();

// Etichetta e platea di ogni attività, per il client: servono a comporre il
// payload senza ricopiare i testi nello script.
const mappaAttivita = Object.fromEntries(
	leadActivities.map((a) => [a.id, { label: a.label, audience: a.audience }])
);
---

<Layout
	title="Guest register — Ronchiverdi Sport Club"
	description="Registrazione di chi si presenta in sede: dati di contatto o prenotazione di un tour del club."
	noindex
	senzaNavigazione
>
	<main class="gr" data-attivita={JSON.stringify(mappaAttivita)}>
		<header class="gr__head">
			<span class="eyebrow">Ronchiverdi Sport Club</span>
			<h1>Benvenuto in <em class="accent">Ronchiverdi</em></h1>
			<p class="gr__lede">
				Lasciaci i tuoi dati e l'attività che ti interessa. Se preferisci
				vedere il club con i tuoi occhi, puoi fissare subito un tour.
			</p>
		</header>

		<!-- ─── Scelta della strada ─────────────────────────────────────── -->
		<div class="gr__panel" data-gr-step="scelta">
			<button class="gr__choice" type="button" data-gr-vai="registrati">
				<span class="gr__choice-icon" aria-hidden="true">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.5" /><path d="M4.5 20c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
				</span>
				<span class="gr__choice-texts">
					<span class="gr__choice-label">Registrati</span>
					<span class="gr__choice-sub">Lasciaci i tuoi dati e l'attività che ti interessa</span>
				</span>
				<span class="gr__choice-arr" aria-hidden="true">→</span>
			</button>

			<button class="gr__choice" type="button" data-gr-vai="tour">
				<span class="gr__choice-icon" aria-hidden="true">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
				</span>
				<span class="gr__choice-texts">
					<span class="gr__choice-label">Prenota un tour</span>
					<span class="gr__choice-sub">Scegli giorno e ora: ti accompagniamo noi a vedere il club</span>
				</span>
				<span class="gr__choice-arr" aria-hidden="true">→</span>
			</button>
		</div>

		<!-- ─── Registrati ──────────────────────────────────────────────── -->
		<div class="gr__panel" data-gr-step="registrati" hidden>
			<h2 class="gr__panel-title">I tuoi dati</h2>

			<div class="gr__grid" data-gr-campi="registrati">
				<div class="gr__field">
					<label for="gr-r-nome">Nome <span aria-hidden="true">*</span></label>
					<input id="gr-r-nome" type="text" autocomplete="given-name" data-gr="nome" />
				</div>
				<div class="gr__field">
					<label for="gr-r-cognome">Cognome <span aria-hidden="true">*</span></label>
					<input id="gr-r-cognome" type="text" autocomplete="family-name" data-gr="cognome" />
				</div>
				<div class="gr__field gr__field--full">
					<label for="gr-r-email">Email <span aria-hidden="true">*</span></label>
					<input id="gr-r-email" type="email" autocomplete="email" placeholder="nome@esempio.com" data-gr="email" />
				</div>
				<div class="gr__field gr__field--full">
					<label for="gr-r-cellulare">Cellulare <span aria-hidden="true">*</span></label>
					<div class="gr__tel">
						<select id="gr-r-prefisso" class="gr__tel-prefisso" aria-label="Prefisso internazionale" autocomplete="tel-country-code" data-gr="prefisso">
							{prefissi.map((pf) => (
								<option value={pf.dial} selected={pf.dial === "+39"}>{pf.flag} {pf.dial}</option>
							))}
						</select>
						<input id="gr-r-cellulare" type="tel" autocomplete="tel-national" placeholder="3XX XXX XXXX" data-gr="cellulare" />
					</div>
				</div>
				<fieldset class="gr__field gr__field--full gr__chips">
					<legend>Attività di interesse <span aria-hidden="true">*</span></legend>
					{leadActivityGroups.map((gruppo) => (
						<div class="gr__chip-gruppo">
							<p class="gr__chip-gruppo-label">{gruppo.label}</p>
							<div class="gr__chip-fila">
								{gruppo.items.map((a) => (
									<label class="gr__chip">
										<input type="checkbox" value={a.id} data-gr="attivita" />
										<span>{a.label}{a.badge ? ` · ${a.badge}` : ""}</span>
									</label>
								))}
							</div>
						</div>
					))}
				</fieldset>
				<div class="gr__field gr__field--full" data-gr-operatore hidden={operatori.length === 0}>
					<label for="gr-r-operatore">Operatore che ti sta registrando <em>(facoltativo)</em></label>
					<select id="gr-r-operatore" data-gr="operatore">
						<option value="">Nessuno</option>
						{operatori.map((o) => <option value={o.slug}>{o.nome}</option>)}
					</select>
				</div>
			</div>

			<div class="gr__consent">
				<label class="gr__consent-item">
					<input id="gr-r-privacy" type="checkbox" data-gr="privacy" />
					<span>Ho letto e accetto la <a href={url("/privacy")} target="_blank">Privacy Policy</a>. <strong>(obbligatorio)</strong></span>
				</label>
				<label class="gr__consent-item">
					<input id="gr-r-marketing" type="checkbox" data-gr="marketing" />
					<span>Acconsento a ricevere comunicazioni e novità da Ronchiverdi. <em>(facoltativo)</em></span>
				</label>
			</div>

			<div class="gr__actions">
				<button class="gr__back" type="button" data-gr-vai="scelta">← Indietro</button>
				<button class="btn" type="button" data-gr-invia="registrati">Invia <span aria-hidden="true">→</span></button>
			</div>
			<p class="gr__error" hidden role="alert"></p>
		</div>

		<!-- ─── Prenota un tour ─────────────────────────────────────────── -->
		<div class="gr__panel" data-gr-step="tour" hidden>
			<h2 class="gr__panel-title">Quando vuoi visitarlo?</h2>
			<p class="gr__panel-sub">Scegli il giorno e l'ora: sono gli orari ancora liberi in agenda.</p>

			<div class="gr__giorni" id="gr-giorni"></div>
			<div class="gr__slots" id="gr-slots" hidden></div>

			<h2 class="gr__panel-title gr__panel-title--sep">I tuoi dati</h2>

			<div class="gr__grid" data-gr-campi="tour">
				<div class="gr__field">
					<label for="gr-t-nome">Nome <span aria-hidden="true">*</span></label>
					<input id="gr-t-nome" type="text" autocomplete="given-name" data-gr="nome" />
				</div>
				<div class="gr__field">
					<label for="gr-t-cognome">Cognome <span aria-hidden="true">*</span></label>
					<input id="gr-t-cognome" type="text" autocomplete="family-name" data-gr="cognome" />
				</div>
				<div class="gr__field gr__field--full">
					<label for="gr-t-email">Email <span aria-hidden="true">*</span></label>
					<input id="gr-t-email" type="email" autocomplete="email" placeholder="nome@esempio.com" data-gr="email" />
				</div>
				<div class="gr__field gr__field--full">
					<label for="gr-t-cellulare">Cellulare <span aria-hidden="true">*</span></label>
					<div class="gr__tel">
						<select id="gr-t-prefisso" class="gr__tel-prefisso" aria-label="Prefisso internazionale" autocomplete="tel-country-code" data-gr="prefisso">
							{prefissi.map((pf) => (
								<option value={pf.dial} selected={pf.dial === "+39"}>{pf.flag} {pf.dial}</option>
							))}
						</select>
						<input id="gr-t-cellulare" type="tel" autocomplete="tel-national" placeholder="3XX XXX XXXX" data-gr="cellulare" />
					</div>
				</div>
				<fieldset class="gr__field gr__field--full gr__chips">
					<legend>Attività di interesse <span aria-hidden="true">*</span></legend>
					{leadActivityGroups.map((gruppo) => (
						<div class="gr__chip-gruppo">
							<p class="gr__chip-gruppo-label">{gruppo.label}</p>
							<div class="gr__chip-fila">
								{gruppo.items.map((a) => (
									<label class="gr__chip">
										<input type="checkbox" value={a.id} data-gr="attivita" />
										<span>{a.label}{a.badge ? ` · ${a.badge}` : ""}</span>
									</label>
								))}
							</div>
						</div>
					))}
				</fieldset>
				<div class="gr__field gr__field--full" data-gr-operatore hidden={operatori.length === 0}>
					<label for="gr-t-operatore">Operatore che ti sta registrando <em>(facoltativo)</em></label>
					<select id="gr-t-operatore" data-gr="operatore">
						<option value="">Nessuno</option>
						{operatori.map((o) => <option value={o.slug}>{o.nome}</option>)}
					</select>
				</div>
			</div>

			<div class="gr__consent">
				<label class="gr__consent-item">
					<input id="gr-t-privacy" type="checkbox" data-gr="privacy" />
					<span>Ho letto e accetto la <a href={url("/privacy")} target="_blank">Privacy Policy</a>. <strong>(obbligatorio)</strong></span>
				</label>
				<label class="gr__consent-item">
					<input id="gr-t-marketing" type="checkbox" data-gr="marketing" />
					<span>Acconsento a ricevere comunicazioni e novità da Ronchiverdi. <em>(facoltativo)</em></span>
				</label>
			</div>

			<div class="gr__actions">
				<button class="gr__back" type="button" data-gr-vai="scelta">← Indietro</button>
				<button class="btn" type="button" data-gr-invia="tour">Prenota il tour <span aria-hidden="true">→</span></button>
			</div>
			<p class="gr__error" hidden role="alert"></p>
		</div>

		<!-- ─── Fatto ───────────────────────────────────────────────────── -->
		<div class="gr__panel gr__panel--fatto" data-gr-step="fatto" hidden aria-live="polite">
			<div class="gr__check" aria-hidden="true">
				<svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M4 13L10 19L22 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</div>
			<h2 class="gr__panel-title">Ci siamo, <em class="accent">grazie!</em></h2>
			<p class="gr__panel-sub" id="gr-fatto-testo"></p>
			<!-- Il QR lo inquadra la persona col proprio telefono: da qui non
			     si registra qualcun altro, si va a vedere il club. -->
			<a class="btn" href={url("/")}>Scopri il club</a>
		</div>
	</main>
</Layout>

<script>
	// @ts-nocheck — script di pagina (accesso al DOM, niente tipi)
	//
	// Due percorsi, un solo invio: raccoglie i campi del pannello attivo e
	// manda tutto a /api/lead con `origine: "walk-in"`, che è ciò che rende
	// questa richiesta diversa da una arrivata dal sito.
	import { withTracking, trackLead } from "../lib/tracking.client.js";
	import { caricaOccupati, isoDateLocal, regoleDi, slotsDisponibili } from "../lib/agendaSlot.js";

	const radice = document.querySelector(".gr");
	if (radice) inizializza(radice);

	function inizializza(radice) {
		// Etichetta e platea di ogni attività, serializzate dal componente
		// Astro: i testi restano definiti una volta sola in
		// src/data/leadActivities.ts.
		let mappaAttivita = {};
		try {
			mappaAttivita = JSON.parse(radice.dataset.attivita || "{}");
		} catch (e) {}

		const TIPO_AGENDA = "appuntamento";
		let dataScelta = null;
		let oraScelta = null;

		const pannelli = radice.querySelectorAll("[data-gr-step]");

		function mostra(passo) {
			pannelli.forEach((p) => {
				p.hidden = p.dataset.grStep !== passo;
			});
			radice.querySelectorAll(".gr__error").forEach((e) => {
				e.hidden = true;
			});
			window.scrollTo({ top: 0, behavior: "smooth" });
			if (passo === "tour") costruisciGiorni();
		}

		radice.addEventListener("click", (e) => {
			const vai = e.target.closest("[data-gr-vai]");
			if (!vai) return;
			// "Registra un'altra persona" riporta alla scelta: il banco serve
			// una persona dopo l'altra, e i campi di prima non devono restare.
			if (vai.dataset.grVai === "scelta") svuota();
			mostra(vai.dataset.grVai);
		});

		// ── Errori ──────────────────────────────────────────────────────
		function errore(pannello, messaggio, campo) {
			const p = pannello.querySelector(".gr__error");
			if (p) {
				p.textContent = messaggio;
				p.hidden = false;
			}
			if (campo) campo.focus();
		}

		// ── Validazione, la stessa del form del sito ────────────────────
		const emailValida = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(v).trim());

		function telefonoValido(v) {
			const cifre = String(v).replace(/[^0-9]/g, "");
			if (!/^[0-9\s-]+$/.test(String(v).trim())) return false;
			if (cifre.length < 6 || cifre.length > 14) return false;
			return !/^(\d)\1+$/.test(cifre);
		}

		/** I campi di un pannello, per `data-gr`. */
		function campi(nome) {
			const zona = radice.querySelector(`[data-gr-campi="${nome}"]`);
			const pannello = radice.querySelector(`[data-gr-step="${nome}"]`);
			const q = (chiave) =>
				zona.querySelector(`[data-gr="${chiave}"]`) ||
				pannello.querySelector(`[data-gr="${chiave}"]`);
			return {
				pannello,
				nome: q("nome"),
				cognome: q("cognome"),
				email: q("email"),
				prefisso: q("prefisso"),
				cellulare: q("cellulare"),
				// Le attività sono più di una: una fila di caselle, non un campo.
				attivita: zona.querySelectorAll('[data-gr="attivita"]'),
				operatore: q("operatore"),
				privacy: q("privacy"),
				marketing: q("marketing"),
			};
		}

		/** Null se qualcosa non va: l'errore l'ha già mostrato. */
		function raccogli(nome) {
			const c = campi(nome);
			if (!c.nome.value.trim()) return errore(c.pannello, "Inserisci il nome.", c.nome), null;
			if (!c.cognome.value.trim()) return errore(c.pannello, "Inserisci il cognome.", c.cognome), null;
			if (!emailValida(c.email.value)) return errore(c.pannello, "Inserisci un indirizzo email valido.", c.email), null;
			if (!telefonoValido(c.cellulare.value)) return errore(c.pannello, "Inserisci un numero di cellulare valido.", c.cellulare), null;
			const scelte = [...c.attivita].filter((x) => x.checked).map((x) => x.value);
			if (!scelte.length) {
				return errore(c.pannello, "Scegli almeno un'attività di interesse.", c.attivita[0]), null;
			}
			if (!c.privacy.checked) return errore(c.pannello, "Il consenso alla Privacy Policy è obbligatorio."), null;

			const etichette = scelte.map((id) => (mappaAttivita[id] || {}).label || id);
			// Le platee scelte: una sola resta quella, più di una diventa
			// "misto" — che è come il resto del sito chiama una richiesta che
			// riguarda adulti e ragazzi insieme.
			const platee = [...new Set(scelte.map((id) => (mappaAttivita[id] || {}).audience).filter(Boolean))];

			return {
				// La provenienza è il punto di tutta la pagina: da qui il CRM sa
				// che questa persona era in sede, e il database apre
				// l'opportunità da assegnare.
				origine: "walk-in",
				pagina: location.pathname,
				cta: "Guest register",
				// `attivita` resta una: è il campo su cui il CRM instrada la
				// richiesta al responsabile del settore, e un canale solo può
				// prenderla in carico. Le altre stanno in `dettagli`, che il
				// CRM e l'email alla segreteria mostrano già come "Interessi".
				attivita: scelte[0],
				attivitaLabel: etichette.join(", "),
				audience: platee.length === 1 ? platee[0] : "misto",
				dettagli: etichette,
				operatore: c.operatore ? c.operatore.value || null : null,
				nome: c.nome.value.trim(),
				cognome: c.cognome.value.trim(),
				email: c.email.value.trim(),
				cellulare: (c.prefisso ? c.prefisso.value : "+39") + " " + c.cellulare.value.trim(),
				privacy: true,
				marketing: !!(c.marketing && c.marketing.checked),
			};
		}

		function invia(payload, testoFatto) {
			try {
				fetch("/api/lead", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(withTracking(payload)),
				});
				trackLead(payload);
			} catch (e) {}

			const testo = radice.querySelector("#gr-fatto-testo");
			if (testo) testo.textContent = testoFatto;
			mostra("fatto");
		}

		// ── Registrati ──────────────────────────────────────────────────
		radice.querySelector('[data-gr-invia="registrati"]').addEventListener("click", () => {
			const payload = raccogli("registrati");
			if (!payload) return;
			invia(payload, "Abbiamo i tuoi dati: la tua richiesta è registrata.");
		});

		// ── Prenota un tour ─────────────────────────────────────────────
		const boxGiorni = radice.querySelector("#gr-giorni");
		const boxSlot = radice.querySelector("#gr-slots");
		let occupati = null;
		let giorniCostruiti = false;

		const GIORNI_BREVI = ["dom", "lun", "mar", "mer", "gio", "ven", "sab"];
		const MESI = [
			"gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno",
			"luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre",
		];

		function dataLunga(iso) {
			const [a, m, g] = iso.split("-").map(Number);
			const d = new Date(a, m - 1, g);
			return `${GIORNI_BREVI[d.getDay()]} ${g} ${MESI[m - 1]}`;
		}

		// Gli orari occupati si chiedono una volta per visita: al banco la
		// pagina resta aperta tutto il giorno, quindi si rileggono a ogni
		// nuovo tour per non proporre uno slot appena preso da altri.
		function costruisciGiorni() {
			if (giorniCostruiti) return;
			giorniCostruiti = true;
			boxGiorni.innerHTML = '<p class="gr__attesa">Cerco gli orari liberi…</p>';

			const regole = regoleDi(TIPO_AGENDA);
			Promise.resolve(caricaOccupati(regole.giorniAvanti)).then((presi) => {
				occupati = presi || {};
				boxGiorni.innerHTML = "";

				let almenoUno = false;
				for (let i = 0; i < regole.giorniAvanti; i++) {
					const d = new Date();
					d.setDate(d.getDate() + i);
					if (!slotsDisponibili(d, TIPO_AGENDA, occupati).length) continue;

					almenoUno = true;
					const iso = isoDateLocal(d);
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "gr__giorno";
					btn.dataset.data = iso;
					btn.innerHTML =
						`<span class="gr__giorno-dow">${GIORNI_BREVI[d.getDay()]}</span>` +
						`<span class="gr__giorno-num">${d.getDate()}</span>`;
					btn.addEventListener("click", () => scegliGiorno(iso, btn));
					boxGiorni.appendChild(btn);
				}

				if (!almenoUno) {
					// Nessuno slot nei prossimi giorni: mandare la persona via a
					// mani vuote sarebbe il peggio, quindi resta la
					// registrazione, che non dipende dall'agenda.
					boxGiorni.innerHTML =
						'<p class="gr__attesa">In questi giorni l\'agenda è piena. Lascia i tuoi dati con "Registrati": ti richiamiamo noi per fissare la visita.</p>';
				}
			});
		}

		function scegliGiorno(iso, btn) {
			dataScelta = iso;
			oraScelta = null;
			boxGiorni.querySelectorAll(".gr__giorno").forEach((b) => b.classList.toggle("is-on", b === btn));

			const [a, m, g] = iso.split("-").map(Number);
			const slot = slotsDisponibili(new Date(a, m - 1, g), TIPO_AGENDA, occupati);

			boxSlot.innerHTML = "";
			slot.forEach((ora) => {
				const b = document.createElement("button");
				b.type = "button";
				b.className = "gr__slot";
				b.textContent = ora;
				b.addEventListener("click", () => {
					oraScelta = ora;
					boxSlot.querySelectorAll(".gr__slot").forEach((x) => x.classList.toggle("is-on", x === b));
				});
				boxSlot.appendChild(b);
			});
			boxSlot.hidden = !slot.length;
		}

		radice.querySelector('[data-gr-invia="tour"]').addEventListener("click", () => {
			const pannello = radice.querySelector('[data-gr-step="tour"]');
			if (!dataScelta) return errore(pannello, "Scegli il giorno della visita.");
			if (!oraScelta) return errore(pannello, "Scegli l'ora della visita.");

			const payload = raccogli("tour");
			if (!payload) return;

			payload.azione = "appuntamento";
			payload.dataScelta = dataScelta;
			payload.oraScelta = oraScelta;
			invia(payload, `Ti aspettiamo ${dataLunga(dataScelta)} alle ${oraScelta}. A dopo!`);
		});

		// ── Pulizia fra una persona e l'altra ───────────────────────────
		function svuota() {
			radice.querySelectorAll("[data-gr]").forEach((el) => {
				if (el.type === "checkbox") el.checked = false;
				else if (el.dataset.gr === "prefisso") el.value = "+39";
				else el.value = "";
			});
			dataScelta = null;
			oraScelta = null;
			boxSlot.innerHTML = "";
			boxSlot.hidden = true;
			// L'agenda si rilegge al prossimo tour: nel frattempo qualcuno può
			// aver preso uno degli orari che stiamo mostrando.
			giorniCostruiti = false;
			boxGiorni.innerHTML = "";
		}
	}
</script>

