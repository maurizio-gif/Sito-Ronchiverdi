---
import Layout from "../layouts/Layout.astro";
import MembershipTable from "../components/MembershipTable.astro";
import TriplePack from "../components/TriplePack.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import { url } from "../lib/paths";
import { faqDiPagina } from "../data/faq";


const faq = faqDiPagina("abbonamenti");
---

<Layout
	title="Abbonamenti — Ronchiverdi Sport Club"
	description="Confronta gli abbonamenti Gym, Swim, Silver e Gold di Ronchiverdi Sport Club: gym floor, corsi fitness, acqua fitness, nuoto libero, piscina estiva, spa, padel e tennis."
	image="og/abbonamenti.jpg"
>
	<PageHero image="images/club/lacertosus.jpg" imageAlt="Area Lacertosus Ronchiverdi" eyebrow="Abbonamenti">
		<Fragment slot="title">Scegli il tuo <em class="accent">abbonamento</em></Fragment>
		<Fragment slot="lede">Quattro combinazioni di attività: dal club completo <strong>Gold</strong> agli abbonamenti <strong>Gym e Swim</strong> dedicati a un'unica area. La quota si costruisce poi sulla tua fascia d'età, sulla durata e sul modo in cui preferisci pagare.</Fragment>
	</PageHero>

	{/* Sopra la tabella solo il titolo: la spiegazione del prezzo sta tutta
	    nel riquadro che `suMisura` mette sotto, dove l'occhio cerca la cifra.
	    Dirla due volte allungava la pagina prima ancora di far vedere le
	    colonne. */}
	<MembershipTable
		eyebrow="Cosa comprendono"
		title="Le quattro combinazioni"
		suMisura
	/>

	<TriplePack />

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vieni a scoprire il club</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un <strong>tour gratuito</strong>: ti aiutiamo a scegliere
			l'abbonamento più adatto a te.
		</p>
		<button type="button" class="btn" data-open-contact data-interest="club-adulti">Prenota un tour</button>
	</section>

	<style>
		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
	</style>
</Layout>
