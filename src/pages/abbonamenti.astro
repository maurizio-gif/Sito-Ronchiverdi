---
import Layout from "../layouts/Layout.astro";
import MembershipTable from "../components/MembershipTable.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import { url } from "../lib/paths";

const faq = [
	{
		q: "Il prezzo mostrato è mensile?",
		a: "Sì, il prezzo indicato è relativo alla rata mensile di un abbonamento annuale. Per maggiori info sulle modalità di pagamento, prenota un tour o contatta la reception.",
	},
	{
		q: "Cosa include l'abbonamento Swim?",
		a: "L'abbonamento Swim ha una durata di 11 mesi (agosto escluso) e include l'accesso a nuoto libero e acqua fitness, ma non alla piscina estiva né alle altre aree del club.",
	},
	{
		q: "Posso passare da un abbonamento all'altro?",
		a: "Sì, è possibile aggiornare il proprio abbonamento in corso d'anno. Vieni in reception o contattaci per valutare insieme la formula più adatta.",
	},
];

---

<Layout
	title="Abbonamenti — Ronchiverdi Sport Club"
	description="Confronta gli abbonamenti Gym, Swim, Silver e Gold di Ronchiverdi Sport Club: gym floor, corsi fitness, acqua fitness, nuoto libero, piscina estiva, spa, padel e tennis."
>
	<PageHero image="images/club/lacertosus.jpg" imageAlt="Area Lacertosus Ronchiverdi" eyebrow="Abbonamenti">
		<Fragment slot="title">Scegli il tuo <em class="accent">abbonamento</em></Fragment>
		<Fragment slot="lede">Quattro formule pensate per ogni esigenza: dal club completo <strong>Gold</strong> agli abbonamenti <strong>Gym e Swim</strong> dedicati a un'unica area.</Fragment>
	</PageHero>

	<MembershipTable />

	{/* La tabella mostra le quattro formule più richieste, non il listino
	    completo: fasce d'età e soluzioni flessibili si costruiscono con un
	    consulente, e senza dirlo qui chi non si riconosce in nessuna delle
	    quattro colonne se ne va pensando che non ci sia altro. */}
	<section class="su-misura">
		<div class="su-misura__box">
			<span class="eyebrow">Non è tutto qui</span>
			<h2>Formule <em class="accent">su misura</em></h2>
			<p class="lede" style="margin-inline:auto">
				Quelle qui sopra sono una selezione. Le formule sono <strong>personalizzate in base alla fascia di età</strong> e disponibili anche con <strong>soluzioni flessibili</strong>.
			</p>
			<button type="button" class="btn" data-open-contact data-interest="club-adulti">
				Contatta un consulente per un preventivo personalizzato
			</button>
		</div>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vieni a scoprire il club</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un <strong>tour gratuito</strong>: ti aiutiamo a scegliere
			l'abbonamento più adatto a te.
		</p>
		<button type="button" class="btn" data-open-contact data-interest="club-adulti">Prenota un tour</button>
	</section>

	<style>
		.su-misura {
			padding: 0 1.5rem 5rem;
		}
		.su-misura__box {
			max-width: 46rem;
			margin: 0 auto;
			padding: 3rem 2rem;
			text-align: center;
			background: var(--bg-alt);
			border: 1px solid var(--border);
			border-radius: var(--radius, 12px);
		}
		.su-misura__box h2 {
			margin: 0.4rem 0 0.8rem;
		}
		.su-misura__box .lede {
			margin-bottom: 2rem;
		}
		.su-misura__box .btn {
			cursor: pointer;
			font-family: var(--font-sans);
			border: none;
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
	</style>
</Layout>
