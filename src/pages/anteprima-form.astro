---
// PAGINA TEMPORANEA DI ANTEPRIMA — da eliminare prima del deploy.
// Serve solo a provare il form contatti finché i pulsanti reali delle pagine
// non vengono agganciati a [data-open-contact].
import Layout from "../layouts/Layout.astro";
import LeadModal from "../components/LeadModal.astro";
---

<Layout title="Anteprima form contatti — Ronchiverdi" description="Pagina di lavoro: anteprima del form contatti.">
	<section class="preview">
		<p class="eyebrow">Pagina di lavoro</p>
		<h1>Anteprima form contatti</h1>
		<p class="lede">
			Ogni pulsante apre lo stesso modal. Quelli con <code>data-interest</code>
			preselezionano l'attività, come faranno i pulsanti delle pagine verticali.
		</p>

		<div class="preview__row">
			<button type="button" class="btn" data-open-contact>Contattaci</button>
			<button type="button" class="btn btn-outline" data-open-contact>Prenota un tour</button>
		</div>

		<div class="preview__row">
			<button type="button" class="btn btn-outline" data-open-contact data-interest="club-adulti">
				da Gym Floor
			</button>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">
				da Scuola Nuoto
			</button>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="corsi-padel">
				da Corsi Padel
			</button>
		</div>
	</section>

	<LeadModal />
</Layout>

<style>
	.preview {
		max-width: 48rem;
		margin: 0 auto;
		padding: 6rem 1.5rem 8rem;
		text-align: center;
	}
	.preview__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}
	code {
		font-size: 0.9em;
		background: var(--accent-tint);
		color: var(--accent);
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}
</style>
