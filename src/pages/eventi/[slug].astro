---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ContactModal from "../../components/ContactModal.astro";
import PageHero from "../../components/PageHero.astro";
import { getUpcomingEvents, badgeDate, formatRange, untilAttr } from "../../lib/events";
import { url } from "../../lib/paths";

// Una pagina per ogni evento in programma, così il link è condivisibile.
// Gli eventi passati non vengono generati: sparisce anche la loro pagina.
export async function getStaticPaths() {
	const eventi = await getUpcomingEvents();
	return eventi.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, altri: eventi.filter((e) => e.id !== entry.id).slice(0, 2) },
	}));
}

const { entry, altri } = Astro.props;
const { Content } = await render(entry);
const data = formatRange(entry.data.date, entry.data.endDate);
---

<Layout
	title={`${entry.data.title} — Eventi Ronchiverdi Sport Club`}
	description={entry.data.summary}
>
	<PageHero
		image={entry.data.image ?? "images/club/notturna.jpg"}
		imageAlt={entry.data.title}
		eyebrow="Eventi e community"
	>
		<Fragment slot="title">{entry.data.title}</Fragment>
		<Fragment slot="lede">{entry.data.summary}</Fragment>
		<ul class="hero-meta">
			<li>
				<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="3.2" width="12" height="11" rx="1.6" stroke="currentColor" stroke-width="1.3" /><path d="M5.5 1.8v2.6M10.5 1.8v2.6M2 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
				<span>{data}</span>
			</li>
			{entry.data.orario && (
				<li>
					<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.3" stroke="currentColor" stroke-width="1.3" /><path d="M8 4.6V8l2.4 1.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
					<span>{entry.data.orario}</span>
				</li>
			)}
			{entry.data.luogo && (
				<li>
					<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14.5s4.7-4.1 4.7-8a4.7 4.7 0 1 0-9.4 0c0 3.9 4.7 8 4.7 8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /><circle cx="8" cy="6.2" r="1.7" stroke="currentColor" stroke-width="1.3" /></svg>
					<span>{entry.data.luogo}</span>
				</li>
			)}
		</ul>
	</PageHero>

	<article class="evento" data-event-until={untilAttr(entry.data.date, entry.data.endDate)}>
		<p class="evento__passato" data-event-past hidden>
			Questo appuntamento è già passato: dai un'occhiata ai <a href={url("/eventi")}>prossimi eventi in programma</a>.
		</p>

		<div class="evento__content">
			<Content />
		</div>

		<div class="evento__cta">
			{entry.data.ctaHref && (
				<a class="btn" href={entry.data.ctaHref.startsWith("http") ? entry.data.ctaHref : url(entry.data.ctaHref)}>
					{entry.data.ctaLabel ?? "Scopri di più"}
				</a>
			)}
			<button type="button" class="btn btn-outline" data-open-contact data-interest="Altro">Contattaci</button>
		</div>
	</article>

	{altri.length > 0 && (
		<section class="altri">
			<div class="altri__head">
				<span class="eyebrow">Continua</span>
				<h2>Gli altri appuntamenti</h2>
			</div>
			<div class="altri-grid">
				{altri.map((e) => {
					const badge = badgeDate(e.data.date);
					return (
						<a class="altro-card" href={url(`/eventi/${e.id}`)} data-event-until={untilAttr(e.data.date, e.data.endDate)}>
							<span class="altro-card__media">
								{e.data.image && <img src={url(e.data.image)} alt="" loading="lazy" />}
								<span class="altro-card__badge" aria-hidden="true">
									<strong>{badge.giorno}</strong>
									<span>{badge.mese}</span>
								</span>
							</span>
							<span class="altro-card__body">
								<span class="altro-card__data">{formatRange(e.data.date, e.data.endDate)}</span>
								<h3>{e.data.title}</h3>
								<p>{e.data.summary}</p>
							</span>
						</a>
					);
				})}
			</div>
			<div class="altri__cta">
				<a class="btn btn-outline" href={url("/eventi")}>Tutti gli eventi</a>
			</div>
		</section>
	)}

	<ContactModal />

	<script>
		// Se l'evento è già passato ma il sito non è ancora stato ricompilato,
		// la pagina resta raggiungibile: lo segnaliamo invece di far credere
		// che l'appuntamento sia ancora in programma.
		const oggi = new Date();
		oggi.setHours(0, 0, 0, 0);
		const articolo = document.querySelector<HTMLElement>(".evento[data-event-until]");
		const until = articolo?.dataset.eventUntil;
		if (until && new Date(`${until}T23:59:59`).getTime() < oggi.getTime()) {
			const avviso = document.querySelector<HTMLElement>("[data-event-past]");
			if (avviso) avviso.hidden = false;
			document.querySelector<HTMLElement>(".evento__cta")?.remove();
		}
		// Le card degli altri eventi seguono la stessa regola.
		document.querySelectorAll<HTMLElement>(".altro-card[data-event-until]").forEach((card) => {
			const fine = card.dataset.eventUntil;
			if (fine && new Date(`${fine}T23:59:59`).getTime() < oggi.getTime()) card.remove();
		});
	</script>

	<style>
		.hero-meta {
			list-style: none;
			margin: 1.75rem 0 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.6rem 1.5rem;
			font-family: var(--font-sans);
			font-size: var(--text-xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--text-on-dark);
			text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
		}
		.hero-meta li {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
		}
		.hero-meta svg {
			color: var(--accent-on-dark);
		}

		.evento {
			max-width: 46rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 3rem;
		}
		.evento__passato {
			margin: 0 0 2rem;
			padding: 1rem 1.25rem;
			border-left: 3px solid var(--accent);
			background: var(--bg-alt);
			border-radius: 0 12px 12px 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.6;
		}
		.evento__passato a {
			color: var(--accent);
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
		/* Corpo dell'evento: HTML libero, quindi gli stili sono globali. */
		.evento__content :global(p) {
			font-family: var(--font-sans);
			font-size: var(--text-md);
			color: var(--text-muted);
			line-height: 1.8;
			margin: 0 0 1.25rem;
		}
		.evento__content :global(ul),
		.evento__content :global(ol) {
			margin: 0 0 1.25rem;
			padding-left: 1.3rem;
			font-family: var(--font-sans);
			font-size: var(--text-md);
			color: var(--text-muted);
			line-height: 1.9;
		}
		.evento__content :global(strong) {
			color: var(--text);
		}
		.evento__content :global(a) {
			color: var(--accent);
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
		.evento__content :global(h4) {
			margin: 2rem 0 0.75rem;
			font-size: var(--text-lg);
		}
		.evento__cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 2.5rem;
		}
		.evento__cta .btn {
			cursor: pointer;
			font-family: var(--font-sans);
			border: none;
		}
		.evento__cta .btn-outline {
			border: 1px solid currentColor;
		}

		.altri {
			max-width: 72rem;
			margin: 0 auto;
			padding: 4rem 1.5rem 6rem;
			border-top: 1px solid var(--border);
		}
		.altri__head {
			text-align: center;
			margin-bottom: 2.5rem;
		}
		.altri__head h2 {
			margin: 0;
		}
		.altri-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem;
		}
		.altro-card {
			display: flex;
			flex-direction: column;
			text-decoration: none;
			color: var(--text);
			background: var(--bg-alt);
			border: 1px solid var(--border);
			border-radius: 16px;
			overflow: hidden;
			transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.altro-card:hover {
			transform: translateY(-6px);
			box-shadow: 0 16px 32px -12px rgba(28, 28, 24, 0.25);
		}
		.altro-card:active {
			transform: scale(0.98);
			transition-duration: 0.05s;
		}
		.altro-card__media {
			position: relative;
			display: block;
			aspect-ratio: 16 / 10;
			background: var(--border-strong);
		}
		.altro-card__media img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.altro-card__badge {
			position: absolute;
			top: 0.9rem;
			left: 0.9rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			width: 3.4rem;
			height: 3.4rem;
			border-radius: 12px;
			background: var(--bg);
			box-shadow: 0 8px 20px -8px rgba(28, 28, 24, 0.5);
			font-family: var(--font-sans);
			line-height: 1.1;
		}
		.altro-card__badge strong {
			font-size: var(--text-md);
			font-weight: 600;
		}
		.altro-card__badge span {
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.altro-card__body {
			display: block;
			padding: 1.5rem 1.5rem 1.75rem;
		}
		.altro-card__data {
			display: block;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--accent);
			margin-bottom: 0.6rem;
		}
		.altro-card__body h3 {
			margin: 0 0 0.5rem;
			font-size: var(--text-lg);
		}
		.altro-card__body p {
			margin: 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.6;
		}
		.altri__cta {
			margin-top: 2.5rem;
			text-align: center;
		}
		@media (max-width: 760px) {
			.altri-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Layout>
