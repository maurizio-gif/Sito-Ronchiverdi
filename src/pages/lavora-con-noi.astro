---
import Layout from "../layouts/Layout.astro";
import prefissi from "../data/prefissi-telefonici";
import { url } from "../lib/paths";
import { AREE, DISPONIBILITA, MOTIVI } from "../data/lavoraConNoi";
import { CV_ACCEPT, CV_FORMATI_TESTO, CV_MAX_MB } from "../lib/candidature";

// Candidature spontanee. Il club non pubblica posizioni aperte — non ne ha un
// elenco stabile — quindi la pagina fa un'altra cosa: dice in quali aree
// cerca persone di solito, e raccoglie chi si propone.
//
// Contenuti (aree, ruoli, disponibilità) in src/data/lavoraConNoi.ts; il
// modulo scrive su Supabase via /api/candidatura, il CV va nel bucket privato
// con l'URL firmata da /api/candidatura/upload. Dall'altra parte le legge il
// pannello, sezione Curriculum.

const ruoliTotali = AREE.reduce((n, a) => n + a.ruoli.length, 0);
---

<Layout
	title="Lavora con noi — Ronchiverdi Sport Club Torino"
	description="Ronchiverdi Sport Club cerca tecnici sportivi, istruttori, reception, commerciali, Spa, Club House e manutenzione. Nessuna posizione aperta pubblicata: manda una candidatura spontanea con il tuo curriculum."
>
	<header class="page-header">
		<p class="eyebrow">Lavora con noi</p>
		<h1>Cerchiamo persone, <em class="accent">non profili</em></h1>
		<p class="lede">
			Ronchiverdi è un club aperto sette giorni su sette, con 35.000 mq fra
			indoor e outdoor e una squadra che tiene in piedi tennis, padel, nuoto,
			fitness, triathlon e Young School. Cerchiamo persone tutto l'anno: se il
			tuo mestiere è uno di questi, raccontaci di te.
		</p>
	</header>

	<div class="lcn">
		<section class="lcn-motivi" aria-label="Perché lavorare a Ronchiverdi">
			{MOTIVI.map((m) => (
				<article class="lcn-motivo">
					<h2>{m.titolo}</h2>
					<p>{m.testo}</p>
				</article>
			))}
		</section>

		<section class="lcn-aree" id="aree">
			<div class="lcn-sezione-head">
				<h2>Le aree in cui cerchiamo</h2>
				<p class="lede">
					Non pubblichiamo un elenco di posizioni aperte: le esigenze cambiano
					con le stagioni, e una candidatura buona la teniamo comunque. Questi
					sono i {ruoliTotali} ruoli che compongono il club — scegli quello che
					ti somiglia di più.
				</p>
			</div>

			<div class="lcn-griglia">
				{AREE.map((a) => (
					<article class="lcn-area">
						<h3>{a.label}</h3>
						<p>{a.descrizione}</p>
						<ul>
							{a.ruoli.map((r) => <li>{r}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="lcn-form-sezione" id="candidati">
			<div class="lcn-sezione-head">
				<h2>Candidati</h2>
				<p class="lede">
					Il modulo richiede pochi minuti. Leggiamo tutto: se il profilo è in
					linea ti ricontattiamo, altrimenti teniamo la candidatura per quando
					si apre qualcosa di adatto.
				</p>
			</div>

			<form class="lf__form lcn-form" id="candidatura-form" novalidate>
				<div class="lf__grid">
					<div class="lf__field">
						<label for="cd-nome">Nome <span aria-hidden="true">*</span></label>
						<input id="cd-nome" name="nome" type="text" autocomplete="given-name" />
					</div>
					<div class="lf__field">
						<label for="cd-cognome">Cognome <span aria-hidden="true">*</span></label>
						<input id="cd-cognome" name="cognome" type="text" autocomplete="family-name" />
					</div>
					<div class="lf__field lf__field--full">
						<label for="cd-email">Email <span aria-hidden="true">*</span></label>
						<input id="cd-email" name="email" type="email" autocomplete="email" placeholder="nome@esempio.com" />
					</div>
					<div class="lf__field lf__field--full">
						<label for="cd-cellulare">Cellulare <span aria-hidden="true">*</span></label>
						<div class="lf__tel">
							<select id="cd-prefisso" class="lf__tel-prefisso" aria-label="Prefisso internazionale" autocomplete="tel-country-code">
								{prefissi.map((pf) => (
									<option value={pf.dial} selected={pf.dial === "+39"}>{pf.flag} {pf.dial}</option>
								))}
							</select>
							<input id="cd-cellulare" name="cellulare" type="tel" autocomplete="tel-national" placeholder="3XX XXX XXXX" />
						</div>
					</div>
					<div class="lf__field">
						<label for="cd-citta">Città <em>(facoltativo)</em></label>
						<input id="cd-citta" name="citta" type="text" autocomplete="address-level2" placeholder="Torino" />
					</div>
					<div class="lf__field">
						<label for="cd-disponibilita">Disponibilità <em>(facoltativo)</em></label>
						<select id="cd-disponibilita" name="disponibilita">
							<option value="">Da indicare</option>
							{DISPONIBILITA.map((d) => <option value={d}>{d}</option>)}
						</select>
					</div>
					<div class="lf__field lf__field--full">
						<label for="cd-area">Area per cui ti candidi <span aria-hidden="true">*</span></label>
						<select id="cd-area" name="area">
							<option value="">Scegli un'area</option>
							{AREE.map((a) => <option value={a.chiave}>{a.label}</option>)}
						</select>
					</div>
					<div class="lf__field lf__field--full">
						<label for="cd-presentazione">Parlaci di te <span aria-hidden="true">*</span></label>
						<textarea
							id="cd-presentazione"
							name="presentazione"
							rows="6"
							placeholder="Chi sei, cosa sai fare, perché ti interessa Ronchiverdi. Non serve un testo formale: quello che conta è capire con chi stiamo parlando."
						></textarea>
					</div>
					<div class="lf__field lf__field--full">
						<label for="cd-esperienza">Il tuo percorso <em>(facoltativo)</em></label>
						<textarea
							id="cd-esperienza"
							name="esperienza"
							rows="5"
							placeholder="Esperienze, qualifiche e brevetti, titoli di studio, federazioni con cui sei tesserato."
						></textarea>
					</div>

					<div class="lf__field lf__field--full">
						<label for="cd-cv">Curriculum <span aria-hidden="true">*</span></label>
						<div class="lcn-file">
							<input
								id="cd-cv"
								name="cv"
								type="file"
								accept={CV_ACCEPT}
								class="lcn-file__input"
							/>
							<label class="btn btn-outline lcn-file__btn" for="cd-cv">Scegli il file</label>
							<span class="lcn-file__nome" id="cd-cv-nome" aria-live="polite"></span>
						</div>
						<p class="lcn-nota">{CV_FORMATI_TESTO}, massimo {CV_MAX_MB} MB.</p>
					</div>
				</div>

				<div class="lf__consent">
					<label class="lf__consent-item">
						<input id="cd-privacy" name="privacy" type="checkbox" />
						<span>
							Ho letto la <a href={url("/privacy")} target="_blank">Privacy Policy</a> e acconsento
							al trattamento dei miei dati e del curriculum per la selezione del
							personale. <strong>(obbligatorio)</strong>
						</span>
					</label>
				</div>

				<p class="lf__error" id="cd-errore" hidden role="alert"></p>

				<button class="btn" type="submit" id="cd-invia">Invia la candidatura</button>
			</form>

			<div class="lcn-conferma" id="cd-conferma" hidden>
				<div class="lf__confirm-check" aria-hidden="true">
					<svg width="24" height="24" viewBox="0 0 26 26" fill="none"><path d="M4 13L10 19L22 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</div>
				<h3>Candidatura <em class="accent">ricevuta!</em></h3>
				<p class="lede" style="margin-inline:auto" id="cd-conferma-testo"></p>
			</div>
		</section>
	</div>
</Layout>

<script>
	import { initCandidaturaForm } from "../lib/candidaturaForm.client.js";
	initCandidaturaForm();
</script>

<style>
	/* Stessa intestazione delle altre pagine interne: .page-header è scoped
	   nelle singole pagine, quindi va ripetuta qui. */
	.page-header {
		max-width: 46rem;
		margin: 0 auto;
		padding: 5rem 1.5rem 1rem;
		text-align: center;
	}

	.lcn {
		max-width: 62rem;
		margin: 0 auto 5rem;
		padding: 0 1.5rem;
	}

	/* ── Perché il club ───────────────────────────────────────────────── */
	.lcn-motivi {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin-top: 2.5rem;
		padding: 1.75rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}
	.lcn-motivo h2 {
		margin: 0 0 0.5rem;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.lcn-motivo p {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--text-muted);
	}

	/* ── Aree e ruoli ─────────────────────────────────────────────────── */
	.lcn-sezione-head {
		max-width: 42rem;
		margin: 0 auto 2rem;
		text-align: center;
	}
	.lcn-sezione-head h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		letter-spacing: var(--tracking-2xl);
		line-height: var(--leading-2xl);
	}
	.lcn-sezione-head .lede {
		margin: 0;
	}

	.lcn-aree,
	.lcn-form-sezione {
		margin-top: 4rem;
		scroll-margin-top: 6rem;
	}

	.lcn-griglia {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 1rem;
	}
	.lcn-area {
		padding: 1.4rem 1.5rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		background: var(--bg);
	}
	.lcn-area h3 {
		margin: 0 0 0.5rem;
		font-size: var(--text-md);
		font-weight: 500;
	}
	.lcn-area p {
		margin: 0 0 0.9rem;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--text-muted);
	}
	.lcn-area ul {
		margin: 0;
		padding: 0.9rem 0 0;
		list-style: none;
		border-top: 1px solid var(--border);
	}
	.lcn-area li {
		position: relative;
		padding-left: 0.9rem;
		font-size: var(--text-2xs);
		line-height: 1.7;
		color: var(--text-muted);
	}
	.lcn-area li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent);
	}

	/* ── Modulo ───────────────────────────────────────────────────────── */
	.lcn-form {
		max-width: 44rem;
		margin: 0 auto;
	}

	/* L'input file di sistema non si può disegnare: si nasconde e si comanda
	   con la sua etichetta, che è già un bottone del sito. */
	.lcn-file {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex-wrap: wrap;
	}
	.lcn-file__input {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}
	.lcn-file__btn {
		cursor: pointer;
	}
	/* Il focus da tastiera vive sull'input nascosto: senza questo, chi naviga
	   in tab non vedrebbe dove si trova. */
	.lcn-file__input:focus-visible + .lcn-file__btn {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.lcn-file__nome {
		font-size: var(--text-2xs);
		color: var(--text-muted);
		word-break: break-word;
	}
	.lcn-nota {
		margin: 0.5rem 0 0;
		font-size: var(--text-2xs);
		color: var(--text-muted);
	}

	.lcn-conferma {
		max-width: 34rem;
		margin: 0 auto;
		text-align: center;
	}
	.lcn-conferma h3 {
		margin: 1rem 0 0.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-xl);
	}

	@media (max-width: 860px), (orientation: portrait) {
		.lcn-motivi {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25rem;
		}
	}
</style>
