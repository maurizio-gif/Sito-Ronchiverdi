---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import prefissi from "../../data/prefissi-telefonici";
import { url } from "../../lib/paths";

const faq = [
	{
		q: "Serve una valutazione prima di iniziare un trattamento?",
		a: "Sì, si parte sempre da una valutazione posturale approfondita, utile a costruire un percorso personalizzato in base alle esigenze di ciascuno.",
	},
	{
		q: "I trattamenti sono adatti anche a chi ha infortuni sportivi?",
		a: "Sì, massaggi terapeutici e sportivi e la rieducazione funzionale sono pensati anche per il recupero muscolare e la prevenzione degli infortuni.",
	},
	{
		q: "Cos'è il Pilates Reformer?",
		a: "È un allenamento su una macchina dedicata, il Reformer, che lavora su rinforzo muscolare e controllo posturale.",
	},
];

const services = [
	{
		title: "Valutazioni posturali e visite mediche specialistiche",
		desc: "Analisi approfondita della postura e della funzionalità corporea, per costruire un percorso personalizzato basato su dati precisi e obiettivi reali.",
	},
	{
		title: "Trattamenti osteopatici",
		desc: "Tecniche manuali mirate a migliorare la mobilità, alleviare tensioni e favorire il benessere dell'intero organismo attraverso l'equilibrio tra struttura e funzione.",
	},
	{
		title: "Massaggi terapeutici e sportivi",
		desc: "Trattamenti specifici per il recupero muscolare, la prevenzione degli infortuni e il miglioramento della performance fisica in fase attiva o post-attività.",
	},
	{
		title: "Pilates Reformer",
		desc: "Allenamento guidato su macchina Reformer per rinforzare i muscoli profondi, migliorare la postura e aumentare il controllo del corpo in modo dolce ed efficace.",
	},
	{
		title: "Panca posturale",
		desc: "Strumento innovativo per allungare, riequilibrare e rilassare la muscolatura, con esercizi guidati mirati alla correzione delle disfunzioni posturali.",
	},
	{
		title: "Rieducazione funzionale personalizzata",
		desc: "Percorsi individuali per recuperare il movimento in modo corretto ed efficiente, migliorando mobilità, coordinazione e consapevolezza motoria.",
	},
];
---

<Layout
	title="Chinesis — Ronchiverdi Sport Club"
	description="Chinesis Postural Lab: valutazioni posturali, trattamenti osteopatici, massaggi terapeutici e rieducazione funzionale a Ronchiverdi."
>
	<PageHero image="images/services/chinesis-hero.jpg" imageAlt="Chinesis Postural Lab Ronchiverdi" eyebrow="Servizi">
		<Fragment slot="title">Chinesis, <em class="accent">Postural Lab</em></Fragment>
		<Fragment slot="lede">Il nuovo spazio Ronchiverdi dedicato alla postura, al recupero funzionale e al controllo del movimento.</Fragment>
		<div class="header-cta">
			<a class="btn" href="#richiedi-informazioni">Richiedi informazioni</a>
		</div>
	</PageHero>

	<section class="intro-dark">
		<h2>Il corpo come <em class="accent accent-dark">asset</em></h2>
		<p class="lede lede-dark">
			Il corpo è il nostro strumento più potente. Lo usiamo per spingere oltre i limiti, per raggiungere obiettivi, per
			vivere lo sport in modo completo. Ma il vero controllo nasce dall'equilibrio. Chinesis Postural Lab nasce da
			questa visione: offrire a ogni persona un percorso su misura, che parta dal movimento per costruire benessere
			duraturo.
		</p>
	</section>

	<section class="intro-callout">
		<h2>Un nuovo spazio per chi chiede di più al proprio corpo</h2>
		<p class="lede" style="margin-inline:auto">
			Chinesis Postural Lab è il centro dedicato alla rieducazione del movimento, alla prevenzione e al recupero. Un
			luogo per chi vive lo sport al massimo, per chi vuole allenarsi senza compromessi, e per chi sa che la postura è
			il fondamento di ogni gesto atletico.
		</p>
	</section>

	<section class="services-intro">
		<h2>Cosa <em class="accent">troverai</em></h2>
		<p class="lede" style="margin-inline:auto">Percorsi personalizzati, risultati reali.</p>
	</section>

	<section class="services-grid">
		{services.map((s) => (
			<div class="service-item">
				<h2>{s.title}</h2>
				<p class="lede" style="margin-inline:0">{s.desc}</p>
			</div>
		))}
	</section>

	<Faq items={faq} />

	<section class="contact-section" id="richiedi-informazioni">
		<div class="contact-section__intro">
			<p class="eyebrow">Richiedi informazioni</p>
			<h2>Parliamo del tuo <em class="accent">percorso</em></h2>
			<p class="lede" style="margin-inline:auto">
				Lascia i tuoi dati: il team di Chinesis Postural Lab ti ricontatta per organizzare la tua prima valutazione.
			</p>
		</div>

		<form class="contact-form" id="chinesis-form" novalidate>
			<div class="lf__grid">
				<div class="lf__field">
					<label for="cf-nome">Nome <span aria-hidden="true">*</span></label>
					<input id="cf-nome" name="nome" type="text" autocomplete="given-name" />
				</div>
				<div class="lf__field">
					<label for="cf-cognome">Cognome <span aria-hidden="true">*</span></label>
					<input id="cf-cognome" name="cognome" type="text" autocomplete="family-name" />
				</div>
				<div class="lf__field lf__field--full">
					<label for="cf-email">Email <span aria-hidden="true">*</span></label>
					<input id="cf-email" name="email" type="email" autocomplete="email" placeholder="nome@esempio.com" />
				</div>
				<div class="lf__field lf__field--full">
					<label for="cf-cellulare">Cellulare <span aria-hidden="true">*</span></label>
					<div class="lf__tel">
						<select id="cf-prefisso" class="lf__tel-prefisso" aria-label="Prefisso internazionale" autocomplete="tel-country-code">
							{prefissi.map((pf) => (
								<option value={pf.dial} selected={pf.dial === "+39"}>{pf.flag} {pf.dial}</option>
							))}
						</select>
						<input id="cf-cellulare" name="cellulare" type="tel" autocomplete="tel-national" placeholder="3XX XXX XXXX" />
					</div>
				</div>
				<div class="lf__field lf__field--full">
					<label for="cf-messaggio">Il tuo messaggio <em>(facoltativo)</em></label>
					<textarea id="cf-messaggio" name="messaggio" rows="4" placeholder="Raccontaci cosa cerchi: postura, recupero, allenamento…"></textarea>
				</div>
			</div>

			<div class="lf__consent">
				<label class="lf__consent-item">
					<input id="cf-privacy" name="privacy" type="checkbox" />
					<span>Ho letto e accetto la <a href="/privacy" target="_blank">Privacy Policy</a>. <strong>(obbligatorio)</strong></span>
				</label>
				<label class="lf__consent-item">
					<input id="cf-marketing" name="marketing" type="checkbox" />
					<span>Acconsento a ricevere comunicazioni e novità da Ronchiverdi. <em>(facoltativo)</em></span>
				</label>
			</div>

			<p class="lf__error" id="cf-error" hidden role="alert"></p>

			<button class="btn" type="submit">Invia richiesta</button>
		</form>

		<div class="contact-form__confirm" id="cf-confirm" hidden>
			<div class="lf__confirm-check" aria-hidden="true">
				<svg width="24" height="24" viewBox="0 0 26 26" fill="none"><path d="M4 13L10 19L22 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</div>
			<h3>Richiesta <em class="accent">ricevuta!</em></h3>
			<p class="lede" style="margin-inline:auto" id="cf-confirm-text"></p>
		</div>
	</section>

	<script>
		const form = document.getElementById("chinesis-form");
		const errorEl = document.getElementById("cf-error");
		const confirmEl = document.getElementById("cf-confirm");
		const confirmText = document.getElementById("cf-confirm-text");

		function isValidEmail(v) {
			return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
		}

		function isValidPhone(v) {
			const cifre = v.replace(/[^0-9]/g, "");
			if (!/^[0-9\s-]+$/.test(v.trim())) return false;
			if (cifre.length < 6 || cifre.length > 14) return false;
			if (/^(\d)\1+$/.test(cifre)) return false;
			return true;
		}

		function showError(msg, focusEl) {
			errorEl.textContent = msg;
			errorEl.hidden = false;
			if (focusEl) focusEl.focus();
		}

		form.addEventListener("submit", (e) => {
			e.preventDefault();
			errorEl.hidden = true;

			const nome = document.getElementById("cf-nome");
			const cognome = document.getElementById("cf-cognome");
			const email = document.getElementById("cf-email");
			const cellulare = document.getElementById("cf-cellulare");
			const privacy = document.getElementById("cf-privacy");

			if (!nome.value.trim()) return showError("Inserisci il tuo nome.", nome);
			if (!cognome.value.trim()) return showError("Inserisci il tuo cognome.", cognome);
			if (!isValidEmail(email.value)) return showError("Inserisci un indirizzo email valido.", email);
			if (!isValidPhone(cellulare.value)) return showError("Inserisci un numero di cellulare valido.", cellulare);
			if (!privacy.checked) return showError("Il consenso alla Privacy Policy è obbligatorio.");

			confirmText.textContent = `Grazie ${nome.value.trim()}, ti ricontattiamo il prima possibile su ${email.value.trim()}.`;
			form.hidden = true;
			confirmEl.hidden = false;
		});
	</script>

	<style>
		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		.intro-dark {
			background: var(--bg-dark);
			color: var(--text-on-dark);
			text-align: center;
			padding: 5rem 1.5rem;
		}
		.intro-dark h2 {
			max-width: 36rem;
			margin: 0 auto 1rem;
		}
		.intro-dark .lede-dark {
			max-width: 44rem;
			margin: 0 auto;
		}

		.intro-callout {
			background: var(--bg-alt);
			text-align: center;
			padding: 5rem 1.5rem;
		}
		.intro-callout h2 {
			max-width: 40rem;
			margin: 0 auto 1rem;
		}

		.services-intro {
			text-align: center;
			padding: 4rem 1.5rem 0;
		}
		.services-intro h2 {
			margin: 0 0 0.5rem;
		}

		.services-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 2.5rem;
			max-width: 64rem;
			margin: 0 auto;
			padding: 3rem 1.5rem 5rem;
		}
		.service-item h2 {
			font-size: var(--text-lg);
			margin: 0 0 0.5rem;
		}
		@media (max-width: 640px) {
			.services-grid {
				grid-template-columns: 1fr;
				text-align: center;
			}
		}

		.contact-section {
			padding: 6rem 1.5rem;
			background: var(--bg-alt);
		}
		.contact-section__intro {
			text-align: center;
			max-width: 34rem;
			margin: 0 auto 3rem;
		}
		.contact-form {
			max-width: 40rem;
			margin: 0 auto;
			display: flex;
			flex-direction: column;
			gap: 1.4rem;
		}
		.contact-form .btn {
			align-self: center;
			border: none;
		}
		.contact-form__confirm {
			max-width: 34rem;
			margin: 0 auto;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
		}
		.contact-form__confirm .lf__confirm-check {
			background: var(--bg);
		}
		.contact-form[hidden],
		.contact-form__confirm[hidden] {
			display: none !important;
		}
	</style>
</Layout>
