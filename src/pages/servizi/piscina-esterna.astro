---
// La piscina esterna: stagione, orari, accesso e come funziona l'estate al
// club.
//
// I contenuti vengono dalla scheda informativa della segreteria. Due cose
// meritano di stare in evidenza e non in fondo a un paragrafo: il badge, senza
// il quale ai tornelli non si entra, e il maltempo, che è una regola di
// sicurezza — chi la scopre in vasca è tardi.
//
// Gli orari sono dichiarati come li dichiara il club: la balneazione ha una
// fascia, il solarium un'altra, e ad agosto la manutenzione delle vasche
// interne allarga la prima. Sono tre informazioni diverse e stanno in tre
// righe diverse, invece che in una frase che le riassume tutte male.
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import { url } from "../../lib/paths";
import { faqDiPagina } from "../../data/faq";

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.5" /><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Stagione",
		html: "Aperta indicativamente dai <strong>primi giorni di giugno al 15 settembre</strong>, compatibilmente con le condizioni meteorologiche.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" /><path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Balneazione",
		html: "Tutti i giorni dalle <strong>10:00 alle 20:00</strong>. I prati del solarium sono accessibili già <strong>dalle 9:00</strong>.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="6.5" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M7 10.5h4M7 13.5h2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><circle cx="16.5" cy="12" r="1.8" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Accesso",
		html: "Solo con il <strong>badge personale</strong>, passato ai tornelli d'ingresso: senza badge non si accede all'area piscina.",
	},
];

// Le tre fasce, ognuna con la sua ragione: la balneazione, il solarium che
// apre un'ora prima, e l'ampliamento di agosto.
const orari = [
	{
		voce: "Balneazione",
		quando: "Tutti i giorni, 10:00 – 20:00",
		nota: "Negli orari di apertura ci sono sempre corsie dedicate al nuoto libero.",
	},
	{
		voce: "Aree solarium",
		quando: "Tutti i giorni, dalle 9:00",
		nota: "I prati sono accessibili un'ora prima della balneazione.",
	},
	{
		voce: "Agosto · chiusura vasche interne",
		quando: "9:00 – 21:00",
		nota: "Durante la manutenzione ordinaria delle piscine indoor, generalmente prevista in agosto, gli orari della piscina esterna vengono ampliati.",
	},
];

const comeFunziona = [
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 17.5h16M6 17.5V9.8a1.5 1.5 0 0 1 1.5-1.5h9A1.5 1.5 0 0 1 18 9.8v7.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M12 8.3V4.5M9 6h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		title: "Lettini e ombrelloni",
		desc: "Non serve prenotare: si usano in base alla disponibilità, senza liste e senza posti assegnati.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2.5 14.5c1.2 0 1.2 1 2.4 1s1.2-1 2.4-1 1.2 1 2.4 1 1.2-1 2.4-1 1.2 1 2.4 1 1.2-1 2.4-1 1.2 1 2.4 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><circle cx="15.5" cy="7" r="1.8" stroke="currentColor" stroke-width="1.5" /><path d="M4 11.5l4-2 3 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		title: "Nuoto libero",
		desc: "Per tutta la durata dell'apertura restano disponibili corsie riservate a chi vuole nuotare, senza prenotazione.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 5.5h16v13H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M4 9.5h16M8.5 9.5v9M15.5 9.5v9" stroke="currentColor" stroke-width="1.5" /></svg>`,
		title: "Le attività si spostano fuori",
		desc: "Nel periodo di apertura, tutte le attività del palinsesto piscina si svolgono nelle vasche esterne e non nelle piscine indoor.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 4.5h9a3.5 3.5 0 0 1 0 7h-9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M6 11.5v3.5a4 4 0 0 0 4 4h1a4 4 0 0 0 4-4v-3.5M4.5 21.5h13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		title: "Bar estivo",
		desc: "Durante l'apertura della piscina è attivo il bar estivo. Gli orari del servizio possono variare nel corso della stagione: conviene consultare quelli aggiornati in reception.",
	},
];

const faq = faqDiPagina("piscina-esterna");
---

<Layout
	title="Piscina Esterna — Ronchiverdi Sport Club"
	description="La piscina esterna di Ronchiverdi: stagione, orari di balneazione, accesso col badge, nuoto libero, solarium e bar estivo."
	image="og/piscina-esterna.jpg"
>
	<PageHero image="images/services/piscina-esterna-hero.jpg" imageAlt="Piscina esterna Ronchiverdi" eyebrow="Servizi">
		<Fragment slot="title">Piscina <em class="accent">Esterna</em></Fragment>
		<Fragment slot="lede">Una piscina scoperta immersa nel verde del club, il punto di ritrovo dell'estate: corsie per il nuoto libero, le attività del palinsesto all'aperto e un ampio solarium sui prati.</Fragment>
		<p class="dates-banner">Apertura: <strong>inizio giugno</strong> — <strong>15 settembre</strong>, compatibilmente col meteo</p>
	</PageHero>

	<IconFacts
		eyebrow="In breve"
		title="L'estate all'aperto"
		lede="Quando è aperta, in che orari si nuota e cosa serve per entrare."
		items={facts}
	/>

	<section class="orari">
		<div class="orari__head">
			<span class="eyebrow">Orari</span>
			<h2>Quando si nuota</h2>
			<p class="lede" style="margin-inline:auto">
				La balneazione ha la sua fascia, i prati aprono un'ora prima, e ad
				agosto la manutenzione delle vasche interne allarga la giornata.
			</p>
		</div>
		<dl class="orari-lista">
			{orari.map((o) => (
				<div class="orari-riga">
					<dt>
						<span class="orari-riga__voce">{o.voce}</span>
						<span class="orari-riga__quando">{o.quando}</span>
					</dt>
					<dd>{o.nota}</dd>
				</div>
			))}
		</dl>
	</section>

	<section class="funziona">
		<div class="funziona__head">
			<span class="eyebrow">Come funziona</span>
			<h2>Una giornata in piscina</h2>
		</div>
		<div class="funziona-grid">
			{comeFunziona.map((c) => (
				<article class="funziona-card">
					<span class="funziona-card__icon" aria-hidden="true" set:html={c.icon} />
					<h3>{c.title}</h3>
					<p>{c.desc}</p>
				</article>
			))}
		</div>
	</section>

	{/* L'unica immagine che racconta la piscina di sera, col bar e il solarium
	    in funzione: sta a tutta larghezza perché è una veduta d'insieme, e
	    dentro una colonna di testo non si leggerebbe. Il ritaglio è largo sul
	    desktop e si alza verso il telefono, dove una striscia mostrerebbe
	    troppo poco. */}
	<figure class="notturna">
		<img
			src={url("images/club/notturna.jpg")}
			alt="La piscina esterna di Ronchiverdi illuminata di sera, vista dall'alto, con il solarium e l'area bar"
			loading="lazy"
		/>
		<figcaption>
			D'estate la piscina è anche il punto di ritrovo della sera: la vasca
			grande, i prati del solarium e il bar estivo.
		</figcaption>
	</figure>

	{/* Il maltempo è una regola di sicurezza, non un dettaglio di servizio:
	    sta in un blocco suo perché chi la legge deve sapere in anticipo cosa
	    succede, non scoprirlo mentre lo fanno uscire dall'acqua. */}
	<section class="maltempo">
		<div class="maltempo__box">
			<span class="maltempo__icon" aria-hidden="true">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M6.5 14.5a4 4 0 0 1 .3-8 5.5 5.5 0 0 1 10.5 1.6 3.5 3.5 0 0 1-.6 6.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M12.5 11.5l-2.5 4.5h3l-1.5 4 4-6h-3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</span>
			<div class="maltempo__testi">
				<h2>In caso di maltempo</h2>
				<p>
					Con condizioni meteorologiche avverse la piscina esterna resta
					<strong> chiusa</strong>.
				</p>
				<p>
					Se un temporale arriva all'improvviso, per ragioni di sicurezza il
					personale in servizio fa uscire i bagnanti dall'acqua e allontanare
					dal piano vasca. Sono indicazioni da seguire subito, senza attendere
					che il temporale si avvicini.
				</p>
			</div>
		</div>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vieni a scoprire il club</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un <strong>tour gratuito</strong> e scopri gli spazi all'aperto.
		</p>
		<button type="button" class="btn" data-open-contact data-interest="club-adulti">Prenota un tour</button>
		<p class="regolamento">
			In piscina valgono i regolamenti esposti all'ingresso e le indicazioni del
			personale in servizio: tutti gli utenti sono tenuti a rispettarli.
		</p>
	</section>

	<style>
		.dates-banner {
			display: inline-block;
			margin: 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text);
			background: var(--accent-tint);
			border: 1px solid var(--border-strong);
			border-radius: 999px;
			padding: 0.5rem 1.2rem;
		}

		/* ── Gli orari ──────────────────────────────────────────────────── */
		/* Tre righe, ognuna con la fascia a sinistra e la ragione a destra:
		   la fascia si legge da sola, la nota spiega perché è così. */
		.orari {
			max-width: 72rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 1rem;
		}
		.orari__head {
			max-width: 42rem;
			margin: 0 auto 2.5rem;
			text-align: center;
		}
		.orari-lista {
			margin: 0;
			max-width: 60rem;
			margin-inline: auto;
		}
		.orari-riga {
			display: grid;
			grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
			gap: 1.5rem;
			align-items: baseline;
			padding: 1.4rem 0;
			border-bottom: 1px solid var(--border);
		}
		.orari-riga:first-child {
			border-top: 1px solid var(--border);
		}
		.orari-riga dt {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}
		.orari-riga__voce {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.orari-riga__quando {
			font-family: var(--font-serif);
			font-size: var(--text-lg);
			line-height: 1.2;
			color: var(--text);
		}
		.orari-riga dd {
			margin: 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			line-height: 1.65;
			color: var(--text-muted);
		}

		/* ── Come funziona ──────────────────────────────────────────────── */
		.funziona {
			max-width: 80rem;
			margin: 0 auto;
			padding: 4.5rem 1.5rem 1rem;
		}
		.funziona__head {
			max-width: 42rem;
			margin: 0 auto 2.5rem;
			text-align: center;
		}
		.funziona-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
		}
		.funziona-card {
			background: var(--bg-alt);
			border: 1px solid var(--border);
			border-radius: 16px;
			padding: 1.75rem 1.5rem 1.9rem;
		}
		.funziona-card__icon {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.6rem;
			height: 2.6rem;
			margin-bottom: 1rem;
			border-radius: 50%;
			background: var(--accent-tint);
			color: var(--accent);
		}
		.funziona-card h3 {
			margin: 0 0 0.6rem;
			font-size: var(--text-md);
		}
		.funziona-card p {
			margin: 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.65;
		}

		/* ── La notturna ────────────────────────────────────────────────── */
		.notturna {
			margin: 4.5rem 0 0;
		}
		.notturna img {
			display: block;
			width: 100%;
			aspect-ratio: 21 / 9;
			object-fit: cover;
			/* Il soggetto sta al centro-basso: il cielo notturno in alto non
			   aggiunge niente, quindi il ritaglio scende un po'. */
			object-position: center 58%;
		}
		.notturna figcaption {
			max-width: 42rem;
			margin: 1.1rem auto 0;
			padding-inline: 1.5rem;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			line-height: 1.7;
			color: var(--text-muted);
			text-align: center;
		}

		/* ── Il maltempo ────────────────────────────────────────────────── */
		.maltempo {
			max-width: 72rem;
			margin: 0 auto;
			padding: 4rem 1.5rem 5rem;
		}
		.maltempo__box {
			display: flex;
			gap: 1.5rem;
			max-width: 56rem;
			margin: 0 auto;
			padding: 2rem 2.25rem 2.25rem;
			border: 1px solid var(--border-strong);
			border-radius: 16px;
			background: var(--accent-tint);
		}
		.maltempo__icon {
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 3rem;
			height: 3rem;
			border-radius: 50%;
			background: var(--bg);
			color: var(--accent);
		}
		.maltempo__testi h2 {
			margin: 0.2rem 0 0.9rem;
			font-size: var(--text-xl);
			line-height: var(--leading-lg);
		}
		.maltempo__testi p {
			margin: 0 0 0.8rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			line-height: 1.7;
			color: var(--text);
		}
		.maltempo__testi p:last-child {
			margin-bottom: 0;
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
		.regolamento {
			max-width: 42rem;
			margin: 2.5rem auto 0;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			line-height: 1.7;
			color: var(--text-muted);
		}

		@media (max-width: 1040px), (orientation: portrait) {
			.funziona-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 900px) {
			.notturna img {
				aspect-ratio: 16 / 9;
			}
		}
		@media (max-width: 700px), (orientation: portrait) {
			.notturna img {
				aspect-ratio: 4 / 3;
			}
			.orari-riga {
				grid-template-columns: minmax(0, 1fr);
				gap: 0.5rem;
			}
			.maltempo__box {
				flex-direction: column;
				gap: 1rem;
				padding: 1.6rem 1.5rem 1.75rem;
			}
		}
		@media (max-width: 620px) {
			.funziona-grid {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
</Layout>
