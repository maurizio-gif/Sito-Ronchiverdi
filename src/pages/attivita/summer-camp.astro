---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import { url } from "../../lib/paths";

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="16" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M3.5 9.5h17M8 3v3.5M16 3v3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Quando",
		html: "Due periodi in estate, indicativamente da metà giugno a inizio agosto e da fine agosto a metà settembre, dalle <strong>8:00 alle 18:30</strong>. <em>Date precise in fase di conferma per la prossima stagione.</em>",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.5" /><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><circle cx="17.5" cy="7.5" r="2.3" stroke="currentColor" stroke-width="1.5" /><path d="M15 14.3c.5-.15 1-.2 1.6-.2 2.8 0 5 2 5 5.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Età",
		html: "Bambini e ragazzi dai <strong>3 ai 12 anni</strong>, in gruppi organizzati per fascia d'età.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 3v7a2 2 0 0 0 2 2v9M6 3v6M8 3v6M6 9h2M16 3c-1.7 0-3 2.2-3 5s1.3 5 3 5v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Pasti",
		html: "Pranzo e merenda <strong>ogni giorno</strong>, preparati dal Ristorante Elements del Club.",
	},
];

const pilastri = [
	{
		icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" /><path d="M12 3c2.2 2.4 3.3 5.7 3.3 9s-1.1 6.6-3.3 9M12 3c-2.2 2.4-3.3 5.7-3.3 9s1.1 6.6 3.3 9M3.5 9.5h17M3.5 14.5h17" stroke="currentColor" stroke-width="1.3" /></svg>`,
		title: "Sport",
		desc: "Attività motorie e sportive guidate, pensate per stimolare coordinazione, spirito di squadra e fiducia in sé stessi, in un ambiente sicuro e motivante: nuoto, tennis, padel, triathlon, calcio.",
	},
	{
		icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="13" y="10" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="8.5" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /></svg>`,
		title: "Laboratori LEGO® Bricks4Kidz®",
		desc: "Per i più piccoli, i mattoncini LEGO® Duplo diventano strumenti di esplorazione, semplici da usare ma ricchi di potenziale educativo. Per i più grandi il laboratorio evolve: con i Project Kit, i ragazzi costruiscono modelli motorizzati, collegando teoria e pratica in modo dinamico.",
	},
	{
		icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" /><path d="M3 12h18M12 3c2.2 2.4 3.3 5.7 3.3 9s-1.1 6.6-3.3 9c-2.2-2.4-3.3-5.7-3.3-9s1.1-6.6 3.3-9Z" stroke="currentColor" stroke-width="1.3" /></svg>`,
		title: "Laboratori di lingue con The One School",
		desc: "Un primo avvicinamento a inglese, francese e spagnolo, in modo esperienziale e a misura di età: flashcard, story telling, giochi a tema e piccoli dialoghi, con insegnanti madrelingua selezionati.",
	},
];

const faq = [
	{
		q: "L'iscrizione è riservata ai soci del Club?",
		a: "No: il Summer Camp è aperto sia ai soci sia a chi non è ancora iscritto al Club, con condizioni diverse tra le due opzioni. Scrivici per conoscere prezzi, settimane disponibili e come completare l'iscrizione.",
	},
	{
		q: "Come si struttura una settimana tipo?",
		a: "Il lunedì si parte per una nuova destinazione della macchina del tempo; da martedì a giovedì si susseguono attività a tema, sport e laboratori; il venerdì si chiude con spettacolo finale e premiazioni.",
	},
	{
		q: "È previsto un potenziamento della lingua inglese?",
		a: "Sì: durante le settimane di Summer Camp è possibile arricchire l'esperienza con un percorso di potenziamento della lingua inglese, con attività svolte durante le ore al camp e guidate da docenti madrelingua.",
	},
	{
		q: "Cosa serve portare ogni giorno?",
		a: "Costume e telo da bagno, un cambio completo, crema solare e cappellino: il resto — materiale sportivo e dei laboratori — è già a disposizione al Club.",
	},
];
---

<Layout
	title="Summer Camp — Ronchiverdi Sport Club"
	description="Il Summer Camp Ronchiverdi: sport, laboratori LEGO Bricks4Kidz e lingue con The One School, per bambini dai 3 ai 12 anni."
>
	<PageHero image="images/young-school-teaser.jpg" imageAlt="Bambini del Summer Camp Ronchiverdi" eyebrow="Young School">
		<Fragment slot="title">Summer Camp, <em class="accent">un'estate da vivere</em></Fragment>
		<Fragment slot="lede">
			Sport, laboratori e nuove amicizie per tutta l'estate: ogni settimana i bambini partono per una destinazione diversa, tra avventure, scoperte e giochi di squadra.
		</Fragment>
		<Fragment slot="stat">
			<strong>3–12</strong>
			<span>Anni, dai più piccoli ai più grandi</span>
		</Fragment>
		<div class="header-cta">
			<button type="button" class="btn" data-open-contact data-interest="summer-camp">Contattaci</button>
		</div>
	</PageHero>

	<IconFacts eyebrow="Come funziona" title="Tutto quello che ti serve sapere" items={facts} />

	<section class="pilastri">
		<div class="pilastri__head">
			<span class="eyebrow">Cosa include</span>
			<h2>Sport, LEGO® e lingue, ogni giorno</h2>
			<p class="lede" style="margin-inline:auto">
				Tre anime che si intrecciano nella stessa giornata: il movimento dello sport, la costruzione dei laboratori LEGO®, la scoperta di una lingua nuova.
			</p>
		</div>
		<div class="pilastri-grid">
			{pilastri.map((p) => (
				<article class="pilastro-card">
					<span class="pilastro-card__icon" aria-hidden="true" set:html={p.icon} />
					<h3>{p.title}</h3>
					<p>{p.desc}</p>
				</article>
			))}
		</div>
	</section>

	<section class="viaggio">
		<div class="viaggio__content">
			<span class="eyebrow eyebrow-dark">Il filo conduttore</span>
			<h2>Il grande viaggio nel tempo e nello spazio</h2>
			<p class="lede lede-dark" style="margin-inline:0">
				Un'estate che è molto più di un camp: è un viaggio. Ogni settimana i bambini attivano una speciale macchina del tempo per esplorare epoche e mondi diversi — dalla Preistoria allo spazio — tra avventure, scoperte e nuove amicizie. Sport, gioco e creatività si intrecciano ogni giorno in attività pensate per farli muovere, divertire e immaginare.
			</p>
		</div>
		<ul class="viaggio-ritmo">
			<li>
				<span class="viaggio-ritmo__day">Lunedì</span>
				<span>Si parte per una nuova destinazione della macchina del tempo</span>
			</li>
			<li>
				<span class="viaggio-ritmo__day">Mar–Gio</span>
				<span>Attività a tema, sport e laboratori si susseguono ogni giorno</span>
			</li>
			<li>
				<span class="viaggio-ritmo__day">Venerdì</span>
				<span>Spettacolo finale e premiazioni, per festeggiare ogni traguardo</span>
			</li>
		</ul>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Prenota il posto di tuo figlio</h2>
		<p class="lede" style="margin-inline:auto">
			Scrivici per conoscere le settimane disponibili, i prezzi soci e non soci e come completare l'iscrizione.
		</p>
		<div class="final-cta__buttons">
			<button type="button" class="btn" data-open-contact data-interest="summer-camp">Contattaci</button>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="summer-camp">Richiedi maggiori informazioni</button>
		</div>
	</section>

	<style>
		.header-cta {
			margin-top: 0;
		}

		.pilastri {
			max-width: 84rem;
			margin: 0 auto;
			padding: 5.5rem 1.5rem;
		}
		.pilastri__head {
			text-align: center;
			max-width: 40rem;
			margin: 0 auto 3rem;
		}
		.pilastri-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.75rem;
		}
		.pilastro-card {
			border: 1px solid var(--border);
			border-radius: 16px;
			background: var(--bg-alt);
			padding: 2rem 1.75rem;
		}
		.pilastro-card__icon {
			display: flex;
			color: var(--accent);
			margin-bottom: 1rem;
		}
		.pilastro-card h3 {
			font-size: var(--text-lg);
			margin: 0 0 0.6rem;
		}
		.pilastro-card p {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.65;
			margin: 0;
		}
		@media (max-width: 960px) {
			.pilastri-grid {
				grid-template-columns: 1fr;
			}
		}

		.viaggio {
			background: var(--bg-dark);
			color: var(--text-on-dark);
			display: grid;
			grid-template-columns: 1.2fr 1fr;
			gap: 3rem;
			align-items: center;
			padding: 5.5rem 1.5rem;
		}
		.viaggio__content {
			max-width: 34rem;
		}
		.viaggio__content h2 {
			color: var(--text-on-dark);
			margin: 0.4rem 0 1.1rem;
		}
		.viaggio-ritmo {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 1.1rem;
			max-width: 26rem;
			margin-inline: auto;
		}
		.viaggio-ritmo li {
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
			padding: 1.1rem 1.3rem;
			border: 1px solid var(--border-dark);
			border-radius: 12px;
		}
		.viaggio-ritmo__day {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--accent-on-dark);
		}
		.viaggio-ritmo li span:last-child {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-on-dark);
			opacity: 0.85;
			line-height: 1.5;
		}
		@media (max-width: 860px) {
			.viaggio {
				grid-template-columns: 1fr;
				text-align: center;
			}
			.viaggio__content {
				margin-inline: auto;
			}
			.viaggio__content .lede-dark {
				margin-inline: auto;
			}
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
		.final-cta__buttons {
			display: flex;
			gap: 1rem;
			justify-content: center;
			flex-wrap: wrap;
		}
	</style>
</Layout>
