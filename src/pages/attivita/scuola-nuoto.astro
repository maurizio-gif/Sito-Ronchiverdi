---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import { url } from "../../lib/paths";

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 18h3v-4H3v4Zm7.5 0h3V9h-3v9ZM18 18h3V4h-3v14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Piscine",
		html: "<strong>Quattro piscine</strong> coperte e scoperte, pensate per ogni fascia d'età.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Età",
		html: "Un percorso continuo dai <strong>3 mesi ai 14 anni</strong>, dall'acquaticità al perfezionamento tecnico pre-agonistico.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" /><path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Esperienza",
		html: "<strong>Oltre trent'anni</strong> al fianco di bambini e ragazzi, con istruttori qualificati.",
	},
];

const programs = [
	{
		ageLabel: "3–18 mesi · 19–36 mesi",
		title: "Acquaticità Neonatale e Avanzata",
		percorso: "Percorso in acqua accompagnato da un genitore, che entra in vasca insieme al bambino: è l'unico corso in cui è previsto.",
		obiettivi: ["Sviluppo psicomotorio precoce", "Ambientamento acquatico", "Gestione della respirazione e del galleggiamento"],
		durata: "40 minuti",
		vasca: "Vasca di ambientamento · 32°C",
		image: "images/attivita/scuola-nuoto-hero.jpg",
	},
	{
		ageLabel: "3–5 anni",
		title: "Baby",
		percorso: "Corsi mirati all'autonomia acquatica e alla scoperta ludica dei movimenti base, per introdurre in forma ludica i primi elementi dei quattro stili.",
		obiettivi: ["Autonomia acquatica", "Scoperta ludica dei movimenti base", "Primi elementi dei quattro stili"],
		durata: "40 minuti",
		vasca: "Vasca di ambientamento · 32°C",
		image: "images/activities/scuola-nuoto-young.jpg",
	},
	{
		ageLabel: "5–8 anni",
		title: "Open",
		percorso: "Corsi strutturati in livelli (1 e 2) per consolidare le capacità natatorie e proseguire nell'apprendimento tecnico dei quattro stili.",
		obiettivi: ["Livello 1 e Livello 2", "Consolidamento delle capacità natatorie", "Apprendimento tecnico dei quattro stili"],
		durata: "40 minuti",
		vasca: "Vasca grande 25 m · 28°C",
		image: "images/activities/nuoto.jpg",
	},
	{
		ageLabel: "8–14 anni",
		title: "Propaganda",
		percorso: "Corso avanzato con obiettivi tecnici specifici, per chi vuole affinare la tecnica e avvicinarsi al mondo agonistico.",
		obiettivi: ["Perfezionamento dei quattro stili", "Esercitazioni su partenze e tecniche di gara", "Introduzione alla preparazione pre-agonistica"],
		durata: "60 minuti",
		vasca: "Vasca grande 25 m · 28°C",
		image: "images/activities/scuola-nuoto-adulti.jpg",
	},
];

const famiglie = [
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 21V8.5l7-4.5 7 4.5V21" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M3 21h18M10 21v-4.5h4V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		title: "Assistenza spogliatoio",
		desc: "Il nostro personale si occupa dei bambini all'arrivo e al termine della lezione, accompagnandoli nelle operazioni di cambio. Per questo i genitori non accedono agli spogliatoi.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3 3 9.5h18L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M5 9.5V21M19 9.5V21M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		title: "Dove aspettare",
		desc: "I genitori possono seguire la lezione dall'esterno, dal gazebo dedicato. Per motivi organizzativi e di sicurezza non è previsto l'accesso al bordo vasca.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" /><path d="M9.5 16.5v-9h3a2.5 2.5 0 0 1 0 5h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		title: "Parcheggio gratuito",
		desc: "Il club dispone di un parcheggio gratuito a disposizione delle famiglie: si arriva, si accompagna il bambino e si aspetta senza pensieri.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 3.5h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" /><path d="M12 8.5v6M9 11.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		title: "Certificato medico",
		desc: "È obbligatorio per i bambini sopra i 6 anni e si carica sul portale in fase di iscrizione, insieme al regolamento firmato.",
	},
];

const corredo = [
	{
		title: "Corsi Baby, Open e Propaganda",
		items: ["Cuffia", "Costume", "Accappatoio", "Ciabatte", "Occhialini (facoltativi per i più piccoli)"],
	},
	{
		title: "Acquaticità neonatale · 3–36 mesi",
		items: ["Pannolino swimming (obbligatorio)", "Costume contenitivo (obbligatorio)", "Accappatoio", "Ciabatte"],
	},
];

const sospensioni = [
	{ nome: "Ponte dell'Immacolata", periodo: "da lunedì 7 a martedì 8 dicembre 2026" },
	{ nome: "Vacanze di Natale", periodo: "da mercoledì 23 dicembre 2026 a mercoledì 6 gennaio 2027" },
	{ nome: "Vacanze di Carnevale", periodo: "da sabato 6 a mercoledì 10 febbraio 2027" },
	{ nome: "Vacanze di Pasqua", periodo: "da giovedì 25 a martedì 30 marzo 2027" },
	{ nome: "Festa dei Lavoratori", periodo: "sabato 1° maggio 2027" },
	{ nome: "Festa della Repubblica", periodo: "mercoledì 2 giugno 2027" },
];

const faq = [
	{
		q: "Come posso iscrivere mio figlio?",
		html: `<p>Le iscrizioni ai corsi della Young School Nuoto Ronchiverdi si effettuano esclusivamente online attraverso il nostro sito. Dal sito è possibile consultare le disponibilità, scegliere il corso più adatto e completare la procedura di iscrizione. Trovi tutti i passaggi nella pagina <a href="${url("/attivita/scuola-nuoto/iscrizione")}">modalità di iscrizione</a>.</p>`,
	},
	{
		q: "Quanto durano le lezioni?",
		a: "Le lezioni di Acquaticità, Baby e Open durano 40 minuti. Le lezioni del corso Propaganda durano 60 minuti.",
	},
	{
		q: "È possibile fare una prova gratuita?",
		html: `<p>Sì, è possibile effettuare una prova gratuita, previa disponibilità dei posti e organizzazione con la scuola nuoto. <button type="button" class="faq-inline-btn" data-open-contact data-interest="scuola-nuoto">Scrivici per prenotarla</button>.</p>`,
	},
	{
		q: "I corsi sono divisi per età e livello?",
		a: "Sì. I gruppi vengono organizzati tenendo conto sia dell'età sia del livello dei bambini, per rendere il percorso più omogeneo, sicuro ed efficace.",
	},
	{
		q: "Dove si svolgono i corsi?",
		a: "I corsi di Acquaticità e Baby si svolgono nella vasca di ambientamento, con acqua a circa 32°C. I corsi Open e Propaganda si svolgono nella vasca grande da 25 metri, con acqua a circa 28°C.",
	},
	{
		q: "Cosa devo portare per mio figlio/a per svolgere la lezione di nuoto?",
		html: `<p>Per i corsi Baby, Open e Propaganda sono necessari cuffia, costume, accappatoio e ciabatte; gli occhialini sono facoltativi per i bambini più piccoli.</p><p>Per il corso di Acquaticità neonatale, dai 3 ai 36 mesi, sono obbligatori il pannolino swimming e il costume contenitivo.</p>`,
	},
	{
		q: "Il corso di acquaticità prevede l'ingresso in acqua con il proprio figlio/a?",
		a: "Sì. Solo per il corso di acquaticità è previsto l'ingresso in acqua insieme al bambino.",
	},
	{
		q: "I genitori possono assistere alla lezione?",
		a: "Sì. I genitori possono seguire la lezione dall'esterno, dal gazebo dedicato. Per motivi organizzativi e di sicurezza non è previsto l'accesso al bordo vasca.",
	},
	{
		q: "I genitori possono entrare negli spogliatoi?",
		a: "No. Ronchiverdi offre un servizio di assistenza spogliatoio: il nostro personale si occupa dei bambini sia all'arrivo sia al termine della lezione, accompagnandoli nelle operazioni di cambio.",
	},
	{
		q: "È obbligatorio il certificato medico?",
		a: "Il certificato medico è obbligatorio per i bambini sopra i 6 anni.",
	},
	{
		q: "È possibile recuperare le lezioni perse?",
		html: `<p>Sì. I recuperi vanno concordati direttamente con la scuola nuoto e sono soggetti alla disponibilità dei gruppi. Sono previsti fino a 2 recuperi per i corsi quadrimestrali e fino a 4 recuperi per i corsi stagionali. <button type="button" class="faq-inline-btn" data-open-contact data-interest="scuola-nuoto">Contattaci per concordare il recupero</button>.</p>`,
	},
	{
		q: "È disponibile un parcheggio?",
		a: "Sì. Ronchiverdi dispone di un parcheggio gratuito a disposizione delle famiglie.",
	},
	{
		q: "Primo giorno di corso",
		a: "Si consiglia di arrivare con 20 minuti di anticipo rispetto all'orario di inizio della lezione.",
	},
	{
		q: "Festività e sospensioni",
		html: `<ul class="faq-sospensioni">${sospensioni.map((s) => `<li><strong>${s.nome}:</strong> ${s.periodo}</li>`).join("")}</ul>`,
	},
	{
		q: "Come posso ricevere maggiori informazioni?",
		html: `<p>Per informazioni su corsi, orari, disponibilità, prove gratuite, recuperi e modalità di iscrizione <button type="button" class="faq-inline-btn" data-open-contact data-interest="scuola-nuoto">compila il form di contatto</button>: ti risponde lo staff della Young School Nuoto.</p>`,
	},
];
---

<Layout
	title="Scuola Nuoto — Ronchiverdi Sport Club"
	description="Scuola Nuoto Ronchiverdi: corsi per bambini dai 3 mesi ai 14 anni suddivisi per fascia d'età, e lezioni individuali di nuoto per adulti."
>
	<PageHero image="images/attivita/scuola-nuoto-hero.jpg" imageAlt="Piscina interna Ronchiverdi" eyebrow="Attività sportive">
		<Fragment slot="title">Scuola Nuoto, per <em class="accent">tutte le età</em></Fragment>
		<Fragment slot="lede">Corsi in acqua pensati per ogni fase di crescita, dai primi mesi di vita fino all'adolescenza, e lezioni individuali per gli adulti.</Fragment>
		<p class="dates-banner">Inizio corsi: <strong>21 settembre 2026</strong> — Fine corsi: <strong>5 giugno 2027</strong></p>
	</PageHero>

	<IconFacts
		eyebrow="Chi siamo"
		title="L'acqua come primo passo"
		lede="Da oltre trent'anni accompagnamo bambini e ragazzi in acqua, con un metodo che rispetta i tempi di ciascuno: dall'acquaticità dei primi mesi di vita fino al perfezionamento tecnico pre-agonistico."
		items={facts}
	/>

	<section class="programs">
		<div class="programs__head">
			<span class="eyebrow">Bambini e ragazzi</span>
			<h2>Un percorso per ogni età</h2>
		</div>

		<div class="program-cards">
			{programs.map((p) => (
				<article class="program-card">
					<div class="program-card__media">
						<img src={url(p.image)} alt={p.title} loading="lazy" />
						<span class="program-card__age">
							<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 8.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 14a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
							{p.ageLabel}
						</span>
					</div>
					<div class="program-card__content">
						<h3>{p.title}</h3>
						<p class="program-card__percorso">{p.percorso}</p>
						<ul class="program-card__obiettivi">
							{p.obiettivi.map((o) => (
								<li>
									<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									<span>{o}</span>
								</li>
							))}
						</ul>
						<div class="program-card__tags">
							<span class="program-card__tag">
								<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.3" stroke="currentColor" stroke-width="1.4" /><path d="M8 4.6V8l2.4 1.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
								{p.durata}
							</span>
							<span class="program-card__tag">
								<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1.5 11.5c1 0 1 .9 2 .9s1-.9 2-.9 1 .9 2 .9 1-.9 2-.9 1 .9 2 .9 1-.9 2-.9M1.5 8.5c1 0 1 .9 2 .9s1-.9 2-.9 1 .9 2 .9 1-.9 2-.9 1 .9 2 .9 1-.9 2-.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /><path d="M4.5 9V3.8a1.5 1.5 0 0 1 3 0M8.5 9V3.8a1.5 1.5 0 0 1 3 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
								{p.vasca}
							</span>
						</div>
						<div class="program-card__cta">
							<a class="btn" href={url("/attivita/scuola-nuoto/iscrizione")}>Modalità di iscrizione</a>
							<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="famiglie">
		<div class="famiglie__head">
			<span class="eyebrow">Per le famiglie</span>
			<h2>Come funziona una lezione</h2>
			<p class="lede" style="margin-inline:auto">
				Dall'arrivo al momento del cambio, tutto quello che serve sapere per accompagnare il bambino senza pensieri.
			</p>
		</div>
		<div class="famiglie-grid">
			{famiglie.map((f) => (
				<article class="famiglia-card">
					<span class="famiglia-card__icon" aria-hidden="true" set:html={f.icon} />
					<h3>{f.title}</h3>
					<p>{f.desc}</p>
				</article>
			))}
		</div>

		<div class="corredo">
			<h3 class="corredo__title">Cosa mettere in borsa</h3>
			<div class="corredo-grid">
				{corredo.map((c) => (
					<div class="corredo-card">
						<span class="corredo-card__label">{c.title}</span>
						<ul>
							{c.items.map((i) => (
								<li>
									<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									<span>{i}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>

		<div class="famiglie__cta">
			<p class="famiglie__note">
				Vuoi provare prima di iscriverti? La <strong>prova gratuita</strong> è possibile previa disponibilità dei posti: scrivici e organizziamo insieme il giorno.
			</p>
			<div class="famiglie__buttons">
				<a class="btn" href={url("/attivita/scuola-nuoto/iscrizione")}>Modalità di iscrizione</a>
				<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
			</div>
		</div>
	</section>

	<section class="adults">
		<span class="eyebrow">Adulti</span>
		<h2>Lezioni individuali di nuoto</h2>
		<p class="lede" style="margin-inline:auto">
			Non esiste una scuola nuoto strutturata per adulti: chi desidera lezioni di nuoto acquista un <strong>carnet da 5 lezioni</strong> in reception e si organizza direttamente con l'istruttore di riferimento in base ai propri obiettivi. Ogni lezione dura <strong>40 o 60 minuti</strong>, a seconda del carnet scelto.
		</p>
		<button type="button" class="btn btn-outline" data-open-contact data-interest="club-adulti">Contattaci</button>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Pronto a iscrivere il tuo bambino?</h2>
		<p class="lede" style="margin-inline:auto">
			Le iscrizioni si effettuano <strong>esclusivamente online</strong>: dal portale consulti le disponibilità, scegli il corso e completi la procedura. Se hai dubbi contattaci, ti aiutiamo a scegliere il percorso più adatto.
		</p>
		<div class="final-cta__buttons">
			<a class="btn" href={url("/attivita/scuola-nuoto/iscrizione")}>Modalità di iscrizione</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">Richiedi maggiori informazioni</button>
		</div>
	</section>

	<style>
		.dates-banner {
			display: inline-block;
			margin: 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text);
			background: var(--accent-tint);
			border: 1px solid var(--border-strong);
			border-radius: 999px;
			padding: 0.5rem 1.2rem;
		}

		.programs {
			max-width: 78rem;
			margin: 0 auto;
			padding: 4.5rem 1.5rem 2rem;
		}
		.programs__head {
			text-align: center;
			max-width: 40rem;
			margin: 0 auto;
		}
		.program-cards {
			margin-top: 2.5rem;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem;
		}
		.program-card {
			display: flex;
			flex-direction: column;
			text-align: left;
			border: 1px solid var(--border);
			border-radius: 16px;
			overflow: hidden;
			background: var(--bg-alt);
			transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.program-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 16px 32px -12px rgba(28, 28, 24, 0.25);
		}
		.program-card__media {
			position: relative;
			aspect-ratio: 16 / 9;
		}
		.program-card__media img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.5s ease;
		}
		.program-card:hover .program-card__media img {
			transform: scale(1.06);
		}
		.program-card__age {
			position: absolute;
			top: 0.8rem;
			left: 0.8rem;
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.03em;
			color: var(--text);
			background: rgba(246, 239, 222, 0.92);
			border-radius: 999px;
			padding: 0.3rem 0.7rem;
			backdrop-filter: blur(4px);
		}
		.program-card__age svg {
			color: var(--accent);
		}
		.program-card__content {
			display: flex;
			flex-direction: column;
			flex: 1;
			min-width: 0;
			padding: 1.4rem 1.5rem 1.5rem;
		}
		.program-card__content h3 {
			margin: 0 0 0.5rem;
			font-size: var(--text-lg);
		}
		.program-card__percorso {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.55;
			margin: 0 0 0.9rem;
		}
		.program-card__obiettivi {
			list-style: none;
			margin: 0 0 1rem;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.45rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text);
			line-height: 1.4;
		}
		.program-card__obiettivi li {
			display: flex;
			align-items: flex-start;
			gap: 0.55rem;
		}
		.program-card__obiettivi li svg {
			flex-shrink: 0;
			margin-top: 0.15rem;
			color: var(--accent);
		}
		.program-card__tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin-bottom: 1.25rem;
		}
		.program-card__tag {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
