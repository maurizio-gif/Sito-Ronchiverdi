---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import AreaAccordion from "../../components/AreaAccordion.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import InfoTip from "../../components/InfoTip.astro";
import HoursTable from "../../components/HoursTable.astro";
import MembershipTable from "../../components/MembershipTable.astro";
import { gymFloorHours, gymFloorTrainerHours } from "../../data/schedules";
import { url } from "../../lib/paths";

const APP_URL = "https://onelink.to/tqhpzr";

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l8.5 4.5L12 12 3.5 7.5 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M3.5 12 12 16.5 20.5 12M3.5 16.5 12 21l8.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Quattro aree",
		html: "Skill area, cardio e isotonici, pesi liberi e cavi, area funzionale <strong>Lacertosus</strong>: spazi distinti, ognuno con la sua funzione.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7.5" r="3.5" stroke="currentColor" stroke-width="1.5" /><path d="M4.5 20c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Assistenza in sala",
		html: "L'istruttore è in sala <strong>dalle 9:00 alle 21:30</strong> nei giorni feriali: una correzione, un consiglio o una variante, quando ti servono.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M9 8.5h6M9 12h6M9 15.5h3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Consulenza iniziale",
		html: "Compresa nell'abbonamento: <strong>fitness check-up</strong> e primo programma di allenamento per chi inizia il suo percorso nel club.",
	},
];

// NOTA REDAZIONALE — foto: al momento sono disponibili solo gli scatti già
// presenti in /public/images. Ogni area è pronta per accogliere il suo
// slideshow: basta sostituire/aggiungere gli oggetti in `photos`.
const aree = [
	{
		id: "skill-area",
		name: "Skill Area",
		tag: "Funzionale e pesi liberi",
		desc: "L'area più versatile del Gym Floor: i rack per lo squat e i pesi liberi convivono con una zona tappetini e con alcuni macchinari cardio. Non è pesistica pura e non ci sono macchinari isotonici — qui si lavora in modo più globale, ideale per i circuiti e per chi arriva dal mondo dello sport e cerca un allenamento più funzionale.",
		bullets: [
			"Rack per lo squat e bilancieri",
			"Zona tappetini per il lavoro a corpo libero",
			"Macchinari cardio integrati nell'area",
			"Perfetta per i circuiti e per il lavoro a stazioni",
		],
		photos: [
			{ src: "images/activities/gym-floor.jpg", alt: "Skill Area del Gym Floor Ronchiverdi" },
			{ src: "images/club/lacertosus.jpg", alt: "Zona pesi liberi e rack della Skill Area" },
		],
		equipment: [
			"Rack per squat",
			"Bilancieri e dischi",
			"Manubri",
			"Tappetini per il lavoro a terra",
			"Macchinari cardio",
		],
	},
	{
		id: "cardio-isotonici",
		name: "Gym Floor",
		tag: "Cardio e isotonici",
		desc: "Il cuore della sala: al centro tutta l'area cardio, lungo il perimetro i macchinari isotonici per la forza, tutti con selettore. È lo spazio dove si costruisce la routine settimanale, alternando lavoro cardiovascolare e schede di tonificazione.",
		bullets: [
			"Treadmill e Skillrun",
			"Bike verticali e recumbent, ellittiche",
			"Stepper e wave",
			"Macchinari isotonici a selettore su tutto il perimetro",
		],
		photos: [
			{ src: "images/activities/gym-floor.jpg", alt: "Area cardio e macchinari isotonici del Gym Floor Ronchiverdi" },
		],
		equipment: [
			"Treadmill",
			"Skillrun",
			"Bike verticali",
			"Bike recumbent",
			"Ellittiche",
			"Stepper",
			"Wave",
			"Macchinari isotonici a selettore",
		],
	},
	{
		id: "pesi-liberi",
		name: "Pesi liberi e cavi",
		tag: "Manubri, panche e cavi",
		desc: "Subito oltre il cuore della sala, l'area dedicata alla pesistica più classica: rastrelliere di manubri, panche e macchinari a cavi, con i power rack e due postazioni a carico libero. Lo spazio giusto per chi lavora su schede di forza e ipertrofia.",
		bullets: [
			"Rastrelliere di manubri",
			"Due panche piane e una inclinata",
			"Sette-otto panchette",
			"Macchinari a cavi, power rack e due postazioni a carico libero",
		],
		photos: [
			{ src: "images/club/lacertosus.jpg", alt: "Area pesi liberi con manubri e panche" },
			{ src: "images/activities/hyrox.jpg", alt: "Rack e panche dell'area pesi liberi" },
		],
		equipment: [
			"Rastrelliere di manubri",
			"Due panche piane",
			"Una panca inclinata",
			"Sette-otto panchette",
			"Macchinari a cavi",
			"Power rack",
			"Due macchinari a carico libero",
		],
	},
	{
		id: "lacertosus",
		name: "Lacertosus",
		tag: "Area funzionale",
		desc: "Un'area a sé, completamente funzionale, dove allenarsi in autonomia negli orari in cui non ospita i corsi. È lo spazio dell'Hyrox a Ronchiverdi: chi prepara una gara può riprodurre qui tutte e otto le stazioni della competizione — vogatore, sled push, sled pull, burpee broad jump, SkiErg, farmers carry, sandbag lunge e wall ball — e in palinsesto c'è anche il corso Hyrox Workout.",
		bullets: [
			"Quattro rack per lo squat",
			"Lingua di sintetico per la slitta, sled e push",
			"Bilancieri, manubri e kettlebell",
			"SkiErg, vogatore, Air Bike e due Skillmill",
			"Quadrato con sacco da box",
		],
		note: "In alcune fasce orarie l'area ospita i corsi fitness funzionali e Airbox: gli orari sono sul planning settimanale.",
		photos: [
			{ src: "images/club/lacertosus.jpg", alt: "Area funzionale Lacertosus con vogatori e Air Bike" },
			{ src: "images/activities/hyrox.jpg", alt: "Rack per lo squat e lingua di sintetico per la slitta" },
			{ src: "images/activities/fitness.jpg", alt: "Allenamento funzionale nell'area Lacertosus" },
		],
		equipment: [
			"Quattro rack per squat",
			"Lingua di sintetico per slitta (sled e push)",
			"Bilancieri e dischi",
			"Manubri",
			"Kettlebell",
			"SkiErg",
			"Vogatore",
			"Wall ball",
			"Air Bike",
			"Due Skillmill",
			"Sacco da box",
		],
	},
];

const servizi = [
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7.5" r="3.5" stroke="currentColor" stroke-width="1.5" /><path d="M4.5 20c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		title: "Assistenza in sala",
		desc: "Non ti alleni da solo: l'istruttore è presente in sala per gran parte della giornata, per correggere un'esecuzione, spiegarti un macchinario o adattare un esercizio. Fuori da queste fasce la sala resta aperta e puoi allenarti in autonomia.",
		tip: "Presenza garantita: lunedì-venerdì 9:00-21:30, sabato 10:00-19:30, domenica 11:00-19:30.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M8 4h8a2 2 0 0 1 2 2v13a1 1 0 0 1-1.5.87L12 17.5l-4.5 2.37A1 1 0 0 1 6 19V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		title: "Consulenza iniziale",
		desc: "Un servizio gratuito, compreso nell'abbonamento, per iniziare con il piede giusto: si parte da una conversazione sui tuoi obiettivi e sul tempo che hai a disposizione, per costruire il mix di attività più adatto a te.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 18h3v-4H3v4Zm7.5 0h3V9h-3v9ZM18 18h3V4h-3v14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		title: "Technogym Checkup",
		desc: "Per chi è interessato al percorso fitness, la consulenza prosegue in sala pesi con il Technogym Checkup e la valutazione iniziale: la fotografia da cui parte il primo programma di allenamento.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="4" y="4.5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M8 3v3M16 3v3M4 9.5h16M9 14l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		title: "Programma di allenamento",
		desc: "Percorsi di total body, dimagrimento e forza, costruiti su obiettivi, caratteristiche fisiche e livello di allenamento. La scheda si aggiorna indicativamente ogni sei settimane, in base ai progressi e alla frequenza.",
	},
];

const requisiti = [
	{
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M3 10h18" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Abbonamento attivo",
	},
	{
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 3.5h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" /><path d="M12 8.5v6M9 11.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Certificato medico valido",
	},
	{
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="7.5" y="8.5" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M9 8.5V6a3 3 0 0 1 6 0v2.5M9 15.5V18a3 3 0 0 0 6 0v-2.5" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Braccialetto personale",
	},
];

const confronto = [
	{
		eyebrow: "Compreso nell'abbonamento",
		title: "Allenamento assistito",
		items: [
			"Consulenza iniziale e fitness check-up",
			"Programma di allenamento su obiettivo (total body, dimagrimento, forza)",
			"Rinnovo del programma ogni sei settimane circa",
			"Istruttori in sala a cui chiedere quando serve",
		],
	},
	{
		eyebrow: "Servizio extra",
		title: "Personal training",
		items: [
			"Misurazioni e valutazione più approfondite",
			"Programma costruito sulla tua storia e sui tuoi obiettivi specifici",
			"Un professionista che ti segue seduta dopo seduta",
			"Linee guida precise per tutto il percorso nel club",
		],
		highlight: true,
	},
];

const faq = [
	{
		q: "Quali sono gli orari di apertura della palestra?",
		a: "La sala fitness è aperta dal lunedì al venerdì dalle 7:00 alle 22:00, il sabato, la domenica e i festivi dalle 9:00 alle 20:00. Eventuali variazioni vengono comunicate tramite l'App del Club, che è il canale ufficiale per tutti gli aggiornamenti.",
	},
	{
		q: "Cosa serve per accedere alla sala fitness?",
		a: "Per accedere alla palestra servono un abbonamento attivo, un certificato medico in corso di validità e il proprio braccialetto personale per l'ingresso. In sala pesi sono obbligatorie calzature sportive pulite, dedicate all'uso in palestra, e l'asciugamano personale da appoggiare sulle panche e sugli attrezzi: se lo dimentichi, puoi noleggiarlo in reception.",
	},
	{
		q: "È sempre presente un istruttore in sala?",
		a: "La sala fitness è accessibile durante tutto l'orario di apertura, mentre la presenza dell'istruttore è garantita dal lunedì al venerdì dalle 9:00 alle 21:30, il sabato dalle 10:00 alle 19:30 e la domenica dalle 11:00 alle 19:30. Fuori da queste fasce puoi comunque allenarti, senza la presenza continuativa di un trainer.",
	},
	{
		q: "È prevista una scheda di allenamento personalizzata?",
		a: "Sì. Il servizio fitness comprende Technogym Checkup, valutazione iniziale, programma di allenamento personalizzato e aggiornamenti periodici della scheda. Il programma viene elaborato in base agli obiettivi, alle caratteristiche fisiche e al livello di allenamento della persona, e viene aggiornato indicativamente ogni sei settimane tenendo conto dei progressi raggiunti e della frequenza di allenamento.",
	},
	{
		q: "Che cos'è la consulenza iniziale?",
		a: "È un servizio di consulenza gratuito per chi entra nel club: si parte da una conversazione sui tuoi interessi e sull'abbonamento che hai scelto, per ricevere consigli sul mix di attività più adatto agli obiettivi e al tempo che hai a disposizione. Se l'interesse è sul fitness, si prosegue con il Technogym Checkup e il primo programma di allenamento.",
	},
	{
		q: "Che differenza c'è tra il programma incluso e il personal training?",
		a: "Il programma incluso è già costruito sui tuoi obiettivi. Il personal training è un servizio extra, con un livello di dettaglio diverso: misurazioni più precise da parte del professionista, un programma calibrato sulla tua storia e linee guida che ti accompagnano per tutto il percorso.",
	},
	{
		q: "I corsi di gruppo sono inclusi nell'abbonamento?",
		html: `<p>Sì. I corsi di gruppo sono inclusi nell'abbonamento fitness, salvo eventuali attività speciali per le quali siano previste condizioni differenti. Puoi consultare il palinsesto completo nel <a href="${url("/planning")}">planning</a>.</p>`,
	},
	{
		q: "Come posso prenotare i corsi di gruppo?",
		html: `<p>Tutti i corsi devono essere prenotati tramite l'App del Club, fino a esaurimento dei posti disponibili. Puoi <a href="${APP_URL}" target="_blank" rel="noopener">scaricare l'app qui</a>.</p>`,
	},
	{
		q: "Il Gym Floor è compreso in tutti gli abbonamenti?",
		a: "Il Gym Floor è compreso negli abbonamenti Gold, Silver e Gym. L'abbonamento Swim è invece dedicato alla sola area acqua.",
	},
	{
		q: "Posso allenarmi nell'area funzionale Lacertosus in autonomia?",
		a: "Sì, negli orari in cui l'area non ospita i corsi fitness funzionali e Airbox. Gli orari dei corsi sono consultabili nel planning settimanale.",
	},
];
---

<Layout
	title="Gym Floor — Sala pesi e area funzionale | Ronchiverdi Sport Club"
	description="Il Gym Floor di Ronchiverdi a Torino: sala pesi con cardio e isotonici Technogym, skill area, pesi liberi e area funzionale Lacertosus. Allenamento libero con assistenza degli istruttori e programma compreso nell'abbonamento."
>
	<PageHero image="images/activities/gym-floor.jpg" imageAlt="Gym Floor Ronchiverdi con macchinari cardio e isotonici Technogym" eyebrow="Attività sportive">
		<Fragment slot="title">Gym Floor, <em class="accent">allenati a modo tuo</em></Fragment>
		<Fragment slot="lede">Skill area, cardio e isotonici, pesi liberi e area funzionale: quattro spazi per allenarti in autonomia, con lo staff sempre a disposizione.</Fragment>
	</PageHero>

	<section class="about">
		<div class="about__content">
			<span class="eyebrow">Il Gym Floor</span>
			<h2>Allenarsi in un club, non in una palestra</h2>
			<p class="lede" style="margin-inline:0">
				Il <strong>Gym Floor di Ronchiverdi</strong> è lo spazio dedicato all'allenamento in autonomia: sala pesi con area cardio e macchinari isotonici Technogym, una skill area più funzionale, una zona di pesi liberi e cavi e l'area funzionale Lacertosus. Quattro ambienti distinti, dentro un club sportivo di 35.000 mq a Torino.
			</p>
			<p class="about__text">
				La differenza si sente soprattutto nelle ore di punta: qui non si fa la fila in quattro davanti allo stesso macchinario. Le postazioni sono distribuite su più aree, ognuna con una sua funzione, e questo lascia a ciascuno lo spazio per allenarsi con i propri tempi — che tu stia seguendo una scheda, preparando una gara o ritagliandoti semplicemente un'ora per te.
			</p>
			<p class="about__text">
				Libero non vuol dire lasciato al caso. Gli <strong>istruttori sono in sala</strong> per gran parte della giornata, la <strong>consulenza iniziale</strong> e il <strong>programma di allenamento</strong> sono compresi nell'abbonamento e vengono rivisti nel tempo. Chi cerca un percorso ancora più su misura può proseguire con un <a href={url("/attivita/personal-training")}>personal trainer</a>.
			</p>
		</div>
		<div class="about__media">
			<img src={url("images/activities/gym-floor.jpg")} alt="Macchinari cardio e isotonici Technogym nel Gym Floor Ronchiverdi" loading="lazy" />
		</div>
	</section>

	<IconFacts eyebrow="In sintesi" title="Spazio, attrezzatura e assistenza" items={facts} />

	<section class="aree-section" id="aree">
		<div class="aree-section__head">
			<span class="eyebrow">Gli spazi</span>
			<h2>Le aree del Gym Floor</h2>
			<p class="lede" style="margin-inline:0">
				Ogni area ha una sua identità e un suo modo di allenarsi. Apri quella che ti interessa per scoprire com'è fatta e cosa ci trovi.
			</p>
		</div>
		<AreaAccordion items={aree} />
	</section>

	<section class="servizio">
		<div class="servizio__head">
			<span class="eyebrow">Il servizio</span>
			<h2>Cosa è compreso nel tuo abbonamento</h2>
			<p class="lede" style="margin-inline:auto">
				Dalla prima consulenza al programma che si aggiorna nel tempo: l'allenamento è libero, l'accompagnamento è incluso.
			</p>
		</div>
		<div class="servizio-grid">
			{servizi.map((s) => (
				<article class="servizio-card">
					<span class="servizio-card__icon" aria-hidden="true" set:html={s.icon} />
					<h3>
						{s.title}
						{s.tip && <InfoTip text={s.tip} />}
					</h3>
					<p>{s.desc}</p>
				</article>
			))}
		</div>
		<p class="servizio__note">
			Anche i <strong>corsi di gruppo</strong> sono inclusi nell'abbonamento fitness, salvo attività speciali con condizioni differenti: trovi il palinsesto nel <a href={url("/planning")}>planning</a> e li prenoti dall'<a href={APP_URL} target="_blank" rel="noopener">App del Club</a>, fino a esaurimento posti.
		</p>
	</section>

	<section class="orari">
		<div class="orari__content">
			<span class="eyebrow">Orari e accesso</span>
			<h2>Quando è aperto</h2>
			<p class="lede" style="margin-inline:0">
				La sala è accessibile per tutto l'orario di apertura; nelle fasce indicate trovi anche l'istruttore in sala. Eventuali variazioni sono comunicate sull'<strong>App del Club</strong>, il canale ufficiale per gli aggiornamenti.
			</p>
			<ul class="requisiti">
				{requisiti.map((r) => (
					<li>
						<span class="requisiti__icon" aria-hidden="true" set:html={r.icon} />
						<span>{r.label}</span>
					</li>
				))}
			</ul>
			<a class="btn" href={url("/planning")}>Consulta il planning completo</a>
		</div>
		<div class="orari__tables">
			<div class="orari__table">
				<h3>Apertura sala</h3>
				<HoursTable rows={gymFloorHours} />
			</div>
			<div class="orari__table">
				<h3>Istruttore in sala</h3>
				<HoursTable rows={gymFloorTrainerHours} />
			</div>
		</div>
	</section>

	<MembershipTable
		eyebrow="Abbonamenti"
		title="Quale abbonamento ti serve"
		lede="Il Gym Floor è compreso negli abbonamenti <strong>Gold</strong>, <strong>Silver</strong> e <strong>Gym</strong>: confronta le formule e scegli quella adatta a te."
	>
		<div class="membership-cta">
			<button type="button" class="btn" data-open-contact data-interest="club-adulti">Iscriviti ora</button>
			<a class="btn btn-outline" href={url("/abbonamenti")}>Scopri le nostre membership</a>
		</div>
	</MembershipTable>

	<section class="personal">
		<div class="personal__head">
			<span class="eyebrow eyebrow-dark">Personal Training</span>
			<h2>Quando vuoi un percorso tutto tuo</h2>
			<p class="lede lede-dark" style="margin-inline:auto">
				L'assistenza in sala e il programma compreso nell'abbonamento accompagnano il tuo allenamento. Il personal training è il passo successivo, per chi vuole un percorso costruito nel dettaglio.
			</p>
		</div>
		<div class="personal-grid">
			{confronto.map((c) => (
				<article class={`personal-card${c.highlight ? " personal-card--highlight" : ""}`}>
					<span class="eyebrow eyebrow-dark">{c.eyebrow}</span>
					<h3>{c.title}</h3>
					<ul>
						{c.items.map((i) => (
							<li>
								<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
								<span>{i}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
		<div class="personal__cta">
			<a class="btn" href={url("/attivita/personal-training")}>Scopri i personal trainer</a>
			<button type="button" class="btn btn-outline btn-outline-dark" data-open-contact data-interest="club-adulti">Contattaci</button>
		</div>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vieni a provare il Gym Floor</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un <strong>tour gratuito</strong> e scopri gli spazi dal vivo, con uno dei nostri istruttori.
		</p>
