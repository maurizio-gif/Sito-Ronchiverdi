---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import WeeklySchedule from "../../components/WeeklySchedule.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import { url } from "../../lib/paths";
// Lezioni e planning arrivano dal file unico editabile da Tina
// (src/content/schedules/planning.json), lo stesso della pagina Planning.
import { getSchedule } from "../../lib/schedules";
import { faqDiPagina } from "../../data/faq";

const acquaFitness = await getSchedule("acqua-fitness");

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Dove",
		html: "Sempre in <strong>vasca grande</strong>: in piscina interna da autunno a fine maggio, in piscina esterna da giugno ad agosto.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5" /><path d="M12 2.5v2.3M12 19.2v2.3M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.3M19.2 12h2.3M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Estate",
		html: "L'accesso alla piscina esterna, e quindi ai corsi estivi, è riservato agli abbonamenti <strong>Gold</strong> e <strong>Silver</strong> (non incluso nell'abbonamento Swim).",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 18h3v-4H3v4Zm7.5 0h3V9h-3v9ZM18 18h3V4h-3v14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Livello",
		html: "Corsi adatti a tutti i livelli: gli istruttori propongono sempre varianti su misura per ogni partecipante.",
	},
];


const faq = faqDiPagina("acqua-fitness");
---

<Layout
	title="Acqua Fitness — Ronchiverdi Sport Club"
	description="Acqua Fitness a Ronchiverdi: allenamento in acqua tutto l'anno, in piscina interna ed esterna, con corsi per ogni livello."
	image="og/acqua-fitness.jpg"
>
	<PageHero image="images/activities/acqua-fitness.jpg" imageAlt="Corso di acqua fitness in piscina Ronchiverdi" eyebrow="Attività sportive">
		<Fragment slot="title">Acqua Fitness, <em class="accent">allenati in acqua</em></Fragment>
		<Fragment slot="lede">Un palinsesto di corsi in acqua per tutto l'anno, tra piscina interna ed esterna, per allenare tonicità, resistenza e benessere.</Fragment>
		<div class="header-cta">
			<button type="button" class="btn" data-interest="club-adulti" data-open-contact>Richiedi informazioni</button>
		</div>
	</PageHero>

	<IconFacts eyebrow="Come funziona" title="Tutto quello che ti serve sapere" items={facts} />

	<section class="courses-section">
		<div class="courses-section__head">
			<span class="eyebrow">Le lezioni</span>
			<h2>Le tipologie di lezione</h2>
			{acquaFitness.intro && <p class="lede" style="margin-inline:auto">{acquaFitness.intro}</p>}
		</div>
		<div class="course-grid">
			{acquaFitness.lessonList.map((c) => (
				<article class="course-card">
					<h3>{c.name}</h3>
					<p>{c.description}</p>
				</article>
			))}
		</div>
		<p class="courses-section__note">
			L'acqua fitness non ha controindicazioni: acqua e divertimento accompagnano tutte le lezioni.
		</p>
	</section>

	<section class="planning-section">
		<div class="planning-section__head">
			<span class="eyebrow">Planning settimanale</span>
			<h2>Il palinsesto Acqua Fitness</h2>
			<p class="lede" style="margin-inline:0">
				Orari e trainer di tutte le lezioni in acqua. Clicca su una lezione per leggerne la descrizione.{acquaFitness.note && <em> {acquaFitness.note}</em>}
			</p>
		</div>
		<WeeklySchedule id="acqua-fitness" lessons={acquaFitness.lessons} schedule={acquaFitness.schedule} />
		<div class="planning-section__cta">
			<a class="btn" href={url("/planning")}>Consulta il planning completo</a>
		</div>
		<div class="section-cta">
			<button type="button" class="btn btn-outline" data-open-contact data-interest="club-adulti">Contattaci</button>
		</div>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vieni a scoprire il club</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un <strong>tour gratuito</strong> e visita le nostre piscine.
		</p>
		<div class="final-cta__buttons">
			<button type="button" class="btn" data-open-contact data-interest="club-adulti">Prenota un tour</button>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="club-adulti">Contattaci</button>
		</div>
	</section>

	<style>

		.courses-section {
			max-width: 78rem;
			margin: 0 auto;
			padding: 1rem 1.5rem 4rem;
			border-top: 1px solid var(--border);
			padding-top: 3rem;
		}
		.courses-section__head {
			text-align: center;
			max-width: 46rem;
			margin: 0 auto;
		}
		.courses-section__note {
			max-width: 46rem;
			margin: 2.5rem auto 0;
			text-align: center;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			font-style: italic;
			color: var(--text-muted);
		}
		.course-grid {
			margin-top: 2.5rem;
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.75rem;
		}
		.course-card {
			padding: 1.5rem;
			border: 1px solid var(--border);
			border-radius: 16px;
			background: var(--bg-alt);
			transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.course-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 16px 32px -12px rgba(28, 28, 24, 0.25);
		}
		.course-card h3 {
			margin: 0 0 0.6rem;
			font-size: var(--text-lg);
		}
		.course-card p {
			margin: 0;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.6;
		}
		@media (max-width: 960px), (orientation: portrait) {
			.course-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 640px) {
			.course-grid {
				grid-template-columns: 1fr;
			}
		}

		.planning-section {
			max-width: 88rem;
			margin: 0 auto;
			padding: 1rem 1.5rem 5rem;
		}
		.planning-section__head {
			text-align: center;
			max-width: 40rem;
			margin: 0 auto 2.5rem;
		}
		.planning-section__head .lede {
			margin-top: 0.5rem;
		}
		.planning-section__cta {
			text-align: center;
			margin-top: 2.5rem;
		}
		.planning-section__head em {
			font-style: italic;
			color: var(--accent);
		}
		.section-cta {
			display: flex;
			justify-content: center;
			margin-top: 1.5rem;
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
		.final-cta__buttons {
			display: flex;
			gap: 1rem;
			justify-content: center;
			flex-wrap: wrap;
		}
	</style>
</Layout>
