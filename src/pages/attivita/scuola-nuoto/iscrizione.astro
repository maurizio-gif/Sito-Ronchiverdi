---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Faq from "../../../components/Faq.astro";
import { faqDiPagina } from "../../../data/faq";
import "../../../styles/iscrizione.css";

// La pagina ha un solo compito: portare al portale InforYou, dove l'iscrizione
// si completa davvero. Tutto il resto (procedura, pagamento, badge) serve a
// togliere i dubbi che fermano prima del clic, quindi sta sotto le due card.

// Il negozio InforYou distingue le due platee: categorie diverse, prezzi diversi.
const percorsi = [
	{
		label: "Bambini non soci",
		desc: "La quota d'iscrizione è già inclusa nel listino prezzi: nessun costo aggiuntivo.",
		href: "https://inforyou.teamsystem.com/ronchiverdi/store/2/category/2",
	},
	{
		label: "Bambini soci del club",
		desc: "Con abbonamento Ronchiverdi attivo, la quota d'iscrizione non è dovuta.",
		href: "https://inforyou.teamsystem.com/ronchiverdi/store/2/category/10",
	},
];

const procedura = [
	{
		title: "Crea l'account",
		desc: "L'account va intestato al bambino, non al genitore.",
	},
	{
		title: "Iscrivi al corso",
		desc: "Scegli il corso e completa il pagamento direttamente online.",
	},
	{
		title: "Carica i documenti",
		desc: "Certificato medico e regolamento firmato, dalla tua area personale.",
	},
];

const pagamento = [
	{ title: "Soluzione unica", desc: "L'intero importo al momento dell'iscrizione." },
	{ title: "3 rate mensili", desc: "Tramite PayPal, senza costi aggiuntivi." },
	{ title: "8 rate", desc: "Per importi superiori a €2.000, da concordare in sede." },
];

const primoGiorno = [
	{
		title: "Arriva 20 minuti prima",
		desc: "Il tempo di cambiarsi con calma e presentarsi in vasca all'orario di inizio.",
	},
	{
		title: "Braccialetto badge",
		desc: "Serve per passare i tornelli e, per sicurezza, va indossato sempre, sin dalla prima lezione. Chi ne è sprovvisto lo acquista a <strong>10,00 €</strong>; chi ce l'ha già da corsi precedenti lo fa vidimare alla reception nella settimana prima dell'inizio.",
	},
];

const faq = faqDiPagina("scuola-nuoto-iscrizione");
---

<Layout
	title="Modalità di iscrizione — Scuola Nuoto Ronchiverdi"
	description="Come iscriversi alla Scuola Nuoto Ronchiverdi: quote, procedura, pagamento, accesso al club e contatti della segreteria."
	image="og/scuola-nuoto-iscrizione.jpg"
>
	<PageHero
		image="images/attivita/scuola-nuoto-hero.jpg"
		imageAlt="Lezione della scuola nuoto con istruttrice e bambini in vasca a Ronchiverdi"
		eyebrow="Scuola Nuoto"
	>
		<Fragment slot="title">Modalità di <em class="accent">iscrizione</em></Fragment>
		<Fragment slot="lede">Se sai già a quale corso iscriverti, accedi direttamente al portale online. In alternativa, contatta il responsabile: ti aiutiamo noi.</Fragment>
		<div class="header-cta">
			<a class="btn" href="#iscriviti">Iscriviti online</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
		</div>
	</PageHero>

	<section class="isc-section" id="iscriviti">
		<div class="isc-head">
			<span class="eyebrow">Iscrizione online</span>
			<h2>Due percorsi, un solo portale</h2>
			<p class="isc-head__lede">
				L'iscrizione si completa su InforYou, il portale del club. Scegli la
				voce che ti riguarda: cambia il listino, non la procedura.
			</p>
		</div>
		<div class="isc-cards">
			{percorsi.map((p) => (
				<article class="isc-card">
					<span class="isc-card__label">{p.label}</span>
					<p class="isc-card__desc">{p.desc}</p>
					<a class="btn isc-card__btn" href={p.href} target="_blank" rel="noopener">
						Iscrizione e pagamento
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 10L10 4M10 4H5M10 4v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				</article>
			))}
		</div>
	</section>

	<section class="isc-section">
		<div class="isc-head">
			<span class="eyebrow">Tre passaggi</span>
			<h2>Come funziona</h2>
		</div>
		<ol class="isc-steps">
			{procedura.map((s, i) => (
				<li class="isc-step">
					<span class="isc-step__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
					<h3>{s.title}</h3>
					<p>{s.desc}</p>
				</li>
			))}
		</ol>
		<p class="isc-note">
			Il bambino ha già ricevuto le credenziali in passato e sono state
			smarrite? Chiamaci allo <a href="tel:+390116612146">011 6612146</a>: le
			recuperiamo noi.
		</p>
	</section>

	<section class="isc-section isc-section--alt">
		<div class="isc-duo">
			<div class="isc-duo__col">
				<div class="isc-head isc-head--left">
					<span class="eyebrow">Pagamento</span>
					<h2>Come si paga</h2>
				</div>
				<dl class="isc-list">
					{pagamento.map((p) => (
						<div class="isc-list__row">
							<dt>{p.title}</dt>
							<dd>{p.desc}</dd>
						</div>
					))}
				</dl>
				<p class="isc-note">In assenza di regolare pagamento non è possibile partecipare alle lezioni.</p>
			</div>
			<div class="isc-duo__col">
				<div class="isc-head isc-head--left">
					<span class="eyebrow">Prima lezione</span>
					<h2>Cosa serve sapere</h2>
				</div>
				<dl class="isc-list">
					{primoGiorno.map((p) => (
						<div class="isc-list__row">
							<dt>{p.title}</dt>
							<dd set:html={p.desc} />
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="isc-section isc-contatti">
		<div class="isc-head">
			<span class="eyebrow">Segreteria</span>
			<h2>Parlane con noi</h2>
			<p class="isc-head__lede">
				Corsi, orari, disponibilità, prove gratuite, recuperi e documenti:
				risponde lo staff della Young School Nuoto, dal <strong>lunedì al
				venerdì, 10:00–13:00 e 16:00–18:00</strong>.
			</p>
		</div>
		<button type="button" class="btn" data-open-contact data-interest="scuola-nuoto">Richiedi maggiori informazioni</button>
		<p class="isc-note isc-note--center">In caso di elevato numero di richieste i tempi di risposta potrebbero allungarsi.</p>
		<p class="isc-closing">Lo staff della Young School Nuoto sarà lieto di accompagnare i vostri figli in questo entusiasmante percorso.</p>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Hai ancora dubbi?</h2>
		<p class="lede" style="margin-inline:auto">Contattaci: ti aiutiamo a scegliere il corso più adatto e a completare l'iscrizione.</p>
		<button type="button" class="btn" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
	</section>

	<style>
		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		/* Il saluto dello staff chiude la pagina: e' l'unico pezzo di voce
		   umana, quindi ha un trattamento suo. */
		.isc-closing {
			max-width: 38rem;
			margin: 2.5rem auto 0;
			font-family: var(--font-serif);
			font-size: var(--text-lg);
			line-height: 1.4;
			color: var(--text);
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta h2 {
			margin-bottom: 1rem;
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
	</style>
</Layout>
