---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Faq from "../../../components/Faq.astro";
import ModalitaIscrizioneNuoto from "../../../components/ModalitaIscrizioneNuoto.astro";
import { faqDiPagina } from "../../../data/faq";
import { url } from "../../../lib/paths";
import { euro, getCorsiNuoto, prezzoDa } from "../../../lib/scuolaNuoto";
import "../../../styles/iscrizione.css";

// La pagina ha un solo compito: portare al portale InforYou, dove l'iscrizione
// si completa davvero. Tutto il resto (procedura, pagamento, badge) serve a
// togliere i dubbi che fermano prima del clic, quindi sta sotto le due card.

const corsiNuoto = await getCorsiNuoto();
const faq = faqDiPagina("scuola-nuoto-iscrizione");
---

<Layout
	title="Modalità di iscrizione — Scuola Nuoto Ronchiverdi"
	description="Come iscriversi alla Scuola Nuoto Ronchiverdi: quote, procedura, pagamento, accesso al club e contatti della segreteria."
	image="og/scuola-nuoto-iscrizione.jpg"
>
	<PageHero
		image="images/attivita/scuola-nuoto-hero.jpg"
		imageAlt="Lezione della scuola nuoto con istruttrice e bambini in vasca a Ronchiverdi"
		eyebrow="Scuola Nuoto · Iscrizione"
	>
		<Fragment slot="title">Modalità di <em class="accent">iscrizione</em></Fragment>
		<Fragment slot="lede">Se sai già a quale corso iscriverti, accedi direttamente al portale online. In alternativa, contatta il responsabile: ti aiutiamo noi.</Fragment>
		<div class="header-cta">
			<a class="btn" href="#iscriviti">Iscriviti online</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
		</div>
	</PageHero>

	<section class="isc-section" id="iscriviti">
		<div class="isc-head">
			<span class="eyebrow">Quote e iscrizione</span>
			<h2>Parti dal corso di tuo figlio</h2>
			<p class="isc-head__lede">
				Ogni corso ha il suo listino, con la quota d'iscrizione già compresa e
				un prezzo dedicato ai soci del club. Apri il tuo per vedere quote,
				formule e link all'iscrizione online.
			</p>
		</div>
		<div class="corsi-cards">
			{corsiNuoto.map((c) => (
				<a class="corso-card" href={url(`/attivita/scuola-nuoto/iscrizione/${c.slug}`)}>
					<span class="corso-card__eta">{c.ageLabel}</span>
					<span class="corso-card__nome">{c.title}</span>
					<span class="corso-card__prezzo">da {euro(prezzoDa(c))}</span>
					<span class="corso-card__vai">
						Quote e iscrizione
						<svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true"><path d="M1 7h15M10 1l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</span>
				</a>
			))}
		</div>
		<p class="isc-note isc-note--center">
			Il prezzo indicato è il più basso del corso, riservato ai soci: dentro
			trovi tutte le formule, per soci e non soci.
		</p>
	</section>

	<ModalitaIscrizioneNuoto />

	<section class="isc-section isc-contatti">
		<div class="isc-head">
			<span class="eyebrow">Segreteria</span>
			<h2>Parlane con noi</h2>
			<p class="isc-head__lede">
				Corsi, orari, disponibilità, prove gratuite, recuperi e documenti:
				risponde lo staff della Young School Nuoto, dal <strong>lunedì al
				venerdì, 10:00–13:00 e 16:00–18:00</strong>.
			</p>
		</div>
		<button type="button" class="btn" data-open-contact data-interest="scuola-nuoto">Richiedi maggiori informazioni</button>
		<p class="isc-note isc-note--center">In caso di elevato numero di richieste i tempi di risposta potrebbero allungarsi.</p>
		<p class="isc-closing">Lo staff della Young School Nuoto sarà lieto di accompagnare i vostri figli in questo entusiasmante percorso.</p>
	</section>

	<Faq items={faq} misura="72rem" />

	<section class="final-cta">
		<h2>Hai ancora dubbi?</h2>
		<p class="lede" style="margin-inline:auto">Contattaci: ti aiutiamo a scegliere il corso più adatto e a completare l'iscrizione.</p>
		<button type="button" class="btn" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
	</section>

	<style>
		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		.corsi-cards {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
		}
		.corso-card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1.5rem 1.4rem;
			border: 1px solid var(--border-strong);
			border-radius: var(--radius);
			background: var(--bg-alt);
			text-decoration: none;
			transition: border-color 0.16s ease, transform 0.16s ease;
		}
		.corso-card:hover {
			border-color: var(--accent);
			transform: translateY(-2px);
		}
		.corso-card__eta {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.corso-card__nome {
			font-family: var(--font-serif);
			font-size: var(--text-xl);
			line-height: var(--leading-lg);
			color: var(--text);
		}
		.corso-card__prezzo {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
		}
		.corso-card__vai {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			margin-top: 0.9rem;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--text);
		}

		/* Il saluto dello staff chiude la pagina: e' l'unico pezzo di voce
		   umana, quindi ha un trattamento suo. */
		.isc-closing {
			max-width: 38rem;
			margin: 2.5rem auto 0;
			font-family: var(--font-serif);
			font-size: var(--text-lg);
			line-height: 1.4;
			color: var(--text);
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta h2 {
			margin-bottom: 1rem;
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}

		/* Quattro card in fila stanno solo sul desktop largo: sotto vanno a
		   due, e su telefono in colonna. */
		@media (max-width: 1100px) {
			.corsi-cards {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 620px) {
			.corsi-cards {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	</style>
</Layout>
