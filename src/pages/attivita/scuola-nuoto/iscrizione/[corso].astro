---
// Una pagina di iscrizione per ogni corso della scuola nuoto: chi arriva
// dall'Acquaticità vede il listino dell'Acquaticità e basta, senza gli altri
// prezzi intorno.
//
// Le quattro pagine escono da un file solo, dai dati in src/data/scuolaNuoto.ts:
// quattro file separati sarebbero divergenti al primo ritocco.
//
// Le informative (procedura, pagamento, primo giorno) stanno qui dentro e non
// dietro un link: chi arriva sulla pagina del suo corso deve trovarci tutto,
// senza essere rimbalzato altrove. Il testo vive una volta sola nel componente
// ModalitaIscrizioneNuoto, che le quattro pagine e l'hub includono.
import Layout from "../../../../layouts/Layout.astro";
import PageHero from "../../../../components/PageHero.astro";
import { url } from "../../../../lib/paths";
import Faq from "../../../../components/Faq.astro";
import ListinoCorsi from "../../../../components/ListinoCorsi.astro";
import ModalitaIscrizioneNuoto from "../../../../components/ModalitaIscrizioneNuoto.astro";
import { faqDiPagina } from "../../../../data/faq";
import {
	TELEFONO_CLUB,
	euro,
	getCorsiNuoto,
	prezzoDa,
	getListinoAggiornatoAl,
	linkProdotto,
	type CorsoNuoto,
} from "../../../../lib/scuolaNuoto";
import "../../../../styles/iscrizione.css";

export async function getStaticPaths() {
	const corsi = await getCorsiNuoto();
	return corsi.map((corso) => ({ params: { corso: corso.slug }, props: { corso, corsi } }));
}

interface Props {
	corso: CorsoNuoto;
	corsi: CorsoNuoto[];
}

const { corso, corsi } = Astro.props;
const listinoAggiornatoAl = await getListinoAggiornatoAl();
const nome = corso.titleLungo ?? corso.title;
const faq = faqDiPagina("scuola-nuoto-iscrizione");
---

<Layout
	title={`Iscrizione ${corso.title} — Scuola Nuoto Ronchiverdi`}
	description={`Quote e modalità di iscrizione al corso ${corso.title} (${corso.ageLabel}) della Young School Nuoto Ronchiverdi: prezzi soci e non soci, formule quadrimestrale e stagionale.`}
	image="og/scuola-nuoto-iscrizione.jpg"
>
	<PageHero image={corso.image} imageAlt={corso.imageAlt} eyebrow="Scuola Nuoto · Iscrizione">
		<Fragment slot="title">{nome}</Fragment>
		<Fragment slot="lede">{corso.percorso}</Fragment>
		<div class="header-cta">
			<a class="btn" href="#listino">Vedi le quote</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="scuola-nuoto">Contattaci</button>
		</div>
	</PageHero>

	<section class="isc-section">
		<div class="isc-head">
			<span class="eyebrow">{corso.ageLabel}</span>
			<h2>Com'è fatto il corso</h2>
		</div>
		<div class="corso-griglia">
			<div class="corso-box">
				<h3>Obiettivi</h3>
				<ul class="corso-punti">
					{corso.obiettivi.map((o) => (
						<li>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
							<span>{o}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="corso-box">
				<h3>In pratica</h3>
				<dl class="isc-list">
					<div class="isc-list__row">
						<dt>Età</dt>
						<dd>{corso.ageLabel}</dd>
					</div>
					<div class="isc-list__row">
						<dt>Durata della lezione</dt>
						<dd>{corso.durata}</dd>
					</div>
					<div class="isc-list__row">
						<dt>Dove</dt>
						<dd>{corso.vasca}</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>

	<section class="isc-section isc-section--alt" id="listino">
		<div class="isc-head">
			<span class="eyebrow">Quote {corso.title}</span>
			<h2>Quanto costa</h2>
			<p class="isc-head__lede">
				La quota d'iscrizione è compresa: non ci sono costi aggiuntivi. Con un
				abbonamento Ronchiverdi attivo vale il listino soci.
			</p>
		</div>

		<ListinoCorsi
			colonna="Formula"
			righe={corso.listino.map((r) => ({
				voce: r.formula,
				dettaglio: r.periodo,
				nota: r.dettaglio,
				prezzoNonSoci: r.prezzoNonSoci,
				prezzoSoci: r.prezzoSoci,
				idNonSoci: r.idNonSoci,
				idSoci: r.idSoci,
			}))}
			dettagli={corso.dettagli}
			aggiornatoAl={listinoAggiornatoAl}
		/>
	</section>

	<ModalitaIscrizioneNuoto corso={corso.title} />

	<section class="isc-section isc-contatti">
		<div class="isc-head">
			<span class="eyebrow">Segreteria</span>
			<h2>Parlane con noi</h2>
			<p class="isc-head__lede">
				Orari, disponibilità di posti, prove gratuite, recuperi e documenti:
				risponde lo staff della Young School Nuoto, dal <strong>lunedì al
				venerdì, 10:00–13:00 e 16:00–18:00</strong>.
			</p>
		</div>
		<div class="corso-azioni">
			<button type="button" class="btn" data-open-contact data-interest="scuola-nuoto">Richiedi informazioni</button>
			<a class="btn btn-outline" href={`tel:+39${TELEFONO_CLUB.replace(/\s/g, "")}`}>{TELEFONO_CLUB}</a>
		</div>
	</section>

	<Faq items={faq} />

	<section class="altri-corsi">
		<div class="isc-head">
			<span class="eyebrow">Gli altri corsi</span>
			<h2>Non è questo il corso giusto?</h2>
		</div>
		<div class="altri-corsi__lista">
			{corsi
				.filter((c) => c.slug !== corso.slug)
				.map((c) => (
					<a class="altro-corso" href={url(`/attivita/scuola-nuoto/iscrizione/${c.slug}`)}>
						<span class="altro-corso__media">
							<img src={url(c.image)} alt="" loading="lazy" />
						</span>
						<span class="altro-corso__testi">
							<span class="altro-corso__eta">{c.ageLabel}</span>
							<span class="altro-corso__nome">{c.title}</span>
							<span class="altro-corso__prezzo">da {euro(prezzoDa(c))}</span>
						</span>
						<span class="altro-corso__freccia" aria-hidden="true">
							<svg width="18" height="14" viewBox="0 0 18 14" fill="none"><path d="M1 7h15M10 1l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</span>
					</a>
				))}
		</div>
	</section>

	<style>
		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		.corso-griglia {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
		}
		.corso-box h3 {
			margin: 0 0 1rem;
			font-family: var(--font-sans);
			font-size: var(--text-md);
			font-weight: 600;
		}
		.corso-punti {
			margin: 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 0.7rem;
		}
		.corso-punti li {
			display: flex;
			align-items: flex-start;
			gap: 0.6rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			line-height: 1.6;
			color: var(--text-muted);
		}
		.corso-punti svg {
			flex-shrink: 0;
			margin-top: 0.3em;
			color: var(--accent);
		}

		.corso-azioni {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 1rem;
		}
		.corso-azioni .btn {
			cursor: pointer;
			font-family: var(--font-sans);
		}
		.corso-azioni a.btn {
			cursor: pointer;
		}

		/* ── Gli altri corsi ──────────────────────────────────────────── */
		/* Stacco netto da quello che c'è sopra: qui finisce la pagina del corso
		   e comincia un'altra domanda ("e se non fosse questo?"), quindi non
		   deve sembrare la coda della sezione precedente. */
		.altri-corsi {
			max-width: 72rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 6rem;
			border-top: 1px solid var(--border-strong);
		}
		.altri-corsi__lista {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
		.altro-corso {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 0.9rem 1.1rem 0.9rem 0.9rem;
			border: 1px solid var(--border-strong);
			border-radius: var(--radius);
			background: var(--bg);
			text-decoration: none;
			transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease,
				box-shadow 0.16s ease;
		}
		.altro-corso:hover {
			border-color: var(--accent);
			background: var(--bg-alt);
			transform: translateY(-2px);
			box-shadow: 0 12px 24px -14px rgba(28, 28, 24, 0.45);
		}
		/* La foto del corso fa riconoscere la card prima di leggerla: sono le
		   stesse immagini delle card sulla pagina della scuola nuoto. */
		.altro-corso__media {
			flex: 0 0 auto;
			width: 56px;
			height: 56px;
			border-radius: 50%;
			overflow: hidden;
			background: var(--bg-alt);
		}
		.altro-corso__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		.altro-corso__testi {
			display: flex;
			flex-direction: column;
			gap: 0.1rem;
			min-width: 0;
		}
		.altro-corso__nome {
			font-family: var(--font-serif);
			font-size: var(--text-lg);
			line-height: 1.15;
			color: var(--text);
		}
		.altro-corso__eta {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.altro-corso__prezzo {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			color: var(--text-muted);
		}
		.altro-corso__freccia {
			margin-left: auto;
			flex-shrink: 0;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: var(--bg-alt);
			color: var(--text);
			transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
		}
		.altro-corso:hover .altro-corso__freccia {
			background: var(--accent);
			color: var(--text-on-dark);
			transform: translateX(2px);
		}

		@media (max-width: 860px), (orientation: portrait) {
			.corso-griglia {
				grid-template-columns: minmax(0, 1fr);
				gap: 2.5rem;
			}
			.altri-corsi__lista {
				grid-template-columns: minmax(0, 1fr);
			}
			.altri-corsi {
				padding: 3rem 1.25rem 4rem;
			}
		}
	</style>
</Layout>
