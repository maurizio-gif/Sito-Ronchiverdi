---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import IconFacts from "../../components/IconFacts.astro";
import prefissi from "../../data/prefissi-telefonici";
import { url } from "../../lib/paths";

const trainers = (await getCollection("trainers")).sort(
	(a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

// Normalizza un numero (con o senza prefisso) in un href tel: pulito.
function telHref(phone: string) {
	const digits = phone.replace(/\D/g, "");
	const withCountry = digits.startsWith("39") && digits.length > 10 ? digits : `39${digits}`;
	return `+${withCountry}`;
}

const igHref = (handle: string) => `https://instagram.com/${handle.replace(/^@/, "")}`;
const webHref = (site: string) => (site.startsWith("http") ? site : `https://${site}`);

const phoneIcon = `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 2.2h2l1 3-1.5 1.2a8 8 0 0 0 4.6 4.6l1.2-1.5 3 1v2a1.2 1.2 0 0 1-1.3 1.2A10.8 10.8 0 0 1 2.3 3.5a1.2 1.2 0 0 1 1.2-1.3Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>`;
const mailIcon = `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.8" y="3.2" width="12.4" height="9.6" rx="1.5" stroke="currentColor" stroke-width="1.3" /><path d="M2.5 4l5.5 4.2L13.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
const igIcon = `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.8" y="1.8" width="12.4" height="12.4" rx="3.6" stroke="currentColor" stroke-width="1.3" /><circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.3" /><circle cx="11.6" cy="4.5" r="0.9" fill="currentColor" /></svg>`;
const webIcon = `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.2" stroke="currentColor" stroke-width="1.3" /><path d="M1.8 8h12.4M8 1.8c1.7 1.8 2.6 4 2.6 6.2s-.9 4.4-2.6 6.2c-1.7-1.8-2.6-4-2.6-6.2S6.3 3.6 8 1.8Z" stroke="currentColor" stroke-width="1.3" /></svg>`;

// Il mini questionario della consulenza col Fitness Manager. Sta qui e non
// nel markup perché le risposte viaggiano anche nel payload: una lista sola
// evita che l'etichetta mostrata e quella salvata prendano strade diverse.
const obiettivi = [
	"Dimagrimento e ricomposizione corporea",
	"Tonificazione e forza",
	"Preparazione atletica o gara",
	"Recupero funzionale e postura",
	"Rientro dopo un lungo stop",
	"Gravidanza o post parto",
];

const livelli = [
	"Non mi alleno da tempo",
	"Mi alleno saltuariamente",
	"Mi alleno con regolarità",
];

const frequenze = ["1 volta a settimana", "2 volte a settimana", "3 o più volte a settimana", "Non lo so ancora"];

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4" y="3.5" width="16" height="17" rx="2.2" stroke="currentColor" stroke-width="1.5" /><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Percorso su misura",
		html: "Ogni programma nasce da un <strong>obiettivo personale</strong>: dimagrimento, forza, sport specifico o recupero funzionale. Nessun protocollo standard.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.5L12 15.8 7.1 18.2l.9-5.5-4-3.9L9.5 8 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Trainer certificati",
		html: "Laureati in Scienze Motorie, chinesiologi, specialisti Hyrox e preparatori atletici: un team con <strong>formazione ed esperienza verificabili</strong>.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l8.5 4.5L12 12 3.5 7.5 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M3.5 12 12 16.5 20.5 12M3.5 16.5 12 21l8.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Tutti gli spazi del club",
		html: "Le sessioni si svolgono nel <strong>Gym Floor</strong>, in acqua o sui campi: ogni trainer sceglie lo spazio più adatto al tuo obiettivo.",
	},
];
---

<Layout
	title="Personal Training — Ronchiverdi Sport Club"
	description="Il team di Personal Trainer di Ronchiverdi Sport Club a Torino: percorsi su misura per dimagrimento, forza, recupero funzionale e preparazione atletica. Contatta direttamente il trainer che preferisci."
>
	<PageHero image="images/activities/personal-training.jpg" imageAlt="Sessione di personal training al Ronchiverdi Sport Club" eyebrow="Attività · Adulti">
		<Fragment slot="title">Personal <em class="accent">Training</em></Fragment>
		<Fragment slot="lede">Un percorso costruito intorno a te, seguito da un trainer che scegli tu. Sfoglia i profili e contatta direttamente chi fa per te.</Fragment>
	</PageHero>

	<section class="intro">
		<span class="eyebrow">Come funziona</span>
		<h2>Un allenamento, un solo obiettivo: il tuo</h2>
		<p class="lede" style="margin-inline:auto">
			Il personal training di Ronchiverdi mette a disposizione un team di trainer con formazioni e specializzazioni diverse — dalla ricomposizione corporea alla preparazione atletica, dal recupero funzionale all'allenamento in gravidanza. Scegli il profilo più vicino al tuo obiettivo e <strong>contattalo direttamente</strong>: nessun intermediario, nessuna attesa.
		</p>
	</section>

	<IconFacts eyebrow="Perché il personal training" title="Cosa comprende il servizio" items={facts} />

	<section class="team">
		<div class="team__head">
			<span class="eyebrow">Il team</span>
			<h2>I nostri Personal Trainer</h2>
			<p class="lede" style="margin-inline:auto">
				Passa il mouse su una scheda — o toccala da smartphone — per vedere formazione, competenze e contatti diretti.
			</p>
		</div>

		<div class="pt-grid">
			{trainers.map((t) => (
				<article class="pt-card" tabindex="0">
					<div class="pt-card__clip">
						<img class="pt-card__img" src={url(t.data.photo)} alt={`Foto di ${t.data.name}`} loading="lazy" />
						<div class="pt-card__scrim"></div>
						<div class="pt-card__body">
							<strong class="pt-card__name">{t.data.name}</strong>
							{t.data.role && <span class="pt-card__role">{t.data.role}</span>}

							<span class="pt-card__hint">Formazione e contatti <span aria-hidden="true">&rarr;</span></span>

							<div class="pt-card__reveal">
								{t.data.formazione && t.data.formazione.length > 0 && (
									<div class="pt-card__group">
										<span class="pt-card__group-label">Formazione</span>
										<ul>{t.data.formazione.map((f) => <li>{f}</li>)}</ul>
									</div>
								)}
								{t.data.competenze && t.data.competenze.length > 0 && (
									<div class="pt-card__group">
										<span class="pt-card__group-label">Competenze</span>
										<ul>{t.data.competenze.map((c) => <li>{c}</li>)}</ul>
									</div>
								)}
								<div class="pt-card__contacts">
									{t.data.phone && (
										<a class="pt-contact" href={`tel:${telHref(t.data.phone)}`} aria-label={`Chiama ${t.data.name}`}>
											<span set:html={phoneIcon} />{t.data.phone}
										</a>
									)}
									{t.data.email && (
										<a class="pt-contact" href={`mailto:${t.data.email}`} aria-label={`Scrivi un'email a ${t.data.name}`}>
											<span set:html={mailIcon} />Email
										</a>
									)}
									{t.data.instagram && (
										<a class="pt-contact" href={igHref(t.data.instagram)} target="_blank" rel="noopener" aria-label={`Instagram di ${t.data.name}`}>
											<span set:html={igIcon} />Instagram
										</a>
									)}
									{t.data.website && (
										<a class="pt-contact" href={webHref(t.data.website)} target="_blank" rel="noopener" aria-label={`Sito di ${t.data.name}`}>
											<span set:html={webIcon} />Sito web
										</a>
									)}
								</div>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="fm-section" id="consulenza-fitness-manager">
		<div class="fm-intro">
			<span class="eyebrow">Consulenza gratuita</span>
			<h2>Non sai quale trainer <em class="accent">scegliere</em>?</h2>
			<p class="lede">
				Rispondi a tre domande sul tuo obiettivo e lasciaci i tuoi dati: li riceve il <strong>Fitness Manager</strong>, che ti richiama personalmente per fissare una prima consulenza e indicarti il personal trainer più adatto a te.
			</p>
		</div>

		<form class="fm-form" id="fm-form" novalidate>
			<fieldset class="fm-fieldset">
				<legend class="fm-legend">1 · Qual è il tuo obiettivo? <em>(puoi sceglierne più di uno)</em></legend>
				<div class="lf__chips">
					{obiettivi.map((o) => (
						<label class="lf__chip">
							<input type="checkbox" name="obiettivo" value={o} />
							<span>{o}</span>
						</label>
					))}
				</div>
			</fieldset>

			<fieldset class="fm-fieldset">
				<legend class="fm-legend">2 · A che punto sei oggi?</legend>
				<div class="lf__chips">
					{livelli.map((l, i) => (
						<label class="lf__chip">
							<input type="radio" name="livello" value={l} checked={i === 0} />
							<span>{l}</span>
						</label>
					))}
				</div>
			</fieldset>

			<fieldset class="fm-fieldset">
				<legend class="fm-legend">3 · Quanto vorresti allenarti?</legend>
				<div class="lf__chips">
					{frequenze.map((f, i) => (
						<label class="lf__chip">
							<input type="radio" name="frequenza" value={f} checked={i === 1} />
							<span>{f}</span>
						</label>
					))}
				</div>
			</fieldset>

			<div class="lf__grid">
				<div class="lf__field">
					<label for="fm-nome">Nome <span aria-hidden="true">*</span></label>
					<input id="fm-nome" name="nome" type="text" autocomplete="given-name" />
				</div>
				<div class="lf__field">
					<label for="fm-cognome">Cognome <span aria-hidden="true">*</span></label>
					<input id="fm-cognome" name="cognome" type="text" autocomplete="family-name" />
				</div>
				<div class="lf__field lf__field--full">
					<label for="fm-email">Email <span aria-hidden="true">*</span></label>
					<input id="fm-email" name="email" type="email" autocomplete="email" placeholder="nome@esempio.com" />
				</div>
				<div class="lf__field lf__field--full">
					<label for="fm-cellulare">Cellulare <span aria-hidden="true">*</span></label>
					<div class="lf__tel">
						<select id="fm-prefisso" class="lf__tel-prefisso" aria-label="Prefisso internazionale" autocomplete="tel-country-code">
							{prefissi.map((pf) => (
								<option value={pf.dial} selected={pf.dial === "+39"}>{pf.flag} {pf.dial}</option>
							))}
						</select>
						<input id="fm-cellulare" name="cellulare" type="tel" autocomplete="tel-national" placeholder="3XX XXX XXXX" />
					</div>
				</div>
				<div class="lf__field lf__field--full">
					<label for="fm-nascita">Data di nascita <span aria-hidden="true">*</span></label>
					<input id="fm-nascita" name="dataNascita" type="date" autocomplete="bday" />
				</div>
				<div class="lf__field lf__field--full">
					<label for="fm-messaggio">Qualcosa che dobbiamo sapere? <em>(facoltativo)</em></label>
					<textarea id="fm-messaggio" name="messaggio" rows="3" placeholder="Infortuni, orari in cui sei disponibile, esperienze precedenti…"></textarea>
				</div>
			</div>

			<div class="lf__consent">
				<label class="lf__consent-item">
					<input id="fm-privacy" name="privacy" type="checkbox" />
					<span>Ho letto e accetto la <a href={url("/privacy")} target="_blank">Privacy Policy</a>. <strong>(obbligatorio)</strong></span>
				</label>
				<label class="lf__consent-item">
					<input id="fm-marketing" name="marketing" type="checkbox" />
					<span>Acconsento a ricevere comunicazioni e novità da Ronchiverdi. <em>(facoltativo)</em></span>
				</label>
			</div>

			<p class="fm-nota">
				I dati che lasci qui vengono inoltrati al Fitness Manager del club: sarà lui a ricontattarti direttamente al telefono per fissare la prima consulenza.
			</p>

			<p class="lf__error" id="fm-error" hidden role="alert"></p>

			<button class="btn" type="submit" id="fm-invia">Richiedi la consulenza</button>
		</form>

		<div class="fm-confirm" id="fm-confirm" hidden>
			<div class="lf__confirm-check" aria-hidden="true">
				<svg width="24" height="24" viewBox="0 0 26 26" fill="none"><path d="M4 13L10 19L22 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</div>
			<h3>Richiesta <em class="accent">ricevuta!</em></h3>
			<p class="lede" style="margin-inline:auto" id="fm-confirm-text"></p>
		</div>

		<div class="fm-altro">
			<a class="btn btn-outline" href={url("/abbonamenti")}>Scopri gli abbonamenti</a>
			<button type="button" class="btn btn-outline" data-open-contact>Prenota un tour</button>
		</div>
	</section>

	<script>
		import { withTracking, trackLead } from "../../lib/tracking.client.js";

		// Stesso giro degli altri form inline (vedi servizi/chinesis.astro):
		// validazione in pagina, POST su /api/lead, conferma al posto del
		// modulo. Qui in piu' viaggiano le risposte del questionario, che
		// diventano le voci di `dettagli`, e la data di nascita.
		const fmForm = document.getElementById("fm-form");
		const fmErrore = document.getElementById("fm-error");
		const fmConferma = document.getElementById("fm-confirm");
		const fmConfermaTesto = document.getElementById("fm-confirm-text");
		const fmInvia = document.getElementById("fm-invia");

		function fmEmailValida(v) {
			return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
		}

		function fmTelefonoValido(v) {
			const cifre = v.replace(/[^0-9]/g, "");
			if (!/^[0-9\s-]+$/.test(v.trim())) return false;
			if (cifre.length < 6 || cifre.length > 14) return false;
			if (/^(\d)\1+$/.test(cifre)) return false;
			return true;
		}

		function fmErroreMostra(msg, elemento) {
			fmErrore.textContent = msg;
			fmErrore.hidden = false;
			if (elemento) elemento.focus();
		}

		function fmSelezionati(nome) {
			return Array.from(fmForm.querySelectorAll(`input[name="${nome}"]:checked`)).map(
				(i) => (i as HTMLInputElement).value
			);
		}

		fmForm?.addEventListener("submit", async (e) => {
			e.preventDefault();
			fmErrore.hidden = true;

			const nome = document.getElementById("fm-nome") as HTMLInputElement;
			const cognome = document.getElementById("fm-cognome") as HTMLInputElement;
			const email = document.getElementById("fm-email") as HTMLInputElement;
			const prefisso = document.getElementById("fm-prefisso") as HTMLSelectElement;
			const cellulare = document.getElementById("fm-cellulare") as HTMLInputElement;
			const nascita = document.getElementById("fm-nascita") as HTMLInputElement;
			const messaggio = document.getElementById("fm-messaggio") as HTMLTextAreaElement;
			const privacy = document.getElementById("fm-privacy") as HTMLInputElement;
			const marketing = document.getElementById("fm-marketing") as HTMLInputElement;

			const obiettiviScelti = fmSelezionati("obiettivo");
			if (!obiettiviScelti.length) return fmErroreMostra("Scegli almeno un obiettivo.");
			if (!nome.value.trim()) return fmErroreMostra("Inserisci il tuo nome.", nome);
			if (!cognome.value.trim()) return fmErroreMostra("Inserisci il tuo cognome.", cognome);
			if (!fmEmailValida(email.value)) return fmErroreMostra("Inserisci un indirizzo email valido.", email);
			if (!fmTelefonoValido(cellulare.value)) return fmErroreMostra("Inserisci un numero di cellulare valido.", cellulare);
			if (!nascita.value) return fmErroreMostra("Inserisci la tua data di nascita.", nascita);
			if (!privacy.checked) return fmErroreMostra("Il consenso alla Privacy Policy è obbligatorio.");

			fmInvia.disabled = true;
			fmInvia.textContent = "Invio in corso…";

			// Il questionario in una lista di righe leggibili: il CRM le mostra
			// cosi' come sono, senza dover sapere com'erano fatte le domande.
			const dettagli = [
				...obiettiviScelti.map((o) => `Obiettivo: ${o}`),
				...fmSelezionati("livello").map((l) => `Livello: ${l}`),
				...fmSelezionati("frequenza").map((f) => `Frequenza: ${f}`),
			];

			const datiLead = {
				origine: "fitness-manager-inline",
				pagina: location.pathname,
				cta: "Consulenza con il Fitness Manager",
				nome: nome.value.trim(),
				cognome: cognome.value.trim(),
				email: email.value.trim(),
				cellulare: `${prefisso.value} ${cellulare.value.trim()}`,
				dataNascita: nascita.value,
				dettagli,
				messaggio: messaggio.value.trim(),
				privacy: privacy.checked,
				marketing: marketing.checked,
			};

			try {
				const res = await fetch("/api/lead", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(withTracking(datiLead)),
				});
				if (!res.ok) throw new Error("request failed");
				trackLead(datiLead);
			} catch {
				fmInvia.disabled = false;
				fmInvia.textContent = "Richiedi la consulenza";
				return fmErroreMostra("Non siamo riusciti a inviare la richiesta. Riprova, oppure chiamaci direttamente.");
			}

			fmConfermaTesto.textContent = `Grazie ${nome.value.trim()}, la tua richiesta è arrivata al Fitness Manager: ti richiamerà al numero che ci hai lasciato per fissare la prima consulenza.`;
			fmForm.hidden = true;
			fmConferma.hidden = false;
		});

		document.querySelectorAll(".pt-card").forEach((card) => {
			const toggle = () => card.classList.toggle("is-open");
			card.addEventListener("click", (e) => {
				if ((e.target as HTMLElement).closest("a")) return;
				toggle();
			});
			card.addEventListener("keydown", (e) => {
				if ((e.target as HTMLElement).closest("a")) return;
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					toggle();
				}
			});
		});
	</script>

	<style>
		.intro {
			max-width: 52rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 1rem;
			text-align: center;
		}
		.intro .lede {
			max-width: none;
		}

		.team {
			max-width: 88rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 6rem;
		}
		.team__head {
			max-width: 42rem;
			margin: 0 auto 3rem;
			text-align: center;
		}

		.pt-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
		}

		.pt-card {
			position: relative;
			aspect-ratio: 3 / 4;
			border-radius: 20px;
			background: var(--bg-dark);
			box-shadow: 0 0 22px rgba(28, 28, 24, 0.22);
			cursor: pointer;
			transform: translateY(0) scale(1);
			transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.pt-card:hover,
		.pt-card.is-open,
		.pt-card:focus-visible {
			transform: translateY(-8px) scale(1.015);
			box-shadow: 0 0 34px rgba(28, 28, 24, 0.3);
		}
		.pt-card:focus-visible {
			outline: 2px solid var(--accent-on-dark);
			outline-offset: 3px;
		}
		.pt-card__clip {
			position: absolute;
			inset: 0;
			border-radius: 20px;
			overflow: hidden;
		}
		.pt-card__img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform 0.5s ease;
		}
		.pt-card:hover .pt-card__img,
		.pt-card.is-open .pt-card__img {
			transform: scale(1.06);
		}
		.pt-card__scrim {
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, rgba(28, 28, 24, 0) 38%, rgba(28, 28, 24, 0.86) 74%, rgba(28, 28, 24, 1) 92%);
			transition: background 0.35s ease;
		}
		.pt-card:hover .pt-card__scrim,
		.pt-card.is-open .pt-card__scrim {
			background: linear-gradient(180deg, rgba(28, 28, 24, 0.25) 0%, rgba(28, 28, 24, 0.94) 60%, rgba(28, 28, 24, 1) 92%);
		}
		.pt-card__body {
			position: absolute;
			inset: 0;
			z-index: 1;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 1.35rem;
		}
		.pt-card__name {
			display: block;
			font-family: var(--font-serif);
			font-weight: 500;
			font-size: var(--text-xl);
			color: var(--text-on-dark);
			line-height: 1.15;
		}
		.pt-card__role {
			display: block;
			margin-top: 2px;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
