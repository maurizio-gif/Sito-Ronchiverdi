---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Faq from "../../../components/Faq.astro";
import { faqDiPagina } from "../../../data/faq";
import { url } from "../../../lib/paths";
import ModalitaIscrizioneTennis from "../../../components/ModalitaIscrizioneTennis.astro";
import { euro } from "../../../lib/formato";
import { getPercorsi, prezzoDa } from "../../../lib/listiniSport";
import "../../../styles/iscrizione.css";

// Stesso impianto della pagina di iscrizione alla scuola nuoto: prima le due
// porte del portale InforYou, poi i passaggi e i documenti. Qui però il
// percorso comincia da una lezione di prova, che resta la seconda CTA.

const percorsi = await getPercorsi("tennis");

const faq = faqDiPagina("tennis-iscrizione");
---

<Layout
	title="Modalità di iscrizione — Tennis Ronchiverdi"
	description="Come iscriversi al settore tennis di Ronchiverdi: iscrizione online, lezione di prova, documenti necessari, tesseramento FITP e contatti."
	image="og/tennis.jpg"
>
	<PageHero
		image="images/attivita/tennis-hero.jpg"
		imageAlt="Scambio sui campi da tennis in terra rossa di Ronchiverdi"
		eyebrow="Tennis · Iscrizione"
	>
		<Fragment slot="title">Modalità di <em class="accent">iscrizione</em></Fragment>
		<Fragment slot="lede">Che tu voglia iscrivere tuo figlio alla Young School o riprendere a giocare da adulto, si parte sempre da una lezione di prova.</Fragment>
		<div class="header-cta">
			<a class="btn" href="#iscriviti">Iscriviti online</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="corsi-tennis">Richiedi una prova gratuita</button>
		</div>
	</PageHero>

	<section class="isc-section" id="iscriviti">
		<div class="isc-head">
			<span class="eyebrow">Quote e iscrizione</span>
			<h2>Parti dal tuo percorso</h2>
			<p class="isc-head__lede">
				Ogni percorso ha il suo listino, con il tesseramento FITP compreso e un
				prezzo dedicato ai soci del club. Apri il tuo per vedere le quote per
				frequenza e il link all'iscrizione online.
			</p>
		</div>
		<div class="percorsi-cards">
			{percorsi.map((p) => (
				<a class="percorso-card" href={url(`/attivita/tennis/iscrizione/${p.slug}`)}>
					<span class="percorso-card__eta">{p.eyebrow}</span>
					<span class="percorso-card__nome">{p.title}</span>
					<span class="percorso-card__prezzo">da {euro(prezzoDa(p))}</span>
					<span class="percorso-card__vai">
						Quote e iscrizione
						<svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true"><path d="M1 7h15M10 1l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</span>
				</a>
			))}
		</div>
		<p class="isc-note isc-note--center">
			Il prezzo indicato è il più basso del percorso, riservato ai soci: dentro
			trovi tutte le frequenze, per soci e non soci.
		</p>
	</section>

	<ModalitaIscrizioneTennis />

	<section class="isc-section isc-contatti">
		<div class="isc-head">
			<span class="eyebrow">Settore tennis</span>
			<h2>Parlane con noi</h2>
			<p class="isc-head__lede">
				Per organizzare la lezione di prova, chiedere informazioni sui percorsi
				o completare l'iscrizione, compila il modulo di contatto: ti risponde
				il settore tennis.
			</p>
		</div>
		<button type="button" class="btn" data-open-contact data-interest="corsi-tennis">Contattaci</button>
	</section>

	<Faq items={faq} misura="72rem" />

	<section class="final-cta">
		<h2>Pronto a iniziare?</h2>
		<p class="lede" style="margin-inline:auto">Contattaci: ti aiutiamo a organizzare la tua lezione di prova.</p>
		<button type="button" class="btn" data-open-contact data-interest="corsi-tennis">Contattaci</button>
	</section>

	<style>
		.percorsi-cards {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
		}
		.percorso-card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1.5rem 1.4rem;
			border: 1px solid var(--border-strong);
			border-radius: var(--radius);
			background: var(--bg-alt);
			text-decoration: none;
			transition: border-color 0.16s ease, transform 0.16s ease;
		}
		.percorso-card:hover {
			border-color: var(--accent);
			transform: translateY(-2px);
		}
		.percorso-card__eta {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.percorso-card__nome {
			font-family: var(--font-serif);
			font-size: var(--text-xl);
			line-height: var(--leading-lg);
			color: var(--text);
		}
		.percorso-card__prezzo {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
		}
		.percorso-card__vai {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			margin-top: 0.9rem;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--text);
		}
		@media (max-width: 900px) {
			.percorsi-cards {
				grid-template-columns: minmax(0, 1fr);
			}
		}

		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		/* Apre la stessa modale del resto del sito, ma dentro una frase: deve
		   sembrare un link, non un pulsante. */
		.isc-link {
			padding: 0;
			border: none;
			background: none;
			font: inherit;
			font-weight: 600;
			color: var(--text);
			text-decoration: underline;
			text-underline-offset: 0.15em;
			cursor: pointer;
		}
		.isc-link:hover {
			color: var(--accent);
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta h2 {
			margin-bottom: 1rem;
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
	</style>
</Layout>
