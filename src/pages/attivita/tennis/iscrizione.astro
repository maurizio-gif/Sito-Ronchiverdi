---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Faq from "../../../components/Faq.astro";
import { faqDiPagina } from "../../../data/faq";
import "../../../styles/iscrizione.css";

// Stesso impianto della pagina di iscrizione alla scuola nuoto: prima le due
// porte del portale InforYou, poi i passaggi e i documenti. Qui però il
// percorso comincia da una lezione di prova, che resta la seconda CTA.

// Il negozio InforYou distingue le due platee: categorie diverse, listini diversi.
const percorsi = [
	{
		label: "Non soci",
		desc: "Il listino dedicato a chi non ha un abbonamento Ronchiverdi.",
		href: "https://inforyou.teamsystem.com/ronchiverdi/store/2/category/3",
	},
	{
		label: "Soci del club",
		desc: "Il listino riservato a chi ha un abbonamento Ronchiverdi attivo.",
		href: "https://inforyou.teamsystem.com/ronchiverdi/store/2/category/13",
	},
];

const procedura = [
	{
		title: "Prenota la prova",
		desc: "Gratuita. Indica età e livello per la Young School, la tua disponibilità se giochi da adulto.",
	},
	{
		title: "Trova il tuo gruppo",
		desc: "In base al livello emerso durante la prova ti inseriamo nel gruppo o ti abbiniamo al maestro più adatto.",
	},
	{
		title: "Perfeziona l'iscrizione",
		desc: "Dal portale online, oppure in reception con lo staff del settore tennis.",
	},
];

const documenti = [
	{
		title: "Certificato medico",
		desc: "Di idoneità sportiva non agonistica; agonistica per chi entra nel Settore Agonistico o ha già la tessera atleta.",
	},
	{
		title: "Tesseramento FITP",
		desc: "Non agonistico, incluso nella quota d'iscrizione.",
	},
];

const calendario = [
	{
		title: "Young School",
		desc: "Dal <strong>14 settembre 2026</strong> al <strong>4 giugno 2027</strong>.",
	},
	{
		title: "Summer Tennis",
		desc: "In estate l'attività continua, con iscrizione settimanale.",
	},
];

const faq = faqDiPagina("tennis-iscrizione");
---

<Layout
	title="Modalità di iscrizione — Tennis Ronchiverdi"
	description="Come iscriversi al settore tennis di Ronchiverdi: iscrizione online, lezione di prova, documenti necessari, tesseramento FITP e contatti."
	image="og/tennis.jpg"
>
	<PageHero
		image="images/attivita/tennis-hero.jpg"
		imageAlt="Scambio sui campi da tennis in terra rossa di Ronchiverdi"
		eyebrow="Tennis"
	>
		<Fragment slot="title">Modalità di <em class="accent">iscrizione</em></Fragment>
		<Fragment slot="lede">Che tu voglia iscrivere tuo figlio alla Young School o riprendere a giocare da adulto, si parte sempre da una lezione di prova.</Fragment>
		<div class="header-cta">
			<a class="btn" href="#iscriviti">Iscriviti online</a>
			<button type="button" class="btn btn-outline" data-open-contact>Richiedi una prova gratuita</button>
		</div>
	</PageHero>

	<section class="isc-section" id="iscriviti">
		<div class="isc-head">
			<span class="eyebrow">Iscrizione online</span>
			<h2>Due percorsi, un solo portale</h2>
			<p class="isc-head__lede">
				L'iscrizione si completa su InforYou, il portale del club. Scegli la
				voce che ti riguarda: cambia il listino, non la procedura.
			</p>
		</div>
		<div class="isc-cards">
			{percorsi.map((p) => (
				<article class="isc-card">
					<span class="isc-card__label">{p.label}</span>
					<p class="isc-card__desc">{p.desc}</p>
					<a class="btn isc-card__btn" href={p.href} target="_blank" rel="noopener">
						Iscrizione e pagamento
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 10L10 4M10 4H5M10 4v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				</article>
			))}
		</div>
	</section>

	<section class="isc-section" id="come-funziona">
		<div class="isc-head">
			<span class="eyebrow">Tre passaggi</span>
			<h2>Come funziona</h2>
		</div>
		<ol class="isc-steps">
			{procedura.map((s, i) => (
				<li class="isc-step">
					<span class="isc-step__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
					<h3>{s.title}</h3>
					<p>{s.desc}</p>
				</li>
			))}
		</ol>
		<p class="isc-note">
			La lezione di prova è gratuita e si organizza dal <button type="button" class="isc-link" data-open-contact>modulo di contatto</button>:
			ti risponde il settore tennis.
		</p>
	</section>

	<section class="isc-section isc-section--alt">
		<div class="isc-duo">
			<div>
				<div class="isc-head isc-head--left">
					<span class="eyebrow">Documenti</span>
					<h2>Cosa serve preparare</h2>
				</div>
				<dl class="isc-list">
					{documenti.map((d) => (
						<div class="isc-list__row">
							<dt>{d.title}</dt>
							<dd>{d.desc}</dd>
						</div>
					))}
				</dl>
				<p class="isc-note">Tesseramento e certificato vanno completati prima dell'inizio dei corsi.</p>
			</div>
			<div>
				<div class="isc-head isc-head--left">
					<span class="eyebrow">Calendario</span>
					<h2>Quando si comincia</h2>
				</div>
				<dl class="isc-list">
					{calendario.map((c) => (
						<div class="isc-list__row">
							<dt>{c.title}</dt>
							<dd set:html={c.desc} />
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="isc-section isc-contatti">
		<div class="isc-head">
			<span class="eyebrow">Settore tennis</span>
			<h2>Parlane con noi</h2>
			<p class="isc-head__lede">
				Per organizzare la lezione di prova, chiedere informazioni sui percorsi
				o completare l'iscrizione, compila il modulo di contatto: ti risponde
				il settore tennis.
			</p>
		</div>
		<button type="button" class="btn" data-open-contact>Contattaci</button>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Pronto a iniziare?</h2>
		<p class="lede" style="margin-inline:auto">Contattaci: ti aiutiamo a organizzare la tua lezione di prova.</p>
		<button type="button" class="btn" data-open-contact>Contattaci</button>
	</section>

	<style>
		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		/* Apre la stessa modale del resto del sito, ma dentro una frase: deve
		   sembrare un link, non un pulsante. */
		.isc-link {
			padding: 0;
			border: none;
			background: none;
			font: inherit;
			font-weight: 600;
			color: var(--text);
			text-decoration: underline;
			text-underline-offset: 0.15em;
			cursor: pointer;
		}
		.isc-link:hover {
			color: var(--accent);
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta h2 {
			margin-bottom: 1rem;
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
	</style>
</Layout>
