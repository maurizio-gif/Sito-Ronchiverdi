---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Faq from "../../../components/Faq.astro";
import { url } from "../../../lib/paths";
import { EMAIL_CERTIFICATI, INVIO_AGONISTICO, INVIO_NON_AGONISTICO } from "../../../data/certificatoMedico";
import { faqDiPagina } from "../../../data/faq";
import ListinoCorsi from "../../../components/ListinoCorsi.astro";
import MembershipTable from "../../../components/MembershipTable.astro";
import { getListinoAggiornatoAl, getPercorso } from "../../../lib/listiniSport";
import "../../../styles/iscrizione.css";

// Ogni card chiude sul punto che qui conta più di tutti: quanto si paga e
// dove. Le tre categorie rispondono in tre modi diversi: la Young School ha
// un listino a frequenza e si acquista online sul portale; l'Academy ha una
// quota annuale unica che non passa dal portale; l'Age Group Senior Master
// non ha una quota corso e segue il listino degli abbonamenti al Club.
const categorie = [
	{
		eyebrow: "6–13 anni",
		title: "Young School",
		desc: "L'iscrizione si effettua online dal sito Ronchiverdi: si consultano le disponibilità, si sceglie il programma da 1, 2 o 3 allenamenti settimanali e si completa la procedura.",
		punti: [
			"Iscrizione online dal sito",
			"Prima settimana di attività dedicata alle prove gratuite",
			"La quota comprende i tesseramenti FITRI e FIDAL",
		],
		quota: {
			label: "Quota del corso",
			testo: "Listino a 1, 2 o 3 allenamenti settimanali, acquisto online",
			linkLabel: "Vedi le quote",
			href: "#listino",
		},
		anchor: "#young",
	},
	{
		eyebrow: "14–23 anni",
		title: "Academy",
		desc: "L'iscrizione si effettua presso la Reception del Club, dove i tecnici definiscono il gruppo. Prima di iscriversi è possibile partecipare a una lezione di prova, per conoscere i tecnici e l'organizzazione degli allenamenti.",
		punti: [
			"Iscrizione presso la Reception del Club",
			"Lezione di prova su richiesta",
			"La quota comprende il tesseramento FITRI e ha validità annuale",
		],
		quota: {
			label: "Quota del corso",
			testo: "1.200 € all'anno, non acquistabile online: si versa in Reception",
			linkLabel: "Vedi la quota",
			href: "#quota-academy",
		},
		anchor: "#academy",
	},
	{
		eyebrow: "Dai 23 anni",
		title: "Age Group Senior Master",
		desc: "L'attività della squadra è riservata ai soci del club e l'iscrizione si completa in Reception. Anche qui è possibile partecipare a una lezione di prova prima di entrare nel gruppo.",
		punti: [
			"Iscrizione presso la Reception del Club",
			"Lezione di prova su richiesta",
			"Tesseramento FITRI per attività di squadra e gare",
		],
		quota: {
			label: "Abbonamento al Club",
			testo: "Nessuna quota corso: vale il listino degli abbonamenti soci",
			linkLabel: "Vedi gli abbonamenti",
			href: "#abbonamento",
		},
		anchor: "#master",
	},
];

// L'estratto della tabella abbonamenti: solo Gold e Silver, gli unici due
// piani che comprendono il triathlon, e solo le voci che servono a un
// triatleta. Le etichette devono esistere in memberships/tabella.json.
const pianiTriathlon = ["gold", "silver"];
const vociTriathlon = ["Triathlon", "Nuoto Libero", "Gym Floor", "Piscina Estiva", "Spa"];

const procedura = [
	{
		title: "Scegli la categoria",
		desc: "Young School dai 6 ai 13 anni, Academy dai 14 ai 23, Age Group Senior Master dai 23 in su: se hai dubbi sul gruppo giusto, chiedi a noi.",
	},
	{
		title: "Prova un allenamento",
		desc: "Nella Young School la prima settimana è di prove gratuite; per Academy e Age Group Senior Master la lezione di prova si concorda su richiesta.",
	},
	{
		title: "Completa l'iscrizione",
		desc: "Per la Young School si acquista il programma dal listino, online sul portale InforYou. Academy e Age Group Senior Master passano dalla Reception del Club: là si versa la quota dell'Academy o si attiva l'abbonamento, e si sistema il tesseramento federale.",
	},
];

const documenti = [
	`Certificato medico non agonistico in corso di validità per la Young School fino agli 11 anni. ${INVIO_NON_AGONISTICO}`,
	`Certificato medico agonistico dai 12 anni della Young School, e sempre per Academy e Age Group Senior Master, dove è obbligatorio anche per il tesseramento federale. ${INVIO_AGONISTICO}`,
	"Tesseramento FITRI, compreso nella quota per Young School e Academy.",
	"Tesseramento FIDAL, compreso nella quota della Young School.",
];


// Sul portale è in vendita la sola Young School, e solo di quella si può
// mostrare il listino con i link ai prodotti: la quota dell'Academy e gli
// abbonamenti dell'Age Group Senior Master hanno una sezione loro, più sotto.
const young = await getPercorso("triathlon");
const aggiornatoAl = await getListinoAggiornatoAl("triathlon");
const faq = faqDiPagina("triathlon-iscrizione");
---

<Layout
	title="Modalità di iscrizione — Triathlon Ronchiverdi"
	description="Come iscriversi al triathlon Ronchiverdi: Young School, Academy e Age Group Senior Master, con lezione di prova, documenti necessari e tesseramenti FITRI e FIDAL."
	image="og/triathlon.jpg"
>
	<PageHero image="images/activities/triathlon.jpg" imageAlt="Atleta di triathlon in gara" eyebrow="Triathlon · Iscrizione">
		<Fragment slot="title">Modalità di <em class="accent">iscrizione</em></Fragment>
		<Fragment slot="lede">Young School, Academy e Age Group Senior Master hanno procedure e quote diverse: solo la Young School si acquista online. Qui trovi come funziona ognuna, quanto costa e dove si versa.</Fragment>
		<div class="header-cta">
			<a class="btn" href="#listino">Quote e abbonamenti</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="triathlon-young">Contattaci</button>
		</div>
	</PageHero>

	<section class="isc-section">
		<div class="isc-head">
			<span class="eyebrow">Le tre categorie</span>
			<h2>I tre percorsi</h2>
			<p class="isc-head__lede">
				Cambia il modo di allenarsi, e cambia anche il modo di pagare: la
				<strong>Young School</strong> ha un listino a frequenza e si acquista
				online, l'<strong>Academy</strong> una quota annuale unica che si
				versa in Reception, l'<strong>Age Group Senior Master</strong> nessuna
				quota corso — là vale il listino degli abbonamenti al Club.
			</p>
		</div>
		<div class="cat-grid">
			{categorie.map((c) => (
				<article class="cat-card">
					<span class="eyebrow">{c.eyebrow}</span>
					<h3>{c.title}</h3>
					<p class="cat-card__desc">{c.desc}</p>
					<ul class="cat-card__punti">
						{c.punti.map((p) => (
							<li>
								<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
								<span>{p}</span>
							</li>
						))}
					</ul>
					<div class="cat-card__quota">
						<span class="cat-card__quota-label">{c.quota.label}</span>
						<p class="cat-card__quota-testo">{c.quota.testo}</p>
						<a class="cat-card__quota-link" href={c.quota.href}>{c.quota.linkLabel} →</a>
					</div>
					<a class="cat-card__link" href={url(`/attivita/triathlon${c.anchor}`)}>Scopri il percorso →</a>
				</article>
			))}
		</div>
	</section>

	<section class="isc-section isc-section--alt" id="listino">
		<div class="isc-head">
			<span class="eyebrow">Quote {young.title} · 6–13 anni</span>
			<h2>Quanto costa la Young School</h2>
			<p class="isc-head__lede">
				È l'unico percorso con un listino corso e l'acquisto online: si sceglie
				il programma da 1, 2 o 3 allenamenti e si completa tutto sul portale
				InforYou. La quota comprende i tesseramenti FITRI e FIDAL, e con un
				abbonamento Ronchiverdi attivo vale il listino soci.
			</p>
		</div>
		<ListinoCorsi
			colonna="Frequenza"
			righe={young.listino}
			dettagli={young.dettagli}
			aggiornatoAl={aggiornatoAl}
		/>
		<p class="isc-note isc-note--center">
			Cerchi le quote delle altre due categorie? Non sono in questo listino e
			non passano dal portale: <a href="#quota-academy">la quota dell'Academy</a>
			si versa in Reception, e per l'Age Group Senior Master
			<a href="#abbonamento">vale il listino degli abbonamenti</a>.
		</p>
	</section>

	<section class="isc-section" id="quota-academy">
		<div class="isc-head">
			<span class="eyebrow">Quota Academy · 14–23 anni</span>
			<h2>Una quota unica per la stagione</h2>
			<p class="isc-head__lede">
				L'Academy non ha un listino a frequenza: gli allenamenti sono
				distribuiti su tutta la settimana e la quota è una sola, per l'intera
				stagione. Non è in vendita sul portale InforYou — si versa in
				Reception, dove si completa anche l'iscrizione.
			</p>
		</div>
		<div class="quota-card">
			<span class="quota-card__label">Quota annuale</span>
			<p class="quota-card__prezzo">1.200<span class="quota-card__valuta">€</span></p>
			<ul class="quota-card__punti">
				<li>Validità annuale, per l'intera stagione sportiva</li>
				<li>Comprende il tesseramento FITRI</li>
				<li>Comprende l'accesso al club sette giorni su sette, anche fuori dagli orari di allenamento</li>
				<li>Si versa in Reception: non è acquistabile online</li>
			</ul>
			<button type="button" class="btn" data-open-contact data-interest="triathlon-young">Richiedi informazioni</button>
		</div>
	</section>

	<section class="isc-section isc-section--alt" id="abbonamento">
		<div class="isc-head">
			<span class="eyebrow">Quote Age Group Senior Master · dai 23 anni</span>
			<h2>Vale il listino degli abbonamenti</h2>
			<p class="isc-head__lede">
				Qui non c'è una quota corso: l'attività della squadra è compresa
				nell'abbonamento al Club, e il prezzo è quello. Gli unici due piani
				che comprendono il triathlon sono <strong>Gold</strong> e
				<strong>Silver</strong>, perché sono quelli con piscina e palestra
				insieme.
			</p>
		</div>
		<MembershipTable piani={pianiTriathlon} voci={vociTriathlon} planCtaLabel="Richiedi l'abbonamento" />
		<p class="isc-note isc-note--center">
			Qui sopra le voci che servono a un triatleta. Il confronto completo dei
			quattro piani, Gym e Swim compresi, è nella pagina <a href={url("/abbonamenti")}>abbonamenti</a>. Il tesseramento FITRI resta necessario e si
			sistema in Reception insieme all'iscrizione; il certificato medico
			agonistico si invia a <a href={`mailto:${EMAIL_CERTIFICATI}`}>{EMAIL_CERTIFICATI}</a> e l'originale va consegnato al
			responsabile del settore.
		</p>
	</section>

	<section class="isc-section">
		<div class="isc-head">
			<span class="eyebrow">Tre passaggi</span>
			<h2>Come ci si iscrive</h2>
		</div>
		<ol class="isc-steps">
			{procedura.map((s, i) => (
				<li class="isc-step">
					<span class="isc-step__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
					<h3>{s.title}</h3>
					<p>{s.desc}</p>
				</li>
			))}
		</ol>
		<p class="isc-note">
			Academy e Age Group Senior Master non si iscrivono online: si passa dalla Reception del
			Club, oppure ci si scrive e organizziamo tutto noi.
		</p>
	</section>

	<section class="isc-section isc-section--alt">
		<div class="isc-duo">
			<div>
				<div class="isc-head isc-head--left">
					<span class="eyebrow">Documenti</span>
					<h2>Cosa serve preparare</h2>
				</div>
				<ul class="plain-list">
					{documenti.map((d) => <li set:html={d} />)}
				</ul>
				<p class="isc-note">Il certificato va mandato prima dell'inizio dell'attività: senza, non è possibile partecipare agli allenamenti.</p>
			</div>
			<div>
				<div class="isc-head isc-head--left">
					<span class="eyebrow">Prima di decidere</span>
					<h2>Prova prima di iscriverti</h2>
				</div>
				<p class="isc-testo">Nella Young School la <strong>prima settimana di attività</strong> è dedicata alle lezioni di prova gratuite: i ragazzi conoscono i tecnici e sperimentano nuoto, ciclismo e corsa.</p>
				<p class="isc-testo">Per <strong>Academy</strong> e <strong>Age Group Senior Master</strong> la lezione di prova si concorda su richiesta.</p>
			</div>
		</div>
	</section>

	<section class="isc-section isc-contatti">
		<div class="isc-head">
			<span class="eyebrow">Settore triathlon</span>
			<h2>Parlane con noi</h2>
			<p class="isc-head__lede">
				Per organizzare la lezione di prova, chiedere informazioni sui percorsi
				o completare l'iscrizione, scrivici: ti risponde il settore triathlon.
			</p>
		</div>
		<div class="tri-azioni">
			<button type="button" class="btn" data-open-contact data-interest="triathlon-young">Richiedi informazioni</button>
		</div>
	</section>

	<Faq items={faq} misura="72rem" />

	<section class="final-cta">
		<h2>Pronto a partire?</h2>
		<p class="lede" style="margin-inline:auto">Scrivici: ti aiutiamo a capire quale percorso è adatto e a organizzare la prova.</p>
		<div class="final-cta__buttons">
			<button type="button" class="btn" data-open-contact data-interest="triathlon-young">Contattaci</button>
			<a class="btn btn-outline" href={url("/attivita/triathlon")}>Torna al triathlon</a>
		</div>
	</section>

	<style>
		.header-cta {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			margin-top: 0;
		}

		.cat-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.75rem;
		}
		.cat-card {
			display: flex;
			flex-direction: column;
			background: var(--bg-alt);
			border: 1px solid var(--border);
			border-radius: 16px;
			padding: 1.9rem 1.75rem 2rem;
		}
		/* Il nome del percorso è in serif come nelle card di nuoto e tennis. */
		.cat-card h3 {
			margin: 0.3rem 0 0.9rem;
			font-family: var(--font-serif);
			font-size: var(--text-xl);
			line-height: var(--leading-lg);
			font-weight: 400;
		}
		.cat-card__desc {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.65;
			margin: 0 0 1.1rem;
		}
		.cat-card__punti {
			list-style: none;
			margin: 0 0 1.25rem;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text);
			line-height: 1.45;
		}
		.cat-card__punti li {
			display: flex;
			align-items: flex-start;
			gap: 0.55rem;
		}
		.cat-card__punti li svg {
			flex-shrink: 0;
			margin-top: 0.2rem;
			color: var(--accent);
		}
		/* Il blocco quota è la risposta alla domanda per cui si arriva su questa
		   pagina: sta in fondo a ogni card, staccato dal resto da un filo, e
		   allineato fra le tre colonne dal margin-top: auto. */
		.cat-card__quota {
			margin-top: auto;
			padding-top: 1.1rem;
			border-top: 1px solid var(--border);
		}
		.cat-card__quota-label {
			display: block;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 700;
			letter-spacing: 0.07em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.cat-card__quota-testo {
			margin: 0.4rem 0 0.7rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			line-height: 1.5;
			color: var(--text);
		}
		.cat-card__quota-link,
		.cat-card__link {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--text);
			text-decoration: none;
		}
		.cat-card__quota-link:hover,
		.cat-card__link:hover {
			color: var(--accent);
		}
		.cat-card__link {
			margin-top: 1.1rem;
			color: var(--text-muted);
			font-weight: 500;
		}

		/* La tabella porta con sé il suo respiro verticale: dentro una sezione
		   che ne ha già, va azzerato. */
		#abbonamento :global(.compare) {
			padding: 0;
			max-width: none;
		}

		/* La quota dell'Academy è un numero solo, e non passa dal portale:
		   niente tabella e niente prezzi cliccabili, solo la cifra e cosa
		   comprende. */
		.quota-card {
			max-width: 34rem;
			margin: 0 auto;
			padding: 2.25rem 2rem 2.5rem;
			background: var(--bg-alt);
			border: 1px solid var(--border);
			border-radius: 16px;
			text-align: center;
		}
		.quota-card__label {
			display: block;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 700;
			letter-spacing: 0.07em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.quota-card__prezzo {
			margin: 0.5rem 0 1.5rem;
			font-family: var(--font-serif);
			font-size: var(--text-3xl);
			line-height: 1;
			font-weight: 600;
			color: var(--text);
		}
		.quota-card__valuta {
			/* Ridotto e staccato di poco: attaccato alla cifra sembra una
			   cifra in più, e con uno spazio pieno sembra un'altra parola. */
			margin-left: 0.12em;
			font-size: 0.5em;
			font-weight: 500;
			color: var(--text-muted);
		}
		.quota-card__punti {
			list-style: none;
			margin: 0 0 1.9rem;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			line-height: 1.55;
			color: var(--text-muted);
			text-align: left;
		}
		.quota-card__punti li {
			padding-left: 1.1rem;
			position: relative;
		}
		.quota-card__punti li::before {
			content: "—";
			position: absolute;
			left: 0;
			color: var(--accent);
		}
		.quota-card .btn {
			cursor: pointer;
			font-family: var(--font-sans);
			border: none;
		}
		/* Stessa soglia del resto delle pagine di iscrizione: la pagina cambia
		   impaginazione tutta insieme. */
		@media (max-width: 860px), (orientation: portrait) {
			.cat-grid {
				grid-template-columns: 1fr;
			}
		}

		.plain-list {
			list-style: none;
			margin: 0 0 1rem;
			padding: 0;
			font-family: var(--font-sans);
			color: var(--text-muted);
			line-height: 1.7;
		}
		.plain-list li {
			padding-left: 1.1rem;
			position: relative;
		}
		.plain-list li::before {
			content: "—";
			position: absolute;
			left: 0;
			color: var(--accent);
		}
		.tri-azioni {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 1rem;
		}
		.tri-azioni .btn {
			cursor: pointer;
			font-family: var(--font-sans);
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
		.final-cta__buttons {
			display: flex;
			gap: 1rem;
			justify-content: center;
			flex-wrap: wrap;
		}
		.final-cta__buttons .btn {
			cursor: pointer;
			font-family: var(--font-sans);
			border: none;
		}
		.final-cta__buttons .btn-outline {
			border: 1px solid currentColor;
		}
	</style>
</Layout>
