---
import Layout from "../../layouts/Layout.astro";
import ContactModal from "../../components/ContactModal.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import { url } from "../../lib/paths";

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "La location",
		html: "<strong>Tre piscine</strong>, la palestra e il Lungo Po appena fuori dal cancello: si parte in bici direttamente dal club, senza attraversare il traffico di Torino, e la collina è a pochi minuti.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.5L12 15.8 7.1 18.2l.9-5.5-4-3.9L9.5 8 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Squadra federale",
		html: "Squadra iscritta alla <strong>FITRI</strong> con oltre <strong>200 triatleti</strong> e un settore giovanile tra i più numerosi d'Italia, ai vertici delle classifiche nazionali.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7.5" r="3.5" stroke="currentColor" stroke-width="1.5" /><path d="M4.5 20c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Tecnici federali",
		html: "Tutti gli allenamenti, dai 6 anni in avanti, sono guidati esclusivamente da <strong>tecnici federali</strong>: stesso metodo e stessa cura in tutte e tre le categorie.",
	},
];

const youngProgrammi = [
	{
		title: "1 allenamento",
		ore: "2 ore a settimana",
		desc: "Il primo passo nel triathlon: una seduta a settimana per conoscere le tre discipline senza stravolgere gli altri impegni.",
		dettagli: ["Giorno a scelta tra lunedì, mercoledì, giovedì e venerdì", "Gruppi per età e livello"],
	},
	{
		title: "2 allenamenti",
		ore: "4 ore a settimana",
		desc: "Il ritmo più frequente: due sedute permettono di alternare le discipline e di costruire continuità nel corso della stagione.",
		dettagli: ["Giorni a scelta tra lunedì, mercoledì, giovedì e venerdì", "Alternanza tra nuoto, ciclismo e corsa"],
	},
	{
		title: "3 allenamenti",
		ore: "6 ore a settimana",
		desc: "Per chi vuole allenarsi con costanza e affrontare la stagione di gare con una preparazione più completa.",
		dettagli: ["Tre giorni tra lunedì, mercoledì, giovedì e venerdì", "Preparazione più completa in vista delle gare"],
	},
];

const academyCards = [
	{
		eyebrow: "Allenamenti quotidiani",
		title: "Ci si allena tutta la settimana",
		desc: "A differenza della Young School, l'Academy non è un corso a giorni fissi: gli allenamenti si svolgono durante tutta la settimana, secondo il programma definito dai tecnici. Frequenza e carico di lavoro cambiano in base al periodo della stagione, al livello di preparazione e agli obiettivi. Il lavoro comprende preparazione atletica, esercitazioni tecniche, lavori specifici e sedute personalizzate, con ore e corsie dedicate agli atleti.",
	},
	{
		eyebrow: "Programmazione individuale",
		title: "Un piano costruito su ogni atleta",
		desc: "Ogni atleta segue una programmazione individuale elaborata dai tecnici sulla base del livello di preparazione, degli obiettivi personali e agonistici, del calendario delle competizioni e del periodo della stagione. Il programma viene aggiornato man mano, in base ai progressi e alle esigenze di chi lo segue.",
	},
	{
		eyebrow: "Gare e campionati",
		title: "Dai circuiti giovanili ai Campionati Italiani",
		desc: "Durante la stagione gli atleti possono partecipare a gare giovanili di triathlon, duathlon, acquathlon e corsa, fino ai Campionati Italiani FITRI e alle principali competizioni del calendario nazionale. I tecnici sono presenti sui campi gara per assistere gli atleti. L'Academy resta aperta anche a chi vuole migliorare le proprie prestazioni senza puntare necessariamente all'alto livello.",
	},
];

const masterCards = [
	{
		eyebrow: "Gli allenamenti",
		title: "Di gruppo, tutta la settimana",
		desc: "Nuoto, ciclismo, corsa, preparazione atletica, spinning e sessioni sui rulli: le attività sono distribuite lungo tutta la settimana e ognuno sceglie quelle più adatte ai propri impegni e obiettivi. Entrando nel programma si entra nella squadra Triathlon Ronchiverdi e ci si allena prevalentemente in gruppo.",
	},
	{
		eyebrow: "Programmi personalizzati",
		title: "Anche con lavoro e famiglia",
		desc: "I tecnici possono predisporre una programmazione individuale che tiene conto del livello di preparazione, degli obiettivi personali, del calendario delle gare, della disponibilità settimanale e degli impegni di lavoro e famiglia. Tutte le attività sono coordinate e supervisionate da allenatori qualificati.",
	},
	{
		eyebrow: "Le gare",
		title: "Dallo Sprint all'Ironman",
		desc: "Con il gruppo si preparano triathlon Sprint, Olimpico, Medio e Ironman, ma anche mezze maratone, maratone e gare podistiche. La squadra partecipa alle principali competizioni FITRI e alle gare di corsa del calendario stagionale. Gareggiare non è obbligatorio: ci si può allenare con il gruppo anche senza attività agonistica.",
	},
];

const location = [
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2.5 17.5c1.6 0 1.6 1.4 3.2 1.4s1.6-1.4 3.2-1.4 1.6 1.4 3.1 1.4c1.6 0 1.6-1.4 3.2-1.4s1.6 1.4 3.2 1.4c1.5 0 1.5-1.4 3.1-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M6 14.5 12.5 8M9.5 5.5l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><circle cx="16.5" cy="6" r="1.8" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Nuoto",
		text: "Piscina indoor tutto l'anno e piscina outdoor in estate, con corsie dedicate agli atleti.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="5.5" cy="16.5" r="3.5" stroke="currentColor" stroke-width="1.5" /><circle cx="18.5" cy="16.5" r="3.5" stroke="currentColor" stroke-width="1.5" /><path d="m5.5 16.5 4-8h5l4 8M9 8.5h4.5M12 16.5l2.5-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Ciclismo",
		text: "Si parte in bici direttamente dal club verso la collina torinese, con deposito bici riservato agli atleti.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="14" cy="4.8" r="2" stroke="currentColor" stroke-width="1.5" /><path d="m7 21 2.8-4.6-2.3-3.2 1.6-4.4 3.4-1.1 3 2.6 2.9.9M9.5 12.5 5 11M12.8 15.5 15 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Corsa",
		text: "Si esce a correre direttamente sul Lungo Po, senza attraversare il traffico cittadino.",
	},
	{
		icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 9.5v5M7 7.5v9M17 7.5v9M20 9.5v5M7 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Preparazione atletica",
		text: "Palestra per il lavoro a secco, più le sessioni di spinning e sui rulli nei mesi freddi.",
	},
];

const faq = [
	{
		q: "Da quale età si può iniziare e come sono divise le categorie?",
		a: "Il percorso triathlon copre tutte le età: la Young School è rivolta a bambini e ragazzi dai 6 ai 13 anni, la Triathlon Academy a ragazzi e ragazze dai 14 ai 20 anni, il Triathlon Master ai soci dai 20 anni in avanti. Il passaggio dalla Young School all'Academy è automatico, salvo eccezioni valutate con i tecnici.",
	},
	{
		q: "Come vengono formati i gruppi?",
		a: "Nella Young School i gruppi sono organizzati per età e livello di preparazione, così da proporre attività adeguate alle capacità di ciascuno. Nell'Academy gli atleti sono suddivisi in base a età, livello tecnico e obiettivi personali e agonistici.",
	},
	{
		q: "È possibile fare una lezione di prova?",
		html: `<p>Sì, per tutte e tre le categorie. Nella Young School la prima settimana di attività è dedicata alle lezioni di prova gratuite, durante le quali i ragazzi conoscono i tecnici e sperimentano le diverse discipline. Per Academy e Master è possibile partecipare a una lezione di prova per conoscere gli allenatori, il gruppo e il metodo di allenamento: puoi richiederla con il <button type="button" class="faq-inline-btn" data-open-contact data-interest="Triathlon">form di questa pagina</button>.</p>`,
	},
	{
		q: "Bisogna avere già esperienza nel triathlon?",
		a: "No. Nella Young School non è richiesta esperienza, ma è necessario saper nuotare e andare in bicicletta a un livello base: le attività vengono poi proposte gradualmente. Gli allenamenti Master sono aperti a tutti i soci, anche a chi non ha mai praticato triathlon, ed è possibile partecipare partendo anche da una sola disciplina tra nuoto, corsa e ciclismo.",
	},
	{
		q: "Quante volte ci si allena a settimana?",
		a: "Nella Young School sono disponibili programmi con 1, 2 o 3 allenamenti settimanali, per un totale rispettivamente di 2, 4 o 6 ore: gli allenamenti si svolgono il lunedì, mercoledì, giovedì e venerdì e ogni famiglia sceglie i giorni in base al programma acquistato. Academy e Master prevedono invece attività distribuite lungo tutta la settimana, con frequenza modulata dai tecnici in base al periodo della stagione, al livello e agli obiettivi.",
	},
	{
		q: "È possibile recuperare un allenamento perso?",
		a: "Sì. Nella Young School un allenamento non svolto può essere recuperato in un altro giorno della stessa settimana, compatibilmente con il programma scelto e con l'organizzazione delle attività.",
	},
	{
		q: "Quale attrezzatura è necessaria?",
		a: "Servono abbigliamento sportivo adatto alla corsa, costume e materiale per il nuoto, la bicicletta e il casco, obbligatorio durante gli allenamenti in bici. È consigliato utilizzare una bicicletta personale: nelle prime fasi del corso Young School, in base alla disponibilità, Ronchiverdi può metterne una a disposizione. Per tutti gli atleti è disponibile un deposito dedicato alle biciclette.",
	},
	{
		q: "È obbligatorio partecipare alle gare?",
		a: "No, in nessuna delle tre categorie. Durante la stagione vengono organizzati eventi e gare di corsa, acquathlon, duathlon e triathlon con il supporto dei tecnici, e la squadra partecipa alle principali competizioni FITRI, ma la partecipazione resta una scelta: ci si può allenare con il gruppo anche senza attività agonistica.",
	},
	{
		q: "Sono previsti programmi di allenamento personalizzati?",
		a: "Sì, per Academy e Master. I tecnici predispongono una programmazione individuale in base a livello di preparazione, obiettivi personali e agonistici, calendario delle gare, periodo della stagione e — per i Master — disponibilità settimanale e impegni di lavoro e famiglia. Il programma viene aggiornato in base ai progressi.",
	},
	{
		q: "Come ci si iscrive, quali documenti servono e come arrivano le comunicazioni?",
		a: "L'iscrizione alla Young School si effettua online dal sito Ronchiverdi, quella all'Academy presso la Reception del Club. Serve un certificato medico in corso di validità: dai 12 anni è richiesto il certificato medico agonistico, obbligatorio anche per Academy e Master e per il tesseramento federale. La quota Young School comprende i tesseramenti FITRI e FIDAL, quella Academy il tesseramento FITRI con validità annuale. Allenamenti, uscite in bici, gare e iniziative vengono comunicati tramite il gruppo di messaggistica dedicato agli atleti e alle famiglie.",
	},
];
---

<Layout
	title="Triathlon — Ronchiverdi Sport Club"
	description="Triathlon a Ronchiverdi, punto di riferimento a Torino: Young School dai 6 anni, Academy dai 14 e squadra Master per i soci. Tecnici federali, tre piscine e uscite in bici dal club."
>
	<PageHero image="images/activities/triathlon.jpg" imageAlt="Atleta di triathlon in gara" eyebrow="Attività sportive">
		<Fragment slot="title">Triathlon, <em class="accent">dai 6 anni all'Ironman</em></Fragment>
		<Fragment slot="lede">Nuoto, ciclismo e corsa con tecnici federali: un percorso unico che accompagna dai primi anni della Young School fino alla squadra Master.</Fragment>
	</PageHero>

	<nav class="intro-grid" aria-label="Vai alla sezione">
		<a class="intro-col" href="#young">
			<img class="intro-col__bg" src={url("images/activities/scuola-nuoto-young.jpg")} alt="" loading="lazy" />
			<div class="intro-col__scrim"></div>
			<span class="intro-col__index">01</span>
			<span class="intro-col__body">
				<span class="eyebrow eyebrow-dark">6–13 anni</span>
				<h2>Young School</h2>
				<p class="lede lede-dark" style="margin-inline:0">Il corso per bambini e ragazzi: nuoto, ciclismo e corsa in gruppi per età e livello.</p>
			</span>
			<span class="intro-col__arrow" aria-hidden="true">
				<svg width="20" height="16" viewBox="0 0 18 14" fill="none"><path d="M1 7h15M10 1l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</span>
		</a>
		<a class="intro-col" href="#academy">
			<img class="intro-col__bg" src={url("images/activities/nuoto.jpg")} alt="" loading="lazy" />
			<div class="intro-col__scrim"></div>
			<span class="intro-col__index">02</span>
			<span class="intro-col__body">
				<span class="eyebrow eyebrow-dark">14–20 anni</span>
				<h2>Academy</h2>
				<p class="lede lede-dark" style="margin-inline:0">Allenamenti quotidiani e programmazione individuale, fino ai Campionati Italiani.</p>
			</span>
			<span class="intro-col__arrow" aria-hidden="true">
				<svg width="20" height="16" viewBox="0 0 18 14" fill="none"><path d="M1 7h15M10 1l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</span>
		</a>
		<a class="intro-col" href="#master">
			<img class="intro-col__bg" src={url("images/activities/triathlon.jpg")} alt="" loading="lazy" />
			<div class="intro-col__scrim"></div>
			<span class="intro-col__index">03</span>
			<span class="intro-col__body">
				<span class="eyebrow eyebrow-dark">Dai 20 anni</span>
				<h2>Master</h2>
				<p class="lede lede-dark" style="margin-inline:0">La squadra dei soci: allenamenti di gruppo dallo Sprint all'Ironman.</p>
			</span>
			<span class="intro-col__arrow" aria-hidden="true">
				<svg width="20" height="16" viewBox="0 0 18 14" fill="none"><path d="M1 7h15M10 1l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</span>
		</a>
	</nav>

	<IconFacts eyebrow="Il triathlon a Ronchiverdi" title="Un punto di riferimento per il triathlon a Torino" items={facts} />

	<section class="about">
		<div class="about__media">
			<img src={url("images/services/piscina-esterna.jpg")} alt="Piscina esterna di Ronchiverdi" loading="lazy" />
		</div>
		<div class="about__content">
			<span class="eyebrow">Perché qui</span>
			<h2>La struttura fa la differenza</h2>
			<p class="lede" style="margin-inline:0">
				Il triathlon chiede tre discipline e tre spazi diversi: a Ronchiverdi sono tutti nello stesso posto. Tre piscine, la palestra per il lavoro a secco e una posizione ai margini della città, da cui si esce in bici senza affrontare rotaie, tram e traffico del centro, con il Lungo Po per correre e la collina torinese a pochi minuti.
			</p>
			<p class="about__text">
				È il motivo per cui, da quando il triathlon esiste in Italia, Ronchiverdi è un riferimento per chi lo pratica a Torino: quindici anni di attività strutturata, una squadra federale che oggi conta oltre 200 triatleti e un settore giovanile cresciuto anno dopo anno, fino a diventare uno dei più forti e numerosi del panorama nazionale.
			</p>
		</div>
	</section>

	<div class="section-frame" id="young">
		<span class="section-frame__tag">Young School · 6–13 anni</span>
		<section class="split">
			<div class="split__media young-school-photo">
				<img src={url("images/activities/scuola-nuoto-young.jpg")} alt="Young School Triathlon a Ronchiverdi" loading="lazy" />
			</div>
			<div class="split__content">
				<span class="eyebrow">Young School Triathlon</span>
				<h2>Un corso vero, non un dopo-scuola</h2>
				<p class="lede" style="margin-inline:0">
					Dai 6 ai 13 anni, la Young School è un corso strutturato: una pianificazione settimanale, gruppi per età e livello e solo tecnici federali in campo. I ragazzi imparano nuoto, ciclismo e corsa con progressioni graduali, senza bisogno di esperienza pregressa — basta saper nuotare e andare in bici a livello base.
				</p>
				<p class="split__note">
					La prima settimana di attività è dedicata alle <strong>lezioni di prova gratuite</strong>: si conoscono i tecnici, si provano le tre discipline e si capisce come è organizzato il corso.
				</p>
			</div>
		</section>

		<section class="programmi">
			<div class="programmi__head">
				<h3>Scegli quante volte allenarti</h3>
				<p class="lede" style="margin-inline:auto">
					Gli allenamenti si svolgono il lunedì, mercoledì, giovedì e venerdì: i giorni si scelgono in base al programma acquistato.
				</p>
			</div>
			<div class="program-cards">
				{youngProgrammi.map((p) => (
					<article class="program-card">
						<div class="program-card__content">
							<h4>{p.title}</h4>
							<span class="program-card__ore">{p.ore}</span>
							<p class="program-card__desc">{p.desc}</p>
							<ul class="program-card__dettagli">
								{p.dettagli.map((d) => (
									<li>
										<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
										<span>{d}</span>
									</li>
								))}
							</ul>
						</div>
					</article>
				))}
			</div>
			<p class="programmi__note">
				Un allenamento non svolto può essere <strong>recuperato in un altro giorno della stessa settimana</strong>, compatibilmente con il programma scelto. Durante la stagione vengono organizzati eventi e gare di corsa, acquathlon, duathlon e triathlon con il supporto dei tecnici: partecipare non è obbligatorio.
			</p>
		</section>

		<div class="section-cta">
			<a class="btn" href={url("/attivita/triathlon/iscrizione")}>Modalità di iscrizione</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="Triathlon">Contattaci</button>
		</div>
	</div>

	<div class="section-frame" id="academy">
		<span class="section-frame__tag">Academy · 14–20 anni</span>
		<section class="split split--reverse">
			<div class="split__media">
				<img src={url("images/activities/nuoto.jpg")} alt="Allenamento in piscina della Triathlon Academy" loading="lazy" />
			</div>
			<div class="split__content">
				<span class="eyebrow">Triathlon Academy</span>
				<h2>Dove il corso diventa percorso</h2>
				<p class="lede" style="margin-inline:0">
					Dai 14 ai 20 anni si passa all'Academy, come si passa dalle medie al liceo: il passaggio è automatico, salvo eccezioni valutate con i tecnici. Cambia il modo di allenarsi — non più giorni fissi, ma un programma individuale che accompagna l'atleta tutta la settimana.
				</p>
				<p class="split__note">
					Gli iscritti all'Academy diventano <strong>soci di Ronchiverdi</strong>: hanno il braccialetto e possono frequentare il club sette giorni su sette, anche fuori dagli orari di allenamento.
				</p>
			</div>
		</section>

		<section class="cards-band">
			{academyCards.map((c) => (
				<article class="info-card">
					<span class="eyebrow">{c.eyebrow}</span>
					<h3>{c.title}</h3>
					<p>{c.desc}</p>
				</article>
			))}
		</section>

		<p class="frame-note">
			L'iscrizione si effettua presso la <strong>Reception del Club</strong> e comprende il tesseramento FITRI con validità annuale. È obbligatorio il certificato medico agonistico in corso di validità. Le comunicazioni su attività, programmi e gare passano dal gruppo di messaggistica dedicato ad atleti e famiglie.
		</p>

		<div class="section-cta">
			<a class="btn" href={url("/attivita/triathlon/iscrizione")}>Modalità di iscrizione</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="Triathlon">Contattaci</button>
		</div>
	</div>

	<div class="section-frame" id="master">
		<span class="section-frame__tag">Master · dai 20 anni</span>
		<section class="split">
			<div class="split__media">
				<img src={url("images/activities/triathlon.jpg")} alt="Atleta Master della squadra Triathlon Ronchiverdi in gara" loading="lazy" />
			</div>
			<div class="split__content">
				<span class="eyebrow">Triathlon Master</span>
				<h2>Una squadra, non un allenamento in solitaria</h2>
				<p class="lede" style="margin-inline:0">
					Gli allenamenti Master sono aperti a tutti i soci Ronchiverdi, anche a chi non ha mai praticato triathlon. Ci si può avvicinare gradualmente, partendo anche da una sola disciplina, o allenarsi da atleti esperti dentro una squadra organizzata: in entrambi i casi si entra nel gruppo Triathlon Ronchiverdi, in un ambiente motivante e seguito da allenatori qualificati.
				</p>
			</div>
		</section>

		<section class="cards-band">
			{masterCards.map((c) => (
