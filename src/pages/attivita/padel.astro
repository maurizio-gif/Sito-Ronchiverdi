---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import IconFacts from "../../components/IconFacts.astro";
import HoursTable from "../../components/HoursTable.astro";
import { tennisPadelHours } from "../../data/schedules";
import { url } from "../../lib/paths";

const WANSPORT_URL = "https://wansport.com/scarica-la-nuova-app/?venue=2xia7hbqfbsgal19mxe0h8w7";

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M12 4v16M3 12h18" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Campi",
		html: "<strong>3 campi da padel</strong>, di cui 2 coperti e 1 scoperto, sempre prenotabili tramite l'app <strong>Wansport</strong>.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="4" y="4.5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M8 3v3M16 3v3M4 9.5h16M9 14l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Accesso",
		html: "Campi aperti a <strong>soci e non soci</strong>: nessuna tessera o abbonamento è necessario per prenotare e scendere in campo.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.5L12 15.8 7.1 18.2l.9-5.5-4-3.9L9.5 8 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Affiliazione",
		html: "Club <strong>affiliato FITP</strong>, con maestro qualificato per corsi di gruppo, lezioni individuali e la Young School Padel.",
	},
];

const adultiCourses = [
	{
		title: "Corsi di gruppo",
		desc: "Lezioni organizzate per 2, 3 o 4 persone, in base al livello di gioco e alla disponibilità dei maestri.",
		dettagli: ["Gruppi da 2 a 4 persone", "Livello e orari da concordare con il maestro", "Racchetta a noleggio a 4€ per chi non ne ha una"],
	},
	{
		title: "Lezioni individuali",
		desc: "Massima flessibilità di orario: le lezioni private si organizzano contattando direttamente il maestro di riferimento.",
		dettagli: ["Frequenza e orari a scelta", "Programma su misura", "Da concordare con il maestro di riferimento"],
	},
];

const requisiti = [
	{
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="4" y="4.5" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M8 3v3M16 3v3M4 9.5h16M9 14l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>`,
		label: "Prenotazione su Wansport",
	},
	{
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M3 10h18" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Nessuna tessera necessaria",
	},
	{
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="7.5" y="8.5" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M9 8.5V6a3 3 0 0 1 6 0v2.5M9 15.5V18a3 3 0 0 0 6 0v-2.5" stroke="currentColor" stroke-width="1.5" /></svg>`,
		label: "Spogliatoio dedicato tennis e padel",
	},
];

const faq = [
	{
		q: "È possibile prenotare un campo anche senza essere soci?",
		a: "Sì. I campi da padel possono essere prenotati anche da utenti esterni. Non è necessario sottoscrivere alcuna tessera di iscrizione.",
	},
	{
		q: "È possibile noleggiare una racchetta?",
		a: "Sì. Chi non dispone di una racchetta può noleggiarla direttamente presso il Club al costo di 4 euro.",
	},
	{
		q: "Sono disponibili corsi di gruppo?",
		a: "Sì. È possibile organizzare lezioni di gruppo per 2, 3 o 4 persone, in base al livello e alle disponibilità dei maestri.",
	},
	{
		q: "È possibile prenotare lezioni private?",
		a: "Sì. Le lezioni individuali possono essere concordate contattando direttamente il maestro.",
	},
	{
		q: "Come si prenotano i campi?",
		html: `<p>I campi si prenotano tramite l'<strong>App Wansport</strong>, dalla quale è possibile verificare giorni, orari e disponibilità. Puoi <a href="${WANSPORT_URL}" target="_blank" rel="noopener">scaricare l'app qui</a>.</p>`,
	},
	{
		q: "È disponibile uno spogliatoio dedicato?",
		a: "Sì. È presente uno spogliatoio dedicato agli utenti di tennis e padel.",
	},
	{
		q: "Esistono gruppi o chat per trovare altri giocatori?",
		a: "Sì. Sono disponibili chat dedicate, organizzate in base al livello di gioco, per facilitare la ricerca di compagni e l'organizzazione delle partite.",
	},
	{
		q: "Sono disponibili pacchetti di lezioni o di utilizzo dei campi?",
		a: "Sì. Sono disponibili pacchetti dedicati alle lezioni e all'utilizzo dei campi, acquistabili tramite il maestro oppure presso la Reception.",
	},
	{
		q: "Quali sono gli orari di utilizzo dei campi?",
		html: "<p>I campi da tennis e padel sono disponibili dal <strong>lunedì al venerdì dalle 08:00 alle 23:00</strong> e il <strong>sabato, domenica e nei giorni festivi dalle 09:00 alle 20:00</strong>. Eventuali variazioni vengono comunicate attraverso i canali ufficiali del Club.</p>",
	},
];
---

<Layout
	title="Padel — Ronchiverdi Sport Club"
	description="Padel a Ronchiverdi: 3 campi, coperti e scoperti, aperti a soci e non soci. Corsi di gruppo, lezioni individuali e Young School Padel per ragazzi."
>
	<PageHero image="images/activities/padel.jpg" imageAlt="Ingresso tra due campi da padel coperti a Ronchiverdi" eyebrow="Attività sportive">
		<Fragment slot="title">Padel, <em class="accent">ogni partita è un'emozione</em></Fragment>
		<Fragment slot="lede">Tre campi da padel, coperti e scoperti, aperti a soci e non soci: prenota su Wansport e scendi in campo, da solo o in gruppo.</Fragment>
		<Fragment slot="stat">
			<strong>3</strong>
			<span>Campi da padel, di cui 2 coperti e 1 scoperto</span>
		</Fragment>
	</PageHero>

	<IconFacts eyebrow="Il padel a Ronchiverdi" title="Sport aperto a tutti, senza tessera" items={facts} />

	<section class="adulti section-frame" id="adulti">
		<span class="section-frame__tag">Sezione Adulti</span>
		<div class="adulti-intro">
			<div class="adulti-intro__media">
				<img src={url("images/activities/padel-campo.jpg")} alt="Campo da padel Ronchiverdi con rete e linee di gioco" loading="lazy" />
			</div>
			<div class="adulti-intro__content">
				<span class="eyebrow">Adulti</span>
				<h2>Un campo per ogni livello</h2>
				<p class="lede" style="margin-inline:0">
					I campi da padel di Ronchiverdi sono aperti a soci e non soci, senza bisogno di alcuna tessera: basta prenotare tramite l'app Wansport e scendere in campo. Chi non ha ancora una racchetta può noleggiarne una al Club, e chi vuole imparare o migliorare può contare su corsi di gruppo e lezioni individuali con i nostri maestri.
				</p>
			</div>
		</div>
		<div class="adulti-cards">
			{adultiCourses.map((c) => (
				<article class="adulti-card">
					<h3>{c.title}</h3>
					<p class="adulti-card__desc">{c.desc}</p>
					<ul class="adulti-card__dettagli">
						{c.dettagli.map((d) => (
							<li>
								<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
								<span>{d}</span>
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
		<p class="adulti-note">
			Sono disponibili anche <strong>pacchetti dedicati</strong> alle lezioni e all'utilizzo dei campi, acquistabili tramite il maestro o presso la Reception, e <strong>chat organizzate per livello</strong> per trovare compagni di gioco e organizzare partite.
		</p>
		<div class="section-cta">
			<a class="btn" href={WANSPORT_URL} target="_blank" rel="noopener">Prenota su Wansport</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="corsi-padel">Contattaci</button>
		</div>
	</section>

	<div class="section-frame" id="young">
		<span class="section-frame__tag">Sezione Young School</span>
		<section class="young-intro">
			<div class="young-intro__media">
				<img src={url("images/activities/padel-racchetta.jpg")} alt="Presa della racchetta da padel durante una lezione" loading="lazy" />
			</div>
			<div class="young-intro__content">
				<span class="eyebrow">Young School Padel</span>
				<h2>Crescere nel padel, in gruppo</h2>
				<p class="lede" style="margin-inline:0">
					La Young School Padel accoglie ragazzi e ragazze dai 10 ai 17 anni, in gruppi omogenei per età e livello. Ogni lezione è pensata per sviluppare tecnica, gioco di squadra, reattività e strategia, con l'obiettivo di far crescere ogni giovane atleta sia sul piano sportivo che personale.
				</p>
				<ul class="young-highlights">
					<li>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						<span>Ragazzi e ragazze dai 10 ai 17 anni</span>
					</li>
					<li>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						<span>Gruppi per età e livello, 1 o 2 volte a settimana</span>
					</li>
					<li>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						<span>Percorso di crescita personalizzato verso l'agonismo</span>
					</li>
				</ul>
			</div>
		</section>
	</div>

	<section class="maestri">
		<div class="maestri__head">
			<h2>Il nostro maestro</h2>
			<p class="lede" style="margin-inline:auto">Un professionista certificato FITP, punto di riferimento per adulti e ragazzi.</p>
		</div>
		<div class="maestri-grid maestri-grid--single">
			<div class="maestro-card">
				<span class="maestro-card__avatar" aria-hidden="true">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5" /><path d="M4 20c0-3.6 3.6-6 8-6s8 2.4 8 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
				</span>
				<h3>Davide Casale</h3>
				<p>Istruttore FITP — Federazione Italiana Tennis e Padel</p>
			</div>
		</div>
	</section>

	<section class="orari">
		<div class="orari__content">
			<span class="eyebrow">Orari e accesso</span>
			<h2>Quando si gioca</h2>
			<p class="lede" style="margin-inline:0">
				I campi da tennis e padel condividono gli stessi orari di apertura. Eventuali variazioni vengono comunicate attraverso i canali ufficiali del Club.
			</p>
			<ul class="requisiti">
				{requisiti.map((r) => (
					<li>
						<span class="requisiti__icon" aria-hidden="true" set:html={r.icon} />
						<span>{r.label}</span>
					</li>
				))}
			</ul>
			<a class="btn" href={WANSPORT_URL} target="_blank" rel="noopener">Prenota su Wansport</a>
		</div>
		<div class="orari__table">
			<HoursTable rows={tennisPadelHours} />
		</div>
	</section>

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vuoi provare il padel?</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un campo su Wansport o contattaci per informazioni su corsi e lezioni.
		</p>
		<div class="final-cta__buttons">
			<a class="btn" href={WANSPORT_URL} target="_blank" rel="noopener">Prenota su Wansport</a>
			<button type="button" class="btn btn-outline" data-open-contact data-interest="corsi-padel">Contattaci</button>
		</div>
	</section>

	<style>
		.section-frame {
			position: relative;
			max-width: 88rem;
			margin: 0 auto 4.5rem;
			padding-top: 0.75rem;
			border: 1.5px solid var(--border-strong);
			border-radius: 28px;
			scroll-margin-top: 7.5rem;
		}
		.section-frame__tag {
			position: absolute;
			top: -1.1rem;
			left: 2.5rem;
			z-index: 2;
			background: var(--bg);
			border: 1.5px solid var(--border-strong);
			border-radius: 999px;
			padding: 0.5rem 1.4rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--accent);
		}
		@media (max-width: 640px) {
			.section-frame {
				border-radius: 20px;
				margin-bottom: 3rem;
			}
			.section-frame__tag {
				left: 1.5rem;
				font-size: var(--text-xs);
				padding: 0.45rem 1.1rem;
			}
		}

		.adulti {
			max-width: 78rem;
			margin: 0 auto 4.5rem;
			padding: 2rem 1.5rem 3rem;
			text-align: center;
			scroll-margin-top: 7.5rem;
		}
		.adulti-intro {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: 3.5rem;
			text-align: left;
			margin-bottom: 3rem;
		}
		.adulti-intro__media img {
			display: block;
			width: 100%;
			aspect-ratio: 4 / 3;
			object-fit: cover;
			border-radius: 16px;
			box-shadow: 0 12px 32px -8px rgba(28, 28, 24, 0.25);
		}
		.adulti-intro__content {
			text-align: left;
		}
		@media (max-width: 860px) {
			.adulti-intro {
				grid-template-columns: 1fr;
				gap: 2rem;
				text-align: center;
			}
			.adulti-intro__content {
				text-align: center;
			}
			.adulti-intro__content .lede {
				margin-inline: auto;
			}
		}
		.adulti-cards {
			margin-top: 2.5rem;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem;
			text-align: left;
		}
		.adulti-card {
			border: 1px solid var(--border);
			border-radius: 16px;
			background: var(--bg-alt);
			padding: 1.75rem 1.75rem 2rem;
		}
		.adulti-card h3 {
			margin: 0 0 0.6rem;
		}
		.adulti-card__desc {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.6;
			margin: 0 0 1.1rem;
		}
		.adulti-card__dettagli {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text);
		}
		.adulti-card__dettagli li {
			display: flex;
			align-items: flex-start;
			gap: 0.55rem;
		}
		.adulti-card__dettagli li svg {
			flex-shrink: 0;
			margin-top: 0.2rem;
			color: var(--accent);
		}
		.adulti-note {
			max-width: 42rem;
			margin: 2.5rem auto 1.75rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.6;
		}
		.section-cta {
			display: flex;
			gap: 1rem;
			justify-content: center;
			flex-wrap: wrap;
			padding: 1rem 1.5rem 2.5rem;
		}
		.section-cta .btn-outline {
			cursor: pointer;
			font-family: var(--font-sans);
		}
		@media (max-width: 760px) {
			.adulti-cards {
				grid-template-columns: 1fr;
			}
		}

		.young-intro {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: 3.5rem;
			max-width: 78rem;
			margin: 0 auto;
			padding: 2rem 1.5rem 3rem;
			scroll-margin-top: 7.5rem;
		}
		.young-intro__media img {
			display: block;
			width: 100%;
			aspect-ratio: 4 / 3;
			object-fit: cover;
			border-radius: 16px;
			box-shadow: 0 12px 32px -8px rgba(28, 28, 24, 0.25);
		}
		.young-intro__content {
			text-align: left;
		}
		.young-highlights {
			list-style: none;
			margin: 1.5rem 0 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text);
		}
		.young-highlights li {
			display: flex;
			align-items: flex-start;
			gap: 0.55rem;
		}
		.young-highlights li svg {
			flex-shrink: 0;
			margin-top: 0.2rem;
			color: var(--accent);
		}
		@media (max-width: 860px) {
			.young-intro {
				grid-template-columns: 1fr;
				gap: 2rem;
				text-align: center;
			}
			.young-intro__content {
				text-align: center;
			}
			.young-intro__content .lede {
				margin-inline: auto;
			}
			.young-highlights {
				text-align: left;
			}
		}

		.maestri {
			max-width: 78rem;
			margin: 0 auto;
			padding: 5.5rem 1.5rem;
		}
		.maestri__head {
			max-width: 42rem;
			margin: 0 auto 2.75rem;
			text-align: center;
		}
		.maestri-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
		}
		.maestri-grid--single {
			grid-template-columns: minmax(0, 16rem);
			justify-content: center;
		}
		.maestro-card {
			text-align: center;
			padding: 2rem 1.25rem;
			border: 1px solid var(--border);
			border-radius: 16px;
			background: var(--bg-alt);
		}
		.maestro-card__avatar {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 4.5rem;
			height: 4.5rem;
			margin: 0 auto 1.1rem;
			border-radius: 50%;
			background: var(--border-strong);
			color: var(--text-muted);
		}
		.maestro-card h3 {
			font-size: var(--text-md);
			margin: 0 0 0.3rem;
		}
		.maestro-card p {
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			color: var(--text-muted);
			margin: 0;
		}

		.orari {
			display: grid;
			grid-template-columns: 1.1fr 1fr;
			align-items: center;
			gap: 3.5rem;
			max-width: 78rem;
			margin: 0 auto;
			padding: 1rem 1.5rem 5.5rem;
		}
		.orari__content .btn {
			margin-top: 0.5rem;
		}
		.requisiti {
			list-style: none;
			margin: 1.5rem 0 2rem;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
		}
		.requisiti li {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.5rem 0.95rem;
			border: 1px solid var(--border-strong);
			border-radius: 999px;
			font-family: var(--font-sans);
			font-size: var(--text-xs);
			font-weight: 500;
			color: var(--text);
		}
		.requisiti__icon {
			display: inline-flex;
			color: var(--accent);
		}
		.orari__table {
			border: 1px solid var(--border);
			border-radius: 16px;
			background: var(--bg-alt);
			padding: 1.25rem 1.5rem;
		}
		.orari__table :global(.hours-table) {
			max-width: none;
		}
		@media (max-width: 860px) {
			.orari {
				grid-template-columns: 1fr;
				gap: 2rem;
				padding: 1rem 1.5rem 4rem;
			}
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
		.final-cta__buttons {
			display: flex;
			gap: 1rem;
			justify-content: center;
			flex-wrap: wrap;
		}
