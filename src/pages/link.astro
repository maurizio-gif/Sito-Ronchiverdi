---
// Pagina "link in bio": è l'unico indirizzo che sta nella biografia di
// Instagram, dove di link se ne può mettere uno solo.
//
// Tre scelte che spiegano com'è fatta:
//   1. senza barra e senza footer del sito. Chi arriva qui viene da un
//      telefono e ha in testa una cosa sola: un menu a tendina e un footer
//      da cinque colonne gli mettono davanti trenta voci prima di quella.
//      Le modali però servono — i due pulsanti in cima aprono il form —
//      quindi LeadModal viene importata a mano;
//   2. i pulsanti sono grandi e in colonna, uno sotto l'altro: sul telefono
//      il pollice sbaglia, e un bersaglio da 4,5rem non si sbaglia;
//   3. tutte le sezioni del sito ci sono comunque, ma piccole, sotto: chi
//      cerca il triathlon o la spa lo trova senza tornare al sito.
//
// Non è indicizzata (`noindex`, ed è esclusa dalla sitemap in
// astro.config.mjs): duplicherebbe la navigazione del sito senza aggiungere
// una riga di contenuto, e finirebbe a farsi concorrenza con la home sulle
// ricerche del nome del club.
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import LeadModal from "../components/LeadModal.astro";
import { ISCRIZIONI } from "../data/areaRiservata";
import { url } from "../lib/paths";

const address = "Corso Moncalieri 466, Torino";
const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;

// Attività e servizi arrivano dalle content collection, come nel menu e nel
// footer: una scheda nuova compare anche qui, senza che nessuno si ricordi
// di aggiornare questa pagina.
const byOrder = (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0);
const attivita = (await getCollection("activities")).filter((a) => a.data.visible !== false);
const attivitaAdulti = attivita.filter((a) => a.data.audience === "adulti").sort(byOrder);
const attivitaJunior = attivita.filter((a) => a.data.audience === "junior").sort(byOrder);
const activityHref = (a) => (a.data.href ? url(a.data.href) : url("/#attivita"));

const servizi = (await getCollection("services")).sort(byOrder);
const servizioHref = (s) => (s.data.external ? s.data.href : url(s.data.href));

// I pulsantoni, nell'ordine in cui si fanno le domande: prima venire a
// vedere, poi parlare con qualcuno, poi le tre pagine che si consultano.
const principali = [
	{
		label: "Prenota un tour",
		nota: "Vieni a vedere il club con un nostro referente",
		openContact: true,
		interest: "club-adulti",
		primario: true,
	},
	{
		label: "Contattaci",
		nota: "Dicci cosa cerchi, ti richiamiamo noi",
		openContact: true,
	},
	{
		label: "Planning orari",
		nota: "Orari e palinsesti della settimana",
		href: url("/planning"),
	},
	{
		label: "Eventi",
		nota: "Tornei, gare e appuntamenti del club",
		href: url("/eventi"),
	},
	{
		label: "Abbonamenti",
		nota: "Le quattro combinazioni di attività",
		href: url("/abbonamenti"),
	},
];

const sezioni = [
	{
		titolo: "Attività adulti",
		voci: attivitaAdulti.map((a) => ({ label: a.data.title, href: activityHref(a) })),
	},
	{
		titolo: "Young School",
		voci: attivitaJunior.map((a) => ({ label: a.data.title, href: activityHref(a) })),
	},
	{
		titolo: "Servizi",
		voci: servizi.map((s) => ({
			label: s.data.title,
			href: servizioHref(s),
			esterno: !!s.data.external,
		})),
	},
	{
		titolo: "Iscrizioni",
		voci: ISCRIZIONI.map((i) => ({ label: i.sport, href: i.href })),
	},
	{
		titolo: "Il club",
		voci: [
			{ label: "Home", href: url("/") },
			{ label: "Blog", href: url("/blog") },
			{ label: "Domande frequenti", href: url("/faq") },
			{ label: "Lavora con noi", href: url("/lavora-con-noi") },
			{ label: "Ronchiverdi Business", href: "https://business.ronchiverdi.it", esterno: true },
		],
	},
];
---

<Layout
	title="Ronchiverdi Sport Club — tutti i link"
	description="Prenota un tour, guarda il planning, scopri abbonamenti ed eventi di Ronchiverdi Sport Club: tutti i link del club in una pagina."
	senzaNavigazione
	noindex
>
	<main class="lk">
		<header class="lk__head">
			<img class="lk__logo" src={url("logo-ronchiverdi-sport.png")} alt="Ronchiverdi Sport Club" height="46" />
			<p class="lk__eyebrow">Club sportivo · Torino</p>
			<h1 class="lk__title">Tutto Ronchiverdi, <em>da qui</em></h1>
			<p class="lk__lede">
				Venire a vedere il club, controllare gli orari, capire quanto costa:
				quello che ci si chiede più spesso, in una pagina.
			</p>
		</header>

		<div class="lk__cta">
			{principali.map((b) =>
				b.openContact ? (
					<button
						type="button"
						class:list={["lk-btn", { "lk-btn--primario": b.primario }]}
						data-open-contact
						data-interest={b.interest}
					>
						<span class="lk-btn__testo">
							<span class="lk-btn__label">{b.label}</span>
							<span class="lk-btn__nota">{b.nota}</span>
						</span>
						<span class="lk-btn__freccia" aria-hidden="true">→</span>
					</button>
				) : (
					<a class:list={["lk-btn", { "lk-btn--primario": b.primario }]} href={b.href}>
						<span class="lk-btn__testo">
							<span class="lk-btn__label">{b.label}</span>
							<span class="lk-btn__nota">{b.nota}</span>
						</span>
						<span class="lk-btn__freccia" aria-hidden="true">→</span>
					</a>
				)
			)}
		</div>

		{/* Il club sta in un posto solo e chi guarda una storia su Instagram è
		    spesso a Torino: l'indirizzo apre le indicazioni, non una mappa da
		    guardare. */}
		<a class="lk-dove" href={mapsUrl} target="_blank" rel="noopener">
			<span class="lk-dove__label">Come arrivare</span>
			<span class="lk-dove__indirizzo">{address}</span>
		</a>

		<nav class="lk__sezioni" aria-label="Tutte le sezioni del sito">
			{sezioni.map((s) => (
				<section class="lk-sezione">
					<h2 class="lk-sezione__titolo">{s.titolo}</h2>
					<ul class="lk-sezione__voci">
						{s.voci.map((v) => (
							<li>
								<a
									href={v.href}
									target={v.esterno ? "_blank" : undefined}
									rel={v.esterno ? "noopener" : undefined}
								>{v.label}</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</nav>

		<footer class="lk__foot">
			<a class="lk__sito" href={url("/")}>Vai al sito</a>
			<p class="lk__legale">
				<a href={url("/privacy")}>Privacy</a>
				<span aria-hidden="true">·</span>
				<a href={url("/termini-e-condizioni")}>Termini e condizioni</a>
			</p>
			<p class="lk__tel"><a href="tel:+390116612146">011 6612146</a></p>
		</footer>
	</main>

	{/* Senza navigazione il Layout non la stampa, ma i due pulsanti in cima
	    ne hanno bisogno: è lo stesso form del resto del sito, con la stessa
	    origine registrata (qui: /link). */}
	<LeadModal />
</Layout>

<style>
	/* Fondo scuro e colonna stretta: la pagina si guarda su un telefono,
	   tenuto in mano, spesso di sera dopo una storia. Il crema del sito, a
	   tutto schermo su un telefono, è una lampada. */
	.lk {
		min-height: 100vh;
		padding: 2.5rem 1.25rem 3rem;
		background: var(--bg-dark);
		color: var(--text-on-dark);
		/* Un alone caldo dietro l'intestazione: il nero pieno da bordo a bordo
		   sembra una pagina non caricata. */
		background-image: radial-gradient(
			ellipse 90% 45% at 50% 0%,
			rgba(200, 153, 31, 0.18) 0%,
			rgba(200, 153, 31, 0) 70%
		);
	}
	.lk > * {
		max-width: 30rem;
		margin-inline: auto;
	}

	.lk__head {
		text-align: center;
		padding-bottom: 2rem;
	}
	/* Il logo è pensato per il crema: sul nero va reso in negativo, come nel
	   footer del sito. */
	.lk__logo {
		filter: brightness(0) invert(1);
		opacity: 0.94;
		margin-bottom: 1.5rem;
	}
	.lk__eyebrow {
		margin: 0 0 0.5rem;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-on-dark);
	}
	.lk__title {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: clamp(2.1rem, 9vw, 2.7rem);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}
	.lk__title em {
		font-style: italic;
		color: var(--accent-on-dark);
	}
	.lk__lede {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.6;
		color: rgba(246, 239, 222, 0.66);
	}

	.lk__cta {
		display: grid;
		gap: 0.7rem;
	}
	/* Bersagli grandi: 4,5rem di altezza minima e tutta la larghezza della
	   colonna. Etichetta e nota stanno una sopra l'altra perché la nota è
	   quella che fa capire dove si finisce, e su una riga sola non ci sta. */
	.lk-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		min-height: 4.5rem;
		margin: 0;
		padding: 1rem 1.25rem;
		text-align: left;
		text-decoration: none;
		background: rgba(246, 239, 222, 0.06);
		border: 1px solid var(--border-dark);
		border-radius: 14px;
		color: var(--text-on-dark);
		cursor: pointer;
		transition: background 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
	}
	.lk-btn:hover {
		background: rgba(246, 239, 222, 0.1);
		border-color: rgba(246, 239, 222, 0.28);
	}
	.lk-btn:active {
		transform: scale(0.99);
	}
	.lk-btn--primario {
		background: var(--accent-on-dark);
		border-color: var(--accent-on-dark);
		color: #1c1c18;
	}
	.lk-btn--primario:hover {
		background: #d9a924;
		border-color: #d9a924;
	}
	.lk-btn__testo {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.lk-btn__label {
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.2;
	}
	.lk-btn__nota {
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		line-height: 1.35;
		color: rgba(246, 239, 222, 0.6);
	}
	.lk-btn--primario .lk-btn__nota {
		color: rgba(28, 28, 24, 0.7);
	}
	.lk-btn__freccia {
		flex: none;
		font-size: 1.1rem;
		opacity: 0.75;
	}

	.lk-dove {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-top: 0.7rem;
		padding: 0.95rem 1.25rem;
		text-decoration: none;
		background: transparent;
		border: 1px dashed rgba(246, 239, 222, 0.22);
		border-radius: 14px;
		color: var(--text-on-dark);
	}
	.lk-dove__label {
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent-on-dark);
	}
	.lk-dove__indirizzo {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		color: rgba(246, 239, 222, 0.72);
	}

	/* Tutte le sezioni del sito, in piccolo: qui non si tocca col pollice a
	   caso, si cerca una cosa precisa. Restano comunque pastiglie e non testo
	   separato da punti, perché una pastiglia si centra e una parola in mezzo
	   a una riga no. */
	.lk__sezioni {
		margin-top: 2.5rem;
	}
	.lk-sezione + .lk-sezione {
		margin-top: 1.75rem;
	}
	.lk-sezione__titolo {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(246, 239, 222, 0.45);
	}
	.lk-sezione__voci {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.lk-sezione__voci a {
		display: block;
		padding: 0.5rem 0.8rem;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		text-decoration: none;
		color: rgba(246, 239, 222, 0.85);
		background: rgba(246, 239, 222, 0.05);
		border: 1px solid rgba(246, 239, 222, 0.1);
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.lk-sezione__voci a:hover {
		background: rgba(246, 239, 222, 0.12);
		color: var(--text-on-dark);
	}

	.lk__foot {
		margin-top: 3rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--border-dark);
		text-align: center;
	}
	.lk__sito {
		display: inline-block;
		padding: 0.7rem 1.6rem;
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--text-on-dark);
		border: 1px solid rgba(246, 239, 222, 0.3);
		border-radius: 999px;
	}
	.lk__legale,
	.lk__tel {
		margin: 1.1rem 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-2xs);
		color: rgba(246, 239, 222, 0.5);
	}
	.lk__legale a,
	.lk__tel a {
		color: inherit;
	}
	.lk__legale span {
		margin: 0 0.4rem;
	}

	/* Da tablet in su la colonna resta stretta e centrata: allargarla
	   trasformerebbe i pulsantoni in barre da schermo intero, che sono
	   brutte e non servono a nessuno. La pagina nasce per il telefono. */
	@media (min-width: 720px) {
		.lk {
			padding-top: 4rem;
		}
	}
</style>
