---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ContactModal from "../components/ContactModal.astro";
import PageHero from "../components/PageHero.astro";
import IconFacts from "../components/IconFacts.astro";
import EventExpiryGuard from "../components/EventExpiryGuard.astro";
import { getUpcomingEvents, badgeDate, formatRange, untilAttr } from "../lib/events";
import { url } from "../lib/paths";

const eventi = await getUpcomingEvents();
const renderizzati = await Promise.all(
	eventi.map(async (e) => ({ entry: e, Content: (await render(e)).Content }))
);

const facts = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="1.5" /><path d="M2.5 19c0-3.2 2.9-5.3 6.5-5.3s6.5 2.1 6.5 5.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M16 5.2a3.2 3.2 0 0 1 0 6.1M18 13.9c2.1.6 3.5 2.3 3.5 4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Si entra soci, si resta amici",
		html: "Tornei, feste e appuntamenti sono il modo più semplice per conoscere gli altri soci: <strong>si arriva per lo sport e si torna anche per le persone</strong>.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="15.5" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M8 3v4M16 3v4M3.5 10h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>`,
		label: "Tutto l'anno",
		html: "Dai tornei sociali alle simulazioni di gara, dalle feste in piscina agli appuntamenti della Young School: il calendario <strong>non si ferma con le stagioni</strong>.",
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.5L12 15.8 7.1 18.2l.9-5.5-4-3.9L9.5 8 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>`,
		label: "Compresi nell'abbonamento",
		html: "La quasi totalità degli appuntamenti è <strong>inclusa nell'abbonamento</strong>: un valore aggiunto che va oltre l'accesso agli spazi e ai corsi.",
	},
];
---

<Layout
	title="Eventi e community — Ronchiverdi Sport Club"
	description="Gli eventi di Ronchiverdi Sport Club a Torino: tornei sociali, feste in piscina, simulazioni di gara e appuntamenti della community, compresi nell'abbonamento."
>
	<PageHero image="images/club/notturna.jpg" imageAlt="Serata a bordo piscina al Ronchiverdi Sport Club" eyebrow="Vita del club">
		<Fragment slot="title">Eventi e <em class="accent accent-dark">community</em></Fragment>
		<Fragment slot="lede">Un club non è solo i suoi campi e le sue piscine: è la gente che li attraversa. Qui trovi i prossimi appuntamenti aperti ai soci.</Fragment>
	</PageHero>

	<section class="intro">
		<span class="eyebrow">Perché contano</span>
		<h2>La community è parte del club quanto gli spazi</h2>
		<p class="lede">
			A Ronchiverdi la vita del club non finisce quando termina l'allenamento. Tornei sociali, feste, simulazioni di gara e appuntamenti per le famiglie sono un <strong>pezzo cardine della nostra identità</strong>: il momento in cui i soci smettono di essere volti incrociati negli spogliatoi e diventano compagni di squadra, avversari, amici.
		</p>
		<p class="intro__text">
			È anche il motivo per cui molti restano con noi per anni. Un abbonamento dà accesso a spazi e corsi; la community dà una ragione in più per venire, e rende il club un posto dove si torna volentieri anche quando non si è in programma un allenamento. Per questo gli eventi sono <strong>un valore aggiunto compreso nell'abbonamento</strong>, non un extra da acquistare a parte.
		</p>
	</section>

	<IconFacts eyebrow="La vita del club" title="Cosa significa far parte della community" items={facts} />

	<section class="eventi">
		<div class="eventi__head">
			<span class="eyebrow">In programma</span>
			<h2>I prossimi appuntamenti</h2>
			<p class="lede" style="margin-inline:auto">
				Il calendario si aggiorna durante l'anno: qui trovi solo gli eventi ancora in programma.
			</p>
		</div>

		<p class="eventi__empty" data-event-empty hidden={renderizzati.length > 0}>
			Al momento non ci sono eventi in programma. Torna a trovarci tra qualche giorno oppure scrivici: ti avvisiamo appena esce il prossimo appuntamento.
		</p>

		{renderizzati.length > 0 && (
			<div class="event-list" data-event-list>
				{renderizzati.map(({ entry, Content }) => {
					const badge = badgeDate(entry.data.date);
					return (
						<article class="event" id={entry.id} data-event-until={untilAttr(entry.data.date, entry.data.endDate)}>
							{entry.data.image && (
								<div class="event__media">
									<img src={url(entry.data.image)} alt={entry.data.title} loading="lazy" />
									<span class="event__badge" aria-hidden="true">
										<strong>{badge.giorno}</strong>
										<span>{badge.mese}</span>
									</span>
								</div>
							)}
							<div class="event__body">
								<ul class="event__meta">
									<li>
										<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="3.2" width="12" height="11" rx="1.6" stroke="currentColor" stroke-width="1.3" /><path d="M5.5 1.8v2.6M10.5 1.8v2.6M2 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
										<span>{formatRange(entry.data.date, entry.data.endDate)}</span>
									</li>
									{entry.data.orario && (
										<li>
											<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.3" stroke="currentColor" stroke-width="1.3" /><path d="M8 4.6V8l2.4 1.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
											<span>{entry.data.orario}</span>
										</li>
									)}
									{entry.data.luogo && (
										<li>
											<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14.5s4.7-4.1 4.7-8a4.7 4.7 0 1 0-9.4 0c0 3.9 4.7 8 4.7 8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /><circle cx="8" cy="6.2" r="1.7" stroke="currentColor" stroke-width="1.3" /></svg>
											<span>{entry.data.luogo}</span>
										</li>
									)}
								</ul>
								<h3>{entry.data.title}</h3>
								<p class="event__summary">{entry.data.summary}</p>
								<div class="event__content">
									<Content />
								</div>
								{entry.data.ctaHref && (
									<a class="btn" href={entry.data.ctaHref.startsWith("http") ? entry.data.ctaHref : url(entry.data.ctaHref)}>
										{entry.data.ctaLabel ?? "Scopri di più"}
									</a>
								)}
							</div>
						</article>
					);
				})}
			</div>
		)}
	</section>

	<EventExpiryGuard />

	<section class="final-cta">
		<h2>Vuoi far parte della community?</h2>
		<p class="lede" style="margin-inline:auto">
			Gli eventi sono aperti ai soci del club. Scrivici per sapere come partecipare al prossimo appuntamento.
		</p>
		<div class="final-cta__buttons">
			<button type="button" class="btn" data-open-contact data-interest="Altro">Contattaci</button>
			<a class="btn btn-outline" href={url("/abbonamenti")}>Scopri le nostre membership</a>
		</div>
	</section>

	<ContactModal />

	<style>
		.intro {
			max-width: 52rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 4rem;
			text-align: center;
		}
		.intro .lede {
			max-width: none;
			margin-bottom: 1.25rem;
		}
		.intro__text {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.75;
			margin: 0;
		}

		.eventi {
			max-width: 78rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 4rem;
		}
		.eventi__head {
			max-width: 42rem;
			margin: 0 auto 3rem;
			text-align: center;
		}
		.eventi__empty {
			max-width: 40rem;
			margin: 0 auto;
			text-align: center;
			font-family: var(--font-sans);
			font-size: var(--text-md);
			color: var(--text-muted);
			line-height: 1.7;
		}

		.event-list {
			display: flex;
			flex-direction: column;
			gap: 2.5rem;
		}
		.event {
			display: grid;
			grid-template-columns: 22rem 1fr;
			gap: 2.5rem;
			align-items: start;
			border: 1px solid var(--border);
			border-radius: 20px;
			background: var(--bg-alt);
			overflow: hidden;
			scroll-margin-top: 7.5rem;
		}
		.event__media {
			position: relative;
			height: 100%;
			min-height: 16rem;
		}
		.event__media img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.event__badge {
			position: absolute;
			top: 1rem;
			left: 1rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			width: 3.6rem;
			height: 3.6rem;
			border-radius: 12px;
			background: var(--bg);
			box-shadow: 0 8px 20px -8px rgba(28, 28, 24, 0.5);
			font-family: var(--font-sans);
			line-height: 1.1;
		}
		.event__badge strong {
			font-size: var(--text-lg);
			font-weight: 600;
		}
		.event__badge span {
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--accent);
		}
		.event__body {
			padding: 2rem 2.25rem 2.25rem 0;
		}
		.event__meta {
			list-style: none;
			margin: 0 0 0.9rem;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem 1.25rem;
			font-family: var(--font-sans);
			font-size: var(--text-2xs);
			font-weight: 600;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--text-muted);
		}
		.event__meta li {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
		}
		.event__meta svg {
			color: var(--accent);
		}
		.event__body h3 {
			margin: 0 0 0.6rem;
			font-size: var(--text-xl);
		}
		.event__summary {
			font-family: var(--font-sans);
			font-size: var(--text-md);
			color: var(--text-muted);
			line-height: 1.6;
			margin: 0 0 1.25rem;
		}
		/* Corpo dell'evento: HTML libero, quindi gli stili sono globali. */
		.event__content :global(p) {
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.75;
			margin: 0 0 1rem;
		}
		.event__content :global(ul),
		.event__content :global(ol) {
			margin: 0 0 1rem;
			padding-left: 1.2rem;
			font-family: var(--font-sans);
			font-size: var(--text-sm);
			color: var(--text-muted);
			line-height: 1.8;
		}
		.event__content :global(strong) {
			color: var(--text);
		}
		.event__content :global(a) {
			color: var(--accent);
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
		.event__content :global(h4) {
			margin: 1.5rem 0 0.6rem;
			font-size: var(--text-md);
		}
		.event__body .btn {
			margin-top: 0.5rem;
		}
		@media (max-width: 900px) {
			.event {
				grid-template-columns: 1fr;
				gap: 0;
			}
			.event__media {
				min-height: 14rem;
				aspect-ratio: 16 / 9;
			}
			.event__body {
				padding: 1.75rem 1.5rem 2rem;
			}
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
		.final-cta__buttons {
			display: flex;
			gap: 1rem;
			justify-content: center;
			flex-wrap: wrap;
		}
		.final-cta__buttons .btn {
			cursor: pointer;
			font-family: var(--font-sans);
			border: none;
		}
		.final-cta__buttons .btn-outline {
			border: 1px solid currentColor;
		}
	</style>
</Layout>
