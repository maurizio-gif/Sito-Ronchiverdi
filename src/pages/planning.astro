---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/paths";
import HoursTable from "../components/HoursTable.astro";
import WeeklySchedule from "../components/WeeklySchedule.astro";
import Faq from "../components/Faq.astro";
// Orari e palinsesti arrivano tutti da src/content/schedules/planning.json,
// il file unico editabile da Tina: le sezioni qui sotto sono le stesse che
// vedono le pagine delle singole attività.
import { getAllSchedules, getHours } from "../lib/schedules";

const gymFloor = await getHours("gym-floor");
const sezioni = await getAllSchedules();

const faq = [
	{
		q: "Devo prenotare per partecipare a un corso?",
		a: "Dipende dall'attività: per il nuoto libero non serve prenotare, mentre per i corsi in sala o in acqua ti consigliamo di verificare gli orari e contattarci in caso di dubbi.",
	},
	{
		q: "Gli orari mostrati sono sempre aggiornati?",
		a: "I palinsesti Corsi Fitness e Acqua Fitness e gli orari Gym Floor sono aggiornati; il planning del Nuoto Libero è al momento una bozza in fase di aggiornamento.",
	},
	{
		q: "Cosa succede se un corso non è disponibile nella fascia che mi interessa?",
		a: "Contattaci: ti aiutiamo a trovare l'alternativa più vicina ai tuoi orari tra le diverse discipline del club.",
	},
];
---

<Layout
	title="Planning — Ronchiverdi Sport Club"
	description="Tutti i planning settimanali di Ronchiverdi Sport Club: orari Gym Floor, corsi fitness, acqua fitness e nuoto libero."
>
	<header class="page-header">
		<p class="eyebrow">Planning</p>
		<h1>Tutti i <em class="accent">planning</em></h1>
		<p class="lede">
			Orari e palinsesti settimanali di ogni area del club. Clicca su una lezione per leggerne la descrizione.
		</p>
	</header>

	<section class="planning-section">
		<div class="planning-section__head">
			<h2>{gymFloor.title}</h2>
			<p class="lede" style="margin-inline:0">Orari di apertura della sala pesi.</p>
		</div>
		<HoursTable rows={gymFloor.rows} />
	</section>

	{sezioni.map((sezione) => (
		<section class="planning-section">
			<div class="planning-section__head">
				<h2>{sezione.title}</h2>
				<p class="lede" style="margin-inline:0">
					Il palinsesto settimanale. Clicca su una lezione per leggerne la descrizione.{sezione.note && <em> {sezione.note}</em>}
				</p>
			</div>
			<WeeklySchedule id={sezione.id} lessons={sezione.lessons} schedule={sezione.schedule} />
		</section>
	))}

	<Faq items={faq} />

	<section class="final-cta">
		<h2>Vieni a scoprire il club</h2>
		<p class="lede" style="margin-inline:auto">
			Prenota un <strong>tour gratuito</strong> e scopri i corsi dal vivo.
		</p>
		<button type="button" class="btn" data-open-contact>Prenota un tour</button>
	</section>

	<style>
		.page-header {
			max-width: 44rem;
			margin: 0 auto;
			padding: 5rem 1.5rem 1rem;
			text-align: center;
		}

		.planning-section {
			padding: 3.5rem 1.5rem;
			border-top: 1px solid var(--border);
		}
		.planning-section__head {
			max-width: 88rem;
			margin: 0 auto 1.75rem;
			padding: 0 0.25rem;
		}
		.planning-section__head h2 {
			margin: 0 0 0.4rem;
		}
		.planning-section__head .lede {
			max-width: none;
			color: var(--text-muted);
		}
		.planning-section__head em {
			font-style: italic;
			color: var(--accent);
		}

		.final-cta {
			padding: 6rem 1.5rem;
			text-align: center;
			background: var(--bg-alt);
		}
		.final-cta .lede {
			margin-bottom: 2rem;
		}
	</style>
</Layout>
