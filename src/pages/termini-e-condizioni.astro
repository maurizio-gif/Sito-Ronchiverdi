---
import Legale from "../layouts/Legale.astro";
import { url } from "../lib/paths";

// Termini e Condizioni del Club: documento unico che armonizza i regolamenti
// oggi in circolazione in più copie.
//
// FONTI (settembre 2026), tutte allineate qui dentro:
//   1. "Domanda di iscrizione + regolamento" MOD019 del 29 luglio 2026;
//   2. stessa modulistica del 7 settembre 2026 (identica alla 1);
//   3. variante MOD019 per l'abbonamento FLEX del 7 settembre 2026, che ha una
//      pagina campi diversa e omette la clausola sulla modifica delle tariffe;
//   4. "Regolamento Ronchiverdi — nuova versione" (docx), riscrittura sintetica.
// Il ragionamento su cosa è stato unificato, cosa è stato scelto fra due
// versioni discordanti e cosa resta da confermare sta in
// docs/armonizzazione-regolamenti.md. Prima di modificare una regola qui,
// leggere quella nota: quasi ogni riga è il risultato di una scelta fra
// varianti diverse dello stesso testo.
//
// REGOLA ANTI-DUPLICAZIONE: contenuti e prezzi degli abbonamenti stanno in
// /abbonamenti (src/content/memberships/tabella.json), gli orari in /planning,
// le risposte operative in /faq, i dati personali in /privacy. Qui stanno solo
// le condizioni contrattuali e le regole d'uso: se un dato vive già altrove,
// va linkato, non ricopiato.

const indice = [
	{ href: "#documento", label: "Cos'è questo documento" },
	{ href: "#iscrizione", label: "Iscrizione e accesso" },
	{ href: "#certificato", label: "Certificato medico" },
	{ href: "#abbonamenti", label: "Formule di abbonamento" },
	{ href: "#flex", label: "Abbonamento Flex" },
	{ href: "#pagamenti", label: "Pagamenti e disdetta" },
	{ href: "#comportamento", label: "Comportamento" },
	{ href: "#minori", label: "Minori" },
	{ href: "#ospiti", label: "Ospiti" },
	{ href: "#spazi", label: "Spazi e servizi" },
	{ href: "#campi", label: "Tennis e padel" },
	{ href: "#responsabilita", label: "Responsabilità" },
	{ href: "#sospensione", label: "Sospensione e risoluzione" },
	{ href: "#safeguarding", label: "Tutela dei minori" },
];

// Condizioni contrattuali specifiche per formula. Restano qui solo le regole
// che cambiano il contratto (durata, fasce orarie, esclusioni): cosa comprende
// ogni abbonamento e quanto costa vive nella tabella di /abbonamenti.
const formule = [
	{
		nome: "Swim",
		testo:
			"Accesso alla vasca indoor per nuoto libero e acqua fitness, e alla Relax Zone. Non comprende la piscina estiva, il solarium e le altre aree outdoor, il Gym Floor, il tennis e il padel.",
		durata: "11 mesi, agosto escluso per la manutenzione della vasca indoor. La quota annuale può essere suddivisa in 12 rate mensili.",
	},
	{
		nome: "Gym",
		testo:
			"Accesso alle aree palestra indoor e alla Relax Zone. Non comprende piscine, solarium, palestra esterna e le altre aree outdoor, il tennis e il padel.",
		durata: "Annuale, salvo diversa durata indicata sul modulo di iscrizione.",
	},
	{
		nome: "Silver e Gold",
		testo:
			"Sono le formule complete: comprendono l'area acqua, il Gym Floor, i corsi e la Relax Zone. La differenza fra le due riguarda l'accesso ai campi da tennis, incluso nella stagione estiva solo con Gold.",
		durata: "Annuale, salvo diversa durata indicata sul modulo di iscrizione.",
	},
	{
		nome: "Morning",
		testo:
			"Accesso dal lunedì al venerdì dalle 8:00 alle 13:00 e il sabato dalle 9:00 alle 13:00, con l'obbligo di lasciare gli impianti entro tali orari. Non è valido la domenica.",
		durata: "Annuale, salvo diversa durata indicata sul modulo di iscrizione.",
	},
	{
		nome: "Trimestrali",
		testo:
			"Gli abbonamenti trimestrali non comprendono il sabato e la domenica nei mesi da maggio ad agosto.",
		durata: "Tre mesi dalla data di attivazione.",
	},
];

// Prenotazione dei campi: le due discipline hanno finestre diverse, ed è il
// punto in cui i regolamenti di partenza si contraddicevano di più.
const campi = [
	{
		disciplina: "Tennis",
		cancellazione: "Fino a 4 ore prima dell'orario prenotato",
		noShow: "Campo addebitato per intero a tutti i nominativi indicati nella prenotazione",
		annullamento: "Un annullamento gratuito al giorno",
		frequenza:
			"Stagione invernale: più prenotazioni al giorno, a pagamento. Stagione estiva: una al giorno, 1 ora per il singolo e 1 ora e 30 per il doppio",
	},
	{
		disciplina: "Padel",
		cancellazione: "Fino a 6 ore prima dell'orario prenotato",
		noShow: "Campo addebitato per intero al nominativo indicato nella prenotazione (obbligatorio un solo nominativo)",
		annullamento: "Un annullamento gratuito",
		frequenza: "Secondo la disponibilità dei campi in app",
	},
];
---

<Legale
	title="Termini e Condizioni — Ronchiverdi Sport Club Torino"
	description="Le regole di Ronchiverdi Sport Club in un documento unico: iscrizione, certificato medico, formule di abbonamento, pagamenti e disdetta, uso degli spazi, prenotazione dei campi, responsabilità e tutela dei minori."
	eyebrow="Termini e condizioni"
	titolo="Le regole del club,"
	titoloAccento="in un posto solo"
	aggiornamento="2026-09-07"
	indice={indice}
>
	<Fragment slot="lede">
		Iscrizione, abbonamenti, uso degli spazi e prenotazione dei campi: tutto
		quello che vale al club, in un testo unico che sostituisce le versioni
		precedenti del regolamento.
	</Fragment>

	<aside class="legal-summary" slot="sintesi">
		<p class="legal-summary__title">In sintesi</p>
		<ul>
			<li>Vale per soci e ospiti, dal momento dell'iscrizione e per tutta la durata dell'abbonamento.</li>
			<li>È la versione ufficiale e aggiornata: dove una copia precedente dice altro, vale questa.</li>
			<li>Cosa comprende ogni formula e quanto costa sta in <a href={url("/abbonamenti")}>Abbonamenti</a>; gli orari nel <a href={url("/planning")}>planning</a>.</li>
			<li>Come trattiamo i dati personali sta invece nella <a href={url("/privacy")}>Privacy Policy</a>.</li>
		</ul>
	</aside>

	<section class="legal-section" id="documento">
		<h2>Cos'è questo documento</h2>
		<p>
			Questi Termini e Condizioni regolano l'iscrizione a{" "}
			<strong>Ronchiverdi Sport Club S.S.D. a r.l.</strong> (di seguito "il
			Club") — sede legale in Piazza Vetra 17, 20123 Milano, sede operativa in
			Corso Moncalieri 466/16, 10133 Torino, P. IVA e C.F. 11173030013 — e
			l'uso dei suoi impianti e servizi.
		</p>
		<p>
			Si accettano con la sottoscrizione della domanda di iscrizione e valgono
			per i soci, per chi frequenta corsi e attività e, in quanto compatibili,
			per gli ospiti.
		</p>
		<p>
			<strong>Questa è la versione ufficiale e aggiornata delle regole del
			Club.</strong> Dove una copia cartacea, un allegato o un estratto
			consegnato in precedenza dica cose diverse, vale quanto scritto qui, con
			la data di aggiornamento riportata in cima alla pagina. Fanno eccezione
			le condizioni economiche del singolo contratto — importo, durata,
			scadenze delle rate — che restano quelle del modulo di iscrizione
			sottoscritto.
		</p>
		<div class="legal-nota">
			<p>
				<strong>Quello che non troverai qui.</strong> Cosa comprende ogni
				abbonamento e quanto costa sta in <a href={url("/abbonamenti")}>Abbonamenti</a> e
				nel listino in vigore; gli orari di corsi e attività nel{" "}
				<a href={url("/planning")}>planning settimanale</a>; le risposte
				operative nelle <a href={url("/faq")}>domande frequenti</a>; il
				trattamento dei dati personali nella{" "}
				<a href={url("/privacy")}>Privacy Policy</a>. Sono informazioni che
				cambiano con tempi propri: ricopiarle qui significherebbe avere prima o
				poi due versioni diverse della stessa cosa.
			</p>
		</div>
	</section>

	<section class="legal-section" id="iscrizione">
		<h2>Iscrizione, quota e accesso al Club</h2>

		<h3>Chi può iscriversi</h3>
		<ul>
			<li>L'iscrizione è riservata ai maggiorenni.</li>
			<li>I ragazzi di età inferiore ai 18 anni possono iscriversi con il consenso scritto di un genitore o di chi ne esercita la tutela.</li>
			<li>L'iscrizione dei ragazzi di età inferiore ai 14 anni è subordinata all'iscrizione di un genitore.</li>
		</ul>

		<h3>Cosa serve</h3>
		<p>
			Documento d'identità, codice fiscale e certificato medico in corso di
			validità; per gli atleti agonisti, certificato di idoneità sportiva
			agonistica. È inoltre necessario aver letto e sottoscritto questi Termini
			e Condizioni.
		</p>

		<h3>Quota associativa</h3>
		<p>
			L'iscrizione comporta il versamento di una quota associativa di validità
			annuale, il cui importo è indicato nel listino in vigore. Se il rinnovo
			non avviene entro la scadenza dell'abbonamento, per riattivare la
			posizione la quota di iscrizione va versata nuovamente.
		</p>

		<h3>Braccialetto e tessera di accesso</h3>
		<p>
			All'iscrizione viene consegnato un dispositivo personale di accesso —
			braccialetto o tessera — <strong>strettamente personale, non cedibile né
			trasferibile</strong>. Il Club è dotato del sistema di rilevamento accessi
			In4You – TeamSystem: per ragioni di sicurezza e controllo è obbligatorio
			passare il proprio dispositivo a ogni ingresso, anche quando i tornelli o
			i varchi risultassero già aperti. Smarrimento o malfunzionamento vanno
			segnalati subito alla reception.
		</p>

		<h3>Modifiche a tariffe e servizi</h3>
		<p>
			Il Club può modificare le tariffe degli abbonamenti e dei servizi, o
			prevedere che servizi prima compresi nel prezzo siano pagati a parte. Per
			chi ha un abbonamento in corso le nuove condizioni si applicano dal
			rinnovo successivo; per l'abbonamento Flex vale invece il preavviso
			indicato nella sezione dedicata.
		</p>
	</section>

	<section class="legal-section" id="certificato">
		<h2>Certificato medico</h2>
		<p>
			La consegna del certificato medico è <strong>condizione indispensabile</strong>{" "}
			per usare gli impianti e i servizi del Club. Fino al deposito del
			certificato il Club può sospendere la propria prestazione per
			inadempimento, <strong>senza che la durata del contratto venga
			prorogata</strong>: i giorni non utilizzati per questo motivo non vengono
			recuperati.
		</p>
		<p>
			Il certificato deve essere di idoneità all'attività sportiva non
			agonistica; per gli atleti agonisti e per i tesserati che partecipano a
			gare è richiesto il certificato di idoneità agonistica. Il rinnovo alla
			scadenza è a cura del socio.
		</p>
		<p>
			Per i corsi e le scuole del Club valgono le stesse regole, con le soglie
			di età indicate nelle <a href={url("/faq")}>domande frequenti</a> di
			ciascuna attività.
		</p>
	</section>

	<section class="legal-section" id="abbonamenti">
		<h2>Formule di abbonamento</h2>
		<div class="legal-nota">
			<p>
				Le attività comprese in ciascuna formula e i relativi prezzi sono
				quelli pubblicati in <a href={url("/abbonamenti")}>Abbonamenti</a> e nel
				listino in vigore. Qui sotto restano solo le condizioni contrattuali
				che cambiano da una formula all'altra.
			</p>
		</div>
		<div class="legal-cards">
			{formule.map((f) => (
				<article class="legal-card">
					<h3>{f.nome}</h3>
					<p>{f.testo}</p>
					<dl>
						<div><dt>Durata</dt><dd>{f.durata}</dd></div>
					</dl>
				</article>
			))}
		</div>
		<p>
			L'accesso ai campi da tennis e padel, dove non compreso nella formula,
			resta possibile alla tariffa prevista per i soci: vedi{" "}
			<a href="#campi">Tennis e padel</a>.
		</p>
	</section>

	<section class="legal-section" id="flex">
		<h2>Abbonamento Flex</h2>
		<p>
			Flex è la formula ad addebito mensile ricorrente. Alle regole generali di
			questo documento si aggiungono le condizioni seguenti.
		</p>
		<ul>
			<li><strong>Quota di attivazione:</strong> 100,00 € (cento/00), una tantum all'attivazione.</li>
			<li><strong>Quota mensile:</strong> definita al momento dell'iscrizione.</li>
			<li><strong>Periodo di attivazione:</strong> non è possibile attivare nuovi abbonamenti Flex dal 15 aprile al 31 agosto.</li>
			<li><strong>Pagamento:</strong> carta di credito o prepagata, con addebito automatico il giorno 15 di ogni mese. I ratei maturati dalla data di iscrizione alla prima scadenza si versano all'atto dell'iscrizione.</li>
			<li><strong>Addebito rifiutato:</strong> l'accesso ai servizi è sospeso fino alla comunicazione e approvazione di un nuovo metodo di pagamento valido.</li>
			<li><strong>Insoluto oltre 30 giorni:</strong> il contratto si intende risolto di diritto e l'abbonamento decaduto.</li>
			<li><strong>Congelamento:</strong> non previsto.</li>
			<li>
				<strong>Disdetta:</strong> almeno 30 giorni prima della scadenza
				mensile, al desk del Club oppure via email a{" "}
				<a href="mailto:abbonamentiflex@ronchiverdi.it">abbonamentiflex@ronchiverdi.it</a>.
				Con un preavviso inferiore la disdetta ha effetto dal mese successivo.
			</li>
			<li><strong>Riattivazione dopo una disdetta:</strong> è dovuta nuovamente la quota di attivazione di 100,00 €.</li>
		</ul>
		<p>
			Il Club può modificare le condizioni contrattuali del servizio Flex
			dandone comunicazione via email all'indirizzo fornito all'iscrizione, con
			un <strong>preavviso di almeno 30 giorni</strong> rispetto alla data di
			efficacia. Entro quella data puoi disdire il contratto senza penali; in
			assenza di disdetta le modifiche si intendono accettate.
		</p>
	</section>

	<section class="legal-section" id="pagamenti">
		<h2>Pagamenti, durata, disdetta e recesso</h2>
		<p>
			L'abbonamento dà diritto a usare i servizi previsti dalla formula scelta
			per tutto il suo periodo di validità. <strong>L'interruzione della
			frequenza non libera dal pagamento</strong> dell'importo concordato e
			delle rate indicate sul modulo di iscrizione: quello che si acquista è il
			periodo, non il numero di ingressi.
		</p>
		<p>
			Il <strong>congelamento</strong> dell'abbonamento non è previsto per la
			formula Flex; per le altre formule è possibile solo nei casi e nei modi
			concordati per iscritto con la Direzione.
		</p>
		<p>
			Alla scadenza dell'abbonamento l'accesso al Club è sospeso. Il rinnovo è
			a discrezione della Direzione del Club.
		</p>
		<p>
			Se hai sottoscritto il contratto <strong>a distanza o fuori dai locali del
			Club</strong> — per esempio online — hai diritto di recedere entro 14
			giorni dalla conclusione, senza doverne indicare il motivo, con una
			comunicazione esplicita alla reception o a{" "}
			<a href="mailto:info@ronchiverdi.it">info@ronchiverdi.it</a> (artt. 52 e
			seguenti del Codice del consumo). Se hai chiesto di cominciare a usare i
			servizi durante quei 14 giorni, ti verrà addebitata la parte di servizio
			effettivamente fruita fino al recesso.
		</p>
	</section>

	<section class="legal-section" id="comportamento">
		<h2>Come si sta al Club</h2>

		<h3>Abbigliamento</h3>
		<p>
			In tutte le aree di attività vanno indossati scarpe e abbigliamento
			appropriati. È vietato entrare nei locali del Club con scarpe da tennis
			sporche di terra rossa. Nella Club House non sono ammessi accappatoi,
			costumi da bagno o simili; la sala Business Lounge è riservata agli
			eventi organizzati da Ronchiverdi, ai clienti Business e alle attività a
			loro dedicate.
		</p>

		<h3>Divieti</h3>
		<ul>
			<li>introdurre animali;</li>
			<li>introdurre cibo e bevande dall'esterno: pasti e spuntini si acquistano e si consumano nell'area bar;</li>
			<li>utilizzare le attrezzature sotto l'effetto di alcolici o di sostanze che alterino il comportamento;</li>
			<li>fumare nella zona piscina, anche all'aperto;</li>
			<li>introdurre bottiglie e oggetti di vetro negli spogliatoi, negli spazi collegati e nella zona piscina estiva;</li>
			<li>turpiloquio, bestemmie e schiamazzi in tutte le aree del Club.</li>
		</ul>
		<p>
			Il personale addetto è autorizzato a intervenire per far rispettare
			queste regole.
		</p>

		<h3>Parcheggio</h3>
		<p>
			Auto e motociclette vanno lasciate solo negli spazi demarcati. L'accesso
			al passo carraio avviene dal lato sinistro, per consentire la corretta
			lettura del dispositivo che abilita l'ingresso.
		</p>
	</section>

	<section class="legal-section" id="minori">
		<h2>Minori</h2>
		<ul>
			<li>
				I ragazzi di età inferiore ai <strong>14 anni</strong> devono essere
				sempre accompagnati da un genitore, che risponde del loro
				comportamento.
			</li>
			<li>
				Negli <strong>spogliatoi</strong>, i bambini possono accedere a quello
				del genitore che li accompagna fino ai <strong>5 anni</strong> compiuti;
				dai 6 anni utilizzano gli spogliatoi dedicati del Kids Village. Durante
				le lezioni della Scuola Nuoto il Club offre un servizio di assistenza
				allo spogliatoio, descritto nelle{" "}
				<a href={url("/faq")}>domande frequenti</a>.
			</li>
			<li>
				L'accesso alla <strong>Relax Zone</strong> non è consentito ai minori
				di 16 anni; l'<strong>idromassaggio</strong> non è consentito ai minori
				di 12 anni.
			</li>
			<li>
				Il Club offre programmi e attività dedicati a bambini e ragazzi, seguiti
				da personale qualificato: li trovi nel{" "}
				<a href={url("/planning")}>planning</a> e in reception.
			</li>
		</ul>
	</section>

	<section class="legal-section" id="ospiti">
		<h2>Ospiti</h2>
		<p>
			Il socio può invitare ospiti al Club, previa registrazione alla reception
			e pagamento della tariffa prevista dal listino in vigore.
		</p>
		<p>
			Nei periodi di elevata affluenza — weekend e stagione estiva — l'accesso
			degli ospiti può essere limitato o temporaneamente sospeso, per garantire
			il regolare svolgimento delle attività sociali e sportive: conviene quindi
			verificare la disponibilità con la reception con congruo anticipo. Sui
			campi da tennis e padel, nella stagione estiva, non è consentito invitare
			ospiti dal lunedì al venerdì dalle 12:00 in poi e nei weekend.
		</p>
		<p>
			Gli ospiti sono tenuti a rispettare queste stesse regole; il socio che li
			ha invitati risponde del loro comportamento.
		</p>
	</section>

	<section class="legal-section" id="spazi">
		<h2>Spazi e servizi</h2>

		<h3>Spogliatoi e armadietti</h3>
		<p>
			Gli armadietti si usano a rotazione e non possono essere occupati in modo
			permanente: quelli trovati chiusi con lucchetto dopo le{" "}
			<strong>22:30</strong> vengono aperti. Le sacche sportive vanno collocate
			sopra gli armadietti. Per gli oggetti di valore si consiglia di usare le
			cassettine di sicurezza adiacenti alla reception, tenendo presente quanto
			indicato in <a href="#responsabilita">Responsabilità</a>.
		</p>

		<h3>Relax Zone</h3>
		<p>
			La Relax Zone non è presidiata: l'utilizzo avviene sotto la responsabilità
			esclusiva di chi vi accede. Prima di entrare, dagli spogliatoi, è
			obbligatorio fare la doccia con acqua calda e sapone; servono costume da
			bagno, ciabatte e asciugamano o accappatoio. È vietato asciugare indumenti
			nella sauna o appoggiarli vicino alla stufa. Non è consentito l'accesso ai
			minori di 16 anni.
		</p>

		<h3>Palestre</h3>
		<p>
			In sala servono calzature sportive pulite, dedicate all'uso indoor, e
			l'asciugamano personale da appoggiare su panche e attrezzi. I bilancieri
			vanno scaricati dopo l'uso. Le <strong>bike da spinning si utilizzano solo
			in presenza dell'istruttore</strong>. Gli istruttori sono in sala per
			assistenza, impostazione delle macchine e programmi di allenamento: in
			caso di dubbio sull'uso di un attrezzo, chiedi a loro prima di usarlo.
		</p>

		<h3>Piscine e idromassaggio</h3>
		<p>
			È obbligatorio transitare nella vasca lavapiedi con le ciabatte, fare la
			doccia saponata prima di entrare in acqua e indossare la cuffia. Il nuoto
			libero non richiede prenotazione negli orari di apertura. L'idromassaggio
			non è consentito ai minori di 12 anni.
		</p>

		<h3>Locale bici</h3>
		<p>
			Il locale bici non è sorvegliato e il suo utilizzo richiede la
			sottoscrizione di un modulo di scarico di responsabilità. Il Club non
			risponde di danneggiamenti, manomissioni o furti delle biciclette
			depositate.
		</p>

		<h3>Club House e ristorante</h3>
		<p>
			Orari del servizio, turni di chiusura e prenotazioni sono indicati in
			reception e comunicati dal ristorante. La cucina può prolungare il
			servizio oltre gli orari previsti solo su prenotazione.
		</p>
	</section>

	<section class="legal-section" id="campi">
		<h2>Tennis e padel</h2>

		<h3>Tesseramento</h3>
		<p>
			Per accedere ai campi è necessario il <strong>tesseramento FITP in corso
			di validità</strong>, che <strong>non è compreso nell'abbonamento al
			Club</strong>. È invece compreso nella quota di iscrizione ai corsi di
			tennis, come indicato nelle <a href={url("/faq")}>domande frequenti</a> dell'attività.
		</p>

		<h3>Prenotazione</h3>
		<p>
			La prenotazione e la cancellazione dei campi avvengono{" "}
			<strong>esclusivamente tramite l'app Wansport</strong>. Il campo può essere
			occupato solo dall'inizio dell'ora prenotata. Gli importi non pagati
			attraverso l'app vanno saldati in reception prima dell'inizio del gioco.
		</p>
		<div class="legal-table-wrap">
			<table class="legal-table">
				<thead>
					<tr>
						<th scope="col">Campo</th>
						<th scope="col">Cancellazione</th>
						<th scope="col">Mancata presenza</th>
						<th scope="col">Annullamento gratuito</th>
						<th scope="col">Frequenza e durata</th>
					</tr>
				</thead>
				<tbody>
					{campi.map((c) => (
						<tr>
							<th scope="row">{c.disciplina}</th>
							<td>{c.cancellazione}</td>
							<td>{c.noShow}</td>
							<td>{c.annullamento}</td>
							<td>{c.frequenza}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<p>
			L'annullamento gratuito è quello che l'app consente al socio al momento
			della prenotazione, per evitare lo slittamento delle partite negli orari
			desiderati. Oltre quella soglia, e oltre le finestre di cancellazione
			indicate, il campo viene addebitato.
		</p>

		<h3>Stagione indoor</h3>
		<p>
			È possibile riservare una o più ore fisse per l'intera stagione indoor
			(indicativamente da ottobre ad aprile). La prenotazione stagionale è
			valida solo dal momento del pagamento; le ore prenotate e non utilizzate{" "}
			<strong>non sono recuperabili né rimborsabili</strong>.
		</p>

		<h3>Stagione estiva</h3>
		<p>
			La prenotazione si effettua in app fino a 48 ore prima dell'orario
			desiderato, oppure di persona nella mezz'ora precedente l'inizio del
			gioco. Va confermata con la presenza di almeno uno dei giocatori{" "}
			<strong>15 minuti prima</strong> dell'inizio dell'ora: in caso contrario
			il campo si considera libero e può essere assegnato ad altri soci.
		</p>

		<h3>Sul campo</h3>
		<p>
			È vietato giocare o accedere ai campi senza maglietta o con abbigliamento
			non adeguato. Non sono consentiti turpiloquio, bestemmie e schiamazzi. Il
			personale addetto è autorizzato a intervenire.
		</p>
	</section>

	<section class="legal-section" id="responsabilita">
		<h2>Responsabilità e oggetti personali</h2>
		<p>
			Il Club <strong>non assume in custodia</strong> gli oggetti portati dai
			soci e dagli ospiti. Non è prevista alcuna copertura assicurativa e il
			Club non risponde di smarrimenti o furti di quanto lasciato negli
			armadietti — fissi o a rotazione — negli spogliatoi, nelle cassettine di
			sicurezza adiacenti alla reception e nel locale bici, né di furti o danni
			ai veicoli parcheggiati nell'area del Club o a quanto contenuto in essi.
		</p>
		<p>
			L'attività sportiva va svolta in base alle proprie condizioni fisiche,
			all'idoneità attestata dal certificato medico e alle indicazioni del
			personale del Club, rispettando le istruzioni d'uso di attrezzi e
			impianti.
		</p>
		<p>
			<strong>Nessuna clausola di questo documento limita la responsabilità del
			Club per dolo o colpa grave, né per i danni alla persona:</strong> restano
			fermi i diritti inderogabili riconosciuti dalla legge, in particolare al
			consumatore.
		</p>
	</section>

	<section class="legal-section" id="sospensione">
		<h2>Sospensione e risoluzione</h2>
		<p>Il Club può sospendere l'accesso o risolvere il contratto quando:</p>
		<ul>
			<li>il comportamento del socio è contrario a queste regole, oppure lesivo dell'immagine e dell'organizzazione del Club;</li>
			<li>la quota associativa o il tesseramento non sono stati versati o sono scaduti;</li>
			<li>il certificato medico non è stato depositato o è scaduto (in questo caso la sospensione non proroga la durata del contratto);</li>
			<li>per l'abbonamento Flex, un pagamento resta insoluto per oltre 30 giorni.</li>
		</ul>
		<p>
			Nei casi di risoluzione dovuti al comportamento o all'inadempimento del
			socio non è previsto rimborso delle somme versate, fermi restando i
			diritti inderogabili riconosciuti al consumatore dalla legge.
		</p>
	</section>

	<section class="legal-section" id="safeguarding">
		<h2>Sicurezza e tutela dei minori</h2>
		<p>
			Ronchiverdi Sport Club S.S.D. a r.l. applica il MOG — Modello
			Organizzativo di Gestione e controllo dell'attività sportiva — e i relativi
			Codici di condotta, finalizzati alla tutela dei minori e alla prevenzione
