<script>
	// Ricerca per parole chiave dentro l'articolato: filtra i punti, nasconde
	// gli articoli che restano senza punti visibili e sfoglia l'indice di
	// conseguenza. Le parole trovate vengono evidenziate.
	const input = document.getElementById("tc-cerca") as HTMLInputElement | null;
	const conta = document.getElementById("tc-conta");
	const vuoto = document.getElementById("tc-vuoto");
	const clausole = Array.from(document.querySelectorAll<HTMLElement>(".tc-clausola"));
	const articoli = Array.from(document.querySelectorAll<HTMLElement>(".tc-articolo"));
	const vociIndice = Array.from(document.querySelectorAll<HTMLElement>("[data-indice]"));

	// Accenti e apostrofi appiattiti uno a uno, senza cambiare la lunghezza del
	// testo: così le posizioni trovate nella stringa normalizzata valgono anche
	// su quella originale, e l'evidenziazione cade sui caratteri giusti.
	const ACCENTI: Record<string, string> = {
		à: "a", á: "a", â: "a", ä: "a", è: "e", é: "e", ê: "e", ë: "e",
		ì: "i", í: "i", î: "i", ï: "i", ò: "o", ó: "o", ô: "o", ö: "o",
		ù: "u", ú: "u", û: "u", ü: "u", ç: "c", "’": "'", "‘": "'",
	};
	const piatto = (t: string) => t.toLowerCase().replace(/[^\x00-\x7F‘’]/g, (c) => ACCENTI[c] ?? c);

	/** Corpo di un punto: è lì che si cerca e si evidenzia, non sul numero. */
	const corpoDi = (li: HTMLElement) => li.querySelector<HTMLElement>(".tc-clausola__corpo") ?? li;
	const testoDi = new Map(clausole.map((li) => [li, piatto(corpoDi(li).textContent || "")]));

	function pulisciEvidenze(radice: HTMLElement) {
		radice.querySelectorAll("mark.tc-hit").forEach((m) => {
			m.replaceWith(document.createTextNode(m.textContent || ""));
		});
		radice.normalize();
	}

	function evidenzia(radice: HTMLElement, parole: string[]) {
		if (!parole.length) return;
		const nodi: Text[] = [];
		const walker = document.createTreeWalker(radice, NodeFilter.SHOW_TEXT);
		let n = walker.nextNode();
		while (n) {
			nodi.push(n as Text);
			n = walker.nextNode();
		}

		nodi.forEach((nodo) => {
			const testo = nodo.nodeValue || "";
			const norm = piatto(testo);
			// Tutte le occorrenze di tutte le parole, ordinate e senza sovrapposizioni.
			const punti: [number, number][] = [];
			parole.forEach((p) => {
				let da = norm.indexOf(p);
				while (da !== -1) {
					punti.push([da, da + p.length]);
					da = norm.indexOf(p, da + p.length);
				}
			});
			if (!punti.length) return;
			punti.sort((x, y) => x[0] - y[0]);

			const frammento = document.createDocumentFragment();
			let cursore = 0;
			punti.forEach(([da, aa]) => {
				if (da < cursore) return;
				if (da > cursore) frammento.appendChild(document.createTextNode(testo.slice(cursore, da)));
				const mark = document.createElement("mark");
				mark.className = "tc-hit";
				mark.textContent = testo.slice(da, aa);
				frammento.appendChild(mark);
				cursore = aa;
			});
			if (cursore < testo.length) frammento.appendChild(document.createTextNode(testo.slice(cursore)));
			nodo.replaceWith(frammento);
		});
	}

	function filtra() {
		const query = piatto((input?.value || "").trim()).replace(/\s+/g, " ");
		const parole = query ? query.split(" ").filter(Boolean) : [];

		let puntiVisibili = 0;
		clausole.forEach((li) => {
			const corpo = corpoDi(li);
			pulisciEvidenze(corpo);
			const testo = testoDi.get(li) || "";
			const ok = parole.every((p) => testo.includes(p));
			li.hidden = !ok;
			if (ok) {
				puntiVisibili++;
				evidenzia(corpo, parole);
			}
		});

		// Un articolo senza punti visibili sparisce con il suo titolo, e con la
		// sua voce d'indice: un indice che porta al nulla è peggio che assente.
		let articoliVisibili = 0;
		const vivi = new Set<string>();
		articoli.forEach((art) => {
			const resta = !!art.querySelector<HTMLElement>(".tc-clausola:not([hidden])");
			art.hidden = !resta;
			// La nota introduttiva è commento all'articolo: con la ricerca attiva
			// resta solo se qualche punto di quell'articolo è ancora a video.
			const nota = art.querySelector<HTMLElement>(".tc-nota");
			if (nota) nota.hidden = parole.length > 0;
			if (resta) {
				articoliVisibili++;
				const id = art.dataset.articolo;
				if (id) vivi.add(id);
			}
		});
		vociIndice.forEach((v) => {
			v.hidden = parole.length > 0 && !vivi.has(v.dataset.indice || "");
		});

		// Filtrando da metà documento la pagina si accorcia sotto i piedi e si
		// finisce a fissare il footer, con i risultati rimasti più in alto. Se il
		// primo punto trovato non è a video lo si porta in vista — solo allora,
		// così la pagina non salta a ogni lettera digitato.
		const primo = clausole.find((li) => !li.hidden);
		if (parole.length && primo) {
			const y = primo.getBoundingClientRect().top;
			if (y < 0 || y > window.innerHeight) primo.scrollIntoView({ block: "start" });
		}

		if (vuoto) vuoto.hidden = puntiVisibili > 0 || parole.length === 0;
		if (conta) {
			conta.textContent = parole.length
				? `${puntiVisibili} ${puntiVisibili === 1 ? "punto trovato" : "punti trovati"} in ${articoliVisibili} ${
						articoliVisibili === 1 ? "articolo" : "articoli"
					}`
				: "";
		}
	}

	input?.addEventListener("input", filtra);

	// Arrivando da un link a un punto (#art-6-8) la ricerca in corso lo
	// nasconderebbe: si azzera il filtro e si evidenzia il punto citato.
	function vaiAlPunto() {
		const id = decodeURIComponent(location.hash.slice(1));
		if (!/^art-\d+(-\d+)?$/.test(id)) return;
		if (input?.value) {
			input.value = "";
			filtra();
		}
		const target = document.getElementById(id);
		if (!target) return;
		target.classList.add("is-citato");
		setTimeout(() => target.classList.remove("is-citato"), 2000);
	}
	window.addEventListener("hashchange", vaiAlPunto);
	vaiAlPunto();
</script>
