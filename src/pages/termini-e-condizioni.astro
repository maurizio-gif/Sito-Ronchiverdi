// I numeri degli articoli sono la loro posizione: si calcolano una volta sola e
// da qui in avanti nessuno li scrive a mano.
const numeroDi = new Map(articoli.map((art, i) => [art.id, i + 1]));

/** Risolve i segnaposto {{art:id}} nel numero e nel link dell'articolo. */
function risolvi(html: string): string {
	return html.replace(/\{\{art:([a-z-]+)\}\}/g, (_intero, id: string) => {
		const numero = numeroDi.get(id);
		if (!numero) throw new Error(`Rimando a un articolo inesistente: ${id}`);
		return `<a href="#art-${numero}">art. ${numero}</a>`;
	});
}
