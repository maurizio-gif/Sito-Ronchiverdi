# Indirizzo pubblico del sito, senza slash finale (es. https://www.ronchiverdi.it).
# Serve a canonical, Open Graph, JSON-LD e sitemap, che sono URL assoluti.
# ATTENZIONE: finché questa variabile non è impostata il sito si considera un
# ambiente di prova e robots.txt vieta l'indicizzazione a tutti i motori.
# Va quindi impostata su Vercel il giorno del go-live, insieme al dominio.
SITE_URL=

# Necessarie solo per "npm run build:cloud" (editing via Tina Cloud in produzione).
# Non richieste per lo sviluppo locale (npm run dev / npm run build).
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main

# Supabase: dove /api/lead salva i contatti e /api/track le sessioni.
# Solo su Vercel — la service_role key non va mai esposta al client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Avviso email alla segreteria a ogni nuova richiesta (src/lib/notificaLead.ts).
# Senza queste due l'avviso viene saltato e la richiesta resta comunque salvata.
# EMAIL_NOTIFICHE_DA deve essere un mittente verificato su SendGrid (basta la
# Single Sender Verification, non serve autenticare tutto il dominio).
SENDGRID_API_KEY=
EMAIL_NOTIFICHE_DA=sito@ronchiverdi.it
EMAIL_NOTIFICHE_A=form@ronchiverdi.it

# Conferme e promemoria via email a chi compila i form (src/lib/emailCliente.ts).
# Il mittente dev'essere verificato su SendGrid: sono gli stessi indirizzi che
# il pannello usa per le comunicazioni ai soci, così chi riceve vede sempre lo
# stesso nome. Senza SENDGRID_API_KEY le email vengono saltate e la richiesta
# resta comunque salvata.
SENDGRID_FROM_EMAIL=digital@ronchiverdi.it
SENDGRID_FROM_NAME=Ronchiverdi Sport Club
EMAIL_REPLY_TO=info@ronchiverdi.it

# Promemoria di un'ora prima (src/pages/api/promemoria.ts), chiamato ogni
# cinque minuti dal cron dichiarato in vercel.json.
#
# CRON_SECRET lo genera e lo manda Vercel da sé: basta impostarlo fra le
# variabili del progetto e la piattaforma lo mette in Authorization: Bearer.
# PROMEMORIA_TOKEN è alternativo, per chiamare l'endpoint da fuori Vercel (un
# pg_cron su Supabase, o una prova a mano). Senza nessuno dei due l'endpoint
# resta chiuso e non manda niente.
CRON_SECRET=
PROMEMORIA_TOKEN=
