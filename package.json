    "@astrojs/vercel": "^11.0.9",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/jost": "^5.2.8",
    "@supabase/supabase-js": "^2.112.4",
    "@tinacms/cli": "^2.5.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "tinacms": "^3.10.0"
  },
  "overrides": {
    "astro": {
      "vite": "8.0.13"
    }
  }
}
