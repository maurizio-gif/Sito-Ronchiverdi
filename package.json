{
  "name": "ronchiverdi-sport-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "immagini": "node scripts/converti-immagini.mjs",
    "prebuild": "npm run immagini",
    "prebuild:cloud": "npm run immagini",
    "build": "tinacms build --local --skip-cloud-checks && astro build",
